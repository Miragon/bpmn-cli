  <bpmn:process id="Process_S17" name="s17" isExecutable="true">
    <bpmn:startEvent id="Event_Web" name="Web order">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_ParseWeb" name="Parse web">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_ParseWeb" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Web" targetRef="Activity_ParseWeb" />
    <bpmn:startEvent id="Event_Mail" name="Mail order">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_MailOrder" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_ParseMail" name="Parse mail">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_ParseMail" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Event_Mail" targetRef="Activity_ParseMail" />
    <bpmn:startEvent id="Event_Nightly" name="Nightly batch">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Activity_LoadBatch" name="Load batch">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Aggregate" name="Aggregate">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_BatchDone" name="Batch done">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Aggregate" targetRef="Event_BatchDone" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_LoadBatch" targetRef="Activity_Aggregate" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_Nightly" targetRef="Activity_LoadBatch" />
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_ProcessOrder" name="Process order">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_ProcessOrder" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Merge" targetRef="Activity_ProcessOrder" />
    <bpmn:task id="Activity_OrphanA" name="Orphan A">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_OrphanA" targetRef="Activity_OrphanB" />
    <bpmn:task id="Activity_OrphanB" name="Orphan B">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Activity_Lonely" name="Lonely" />
  </bpmn:process>

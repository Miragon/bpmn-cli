<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Shop" name="Shop" processRef="Process_OrderHandling" />
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:messageFlow id="Flow_8" name="Order" sourceRef="Activity_PlaceOrder" targetRef="Event_OrderReceived" />
    <bpmn:messageFlow id="Flow_9" name="Confirmation" sourceRef="Activity_SendConfirmation" targetRef="Activity_ReceiveConfirmation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OrderHandling" name="Order handling" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sales" name="Sales">
        <bpmn:flowNodeRef>Event_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CheckOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics">
        <bpmn:flowNodeRef>Activity_ShipOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_CheckOrder" name="Check order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_SendConfirmation" name="Send confirmation">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_SendConfirmation" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_ShipOrder" targetRef="Activity_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_CheckOrder" targetRef="Activity_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_OrderReceived" targetRef="Activity_CheckOrder" />
  </bpmn:process>
  <bpmn:process id="Process_Customer" isExecutable="false">
    <bpmn:startEvent id="Event_WantsToOrder" name="Wants to order">
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_PlaceOrder" name="Place order">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_ReceiveConfirmation" name="Receive confirmation">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_Happy" name="Happy">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_ReceiveConfirmation" targetRef="Event_Happy" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_PlaceOrder" targetRef="Activity_ReceiveConfirmation" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_WantsToOrder" targetRef="Activity_PlaceOrder" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="BPMNShape_Participant_Shop" bpmnElement="Participant_Shop" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="732" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_Sales" bpmnElement="Lane_Sales" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="702" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_Logistics" bpmnElement="Lane_Logistics" isHorizontal="true">
        <dc:Bounds x="110" y="220" width="702" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_OrderReceived" bpmnElement="Event_OrderReceived">
        <dc:Bounds x="170" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="143" y="174" width="90" height="28" />

      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_SendConfirmation" bpmnElement="Activity_SendConfirmation">
        <dc:Bounds x="586" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Done" bpmnElement="Event_Done">
        <dc:Bounds x="746" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="748" y="314" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="686" y="290" />
        <di:waypoint x="746" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="526" y="290" />
        <di:waypoint x="586" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="316" y="190" />
        <di:waypoint x="316" y="290" />
        <di:waypoint x="426" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="206" y="150" />
        <di:waypoint x="266" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_Participant_Customer" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="80" y="440" width="732" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_WantsToOrder" bpmnElement="Event_WantsToOrder">

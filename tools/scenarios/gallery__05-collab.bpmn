      <bpmndi:BPMNShape id="BPMNShape_Activity_ReceiveConfirmation" bpmnElement="Activity_ReceiveConfirmation">
        <dc:Bounds x="396" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Happy" bpmnElement="Event_Happy">
        <dc:Bounds x="556" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="555" y="534" width="39" height="14" />

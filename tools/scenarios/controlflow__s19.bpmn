      <bpmndi:BPMNShape id="BPMNShape_Gateway_Long_join" bpmnElement="Gateway_Long_join" isMarkerVisible="true">
        <dc:Bounds x="766" y="153" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_WaitSync" bpmnElement="Event_WaitSync">

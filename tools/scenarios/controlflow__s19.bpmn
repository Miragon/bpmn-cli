<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_S19" name="s19" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="A customer sends in a completely new purchase order through the web portal">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Check" name="Check the order against the customer master data and the credit limit">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Check" targetRef="Gateway_Long" />
    <bpmn:exclusiveGateway id="Gateway_Long" name="Is the order complete, the customer known and the credit limit sufficient for the total amount?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_Book" name="Book">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Book" targetRef="Gateway_Long_join" />
    <bpmn:sequenceFlow id="Flow_3" name="yes, everything is fine and we can continue with the fulfilment process" sourceRef="Gateway_Long" targetRef="Activity_Book" />
    <bpmn:userTask id="Activity_Clarify" name="Clarify">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_Escalate" name="Escalate after three working days without any response from the customer" attachedToRef="Activity_Clarify">
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_Cancelled" name="The order was cancelled because the customer did not respond in time">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_Escalate" targetRef="Event_Cancelled" />
    <bpmn:userTask id="Activity_Correct" name="Correct">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_Correct" targetRef="Gateway_Long_join" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Clarify" targetRef="Activity_Correct" />
    <bpmn:sequenceFlow id="Flow_4" name="no, the customer has to be contacted and the order has to be corrected first" sourceRef="Gateway_Long" targetRef="Activity_Clarify" />
    <bpmn:userTask id="Activity_Approve" name="Approve">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Approve" targetRef="Gateway_Long_join" />
    <bpmn:sequenceFlow id="Flow_13" name="the sales manager rejected the approval, so re-check the order with the new limits" sourceRef="Activity_Approve" targetRef="Activity_Check" />
    <bpmn:sequenceFlow id="Flow_6" name="the credit limit is exceeded so the order needs approval by the sales manager" sourceRef="Gateway_Long" targetRef="Activity_Approve" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Check" />
    <bpmn:exclusiveGateway id="Gateway_Long_join">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_WaitSync" name="Wait for the nightly synchronisation run of the ERP system to finish">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_Success" name="The order has been successfully processed and handed over to logistics">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_WaitSync" targetRef="Event_Success" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Long_join" targetRef="Event_WaitSync" />
  </bpmn:process>

  <bpmn:process id="Process_S06" name="s06" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_Assess" name="Assess">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Assess" targetRef="Gateway_Checks" />
    <bpmn:inclusiveGateway id="Gateway_Checks" name="Which checks?" default="Flow_6">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="Activity_CreditCheck" name="Credit check">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_CreditCheck" targetRef="Gateway_Checks_join" />
    <bpmn:sequenceFlow id="Flow_3" name="credit" sourceRef="Gateway_Checks" targetRef="Activity_CreditCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${credit}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_FraudCheck" name="Fraud check">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_ManualReview" name="Manual review">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_ManualReview" targetRef="Gateway_Checks_join" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_FraudCheck" targetRef="Activity_ManualReview" />
    <bpmn:sequenceFlow id="Flow_4" name="fraud" sourceRef="Gateway_Checks" targetRef="Activity_FraudCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fraud}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Activity_BasicCheck" name="Basic check">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_BasicCheck" targetRef="Gateway_Checks_join" />
    <bpmn:sequenceFlow id="Flow_6" name="otherwise" sourceRef="Gateway_Checks" targetRef="Activity_BasicCheck" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Assess" />
    <bpmn:inclusiveGateway id="Gateway_Checks_join">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="Activity_Decide" name="Decide">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End" name="End">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_Decide" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Checks_join" targetRef="Activity_Decide" />
  </bpmn:process>

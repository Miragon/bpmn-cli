<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Main" name="s01-sub-xor-loop" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_Handle" name="Handle order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="Event_SubStart" name="Sub start">
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_Check" name="Check">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:incoming>Flow_8</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_Ok" name="Ok?">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Activity_Approve" name="Approve">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_SubDone" name="Sub done">
        <bpmn:incoming>Flow_6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Approve" targetRef="Event_SubDone" />
      <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gateway_Ok" targetRef="Activity_Approve" />
      <bpmn:userTask id="Activity_Fix" name="Fix">
        <bpmn:incoming>Flow_7</bpmn:incoming>
        <bpmn:outgoing>Flow_8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_8" name="again" sourceRef="Activity_Fix" targetRef="Activity_Check" />
      <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gateway_Ok" targetRef="Activity_Fix" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Check" targetRef="Gateway_Ok" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_SubStart" targetRef="Activity_Check" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Handle" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Handle" />
  </bpmn:process>

      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_B" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_A" targetRef="Activity_B" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_A" />
    <bpmn:subProcess id="Activity_CancelSub" name="Cancel requested" triggeredByEvent="true">
      <bpmn:startEvent id="Event_1" isInterrupting="false">
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_Cancel" />
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_Cancel" name="Cancel">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_Cancelled" name="Cancelled">
        <bpmn:incoming>Flow_5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Cancel" targetRef="Event_Cancelled" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_1" targetRef="Activity_Cancel" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_ErrorSub" name="On error" triggeredByEvent="true">
      <bpmn:startEvent id="Event_2">
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="Error_Boom" />
      </bpmn:startEvent>
      <bpmn:scriptTask id="Activity_Log" name="Log">
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:endEvent id="Event_Logged" name="Logged">
        <bpmn:incoming>Flow_7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Log" targetRef="Event_Logged" />
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_2" targetRef="Activity_Log" />
    </bpmn:subProcess>
  </bpmn:process>

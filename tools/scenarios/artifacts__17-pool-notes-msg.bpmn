<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Shop" name="Shop" processRef="Process_PN" />
    <bpmn:participant id="Participant_Cust" name="Customer" />
    <bpmn:messageFlow id="Flow_5" name="Order" sourceRef="Participant_Cust" targetRef="Event_Start" />
    <bpmn:messageFlow id="Flow_6" name="Confirmation" sourceRef="Activity_Confirm" targetRef="Participant_Cust" />
    <bpmn:messageFlow id="Flow_7" name="Payment" sourceRef="Participant_Cust" targetRef="Activity_Payment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PN" name="Pool with notes" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Order" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_Stock" name="Check stock">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1">
        <bpmn:sourceRef>DataObjectReference_Order</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_Confirm" name="Send confirmation">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_2">
        <bpmn:sourceRef>DataObjectReference_Order</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_Payment" name="Receive payment">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_End" name="Done">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Payment" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Confirm" targetRef="Activity_Payment" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Stock" targetRef="Activity_Confirm" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Stock" />
    <bpmn:dataObject id="DataObject_Order" />
    <bpmn:dataObjectReference id="DataObjectReference_Order" name="Order" dataObjectRef="DataObject_Order" />
    <bpmn:textAnnotation id="TextAnnotation_Stock">
      <bpmn:text>Checks the central warehouse only</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="TextAnnotation_Stock" targetRef="Activity_Stock" />
  </bpmn:process>
  <bpmn:message id="Message_Order" name="Order" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="BPMNShape_Participant_Shop" bpmnElement="Participant_Shop" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="702" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Start" bpmnElement="Event_Start">
        <dc:Bounds x="140" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="113" y="264" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Stock" bpmnElement="Activity_Stock">
        <dc:Bounds x="236" y="200" width="100" height="80" />

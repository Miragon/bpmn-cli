      <bpmndi:BPMNShape id="BPMNShape_Event_End" bpmnElement="Event_End">
        <dc:Bounds x="716" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="718" y="264" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="656" y="150" />
        <di:waypoint x="716" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="496" y="150" />
        <di:waypoint x="556" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="336" y="150" />
        <di:waypoint x="396" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="176" y="150" />
        <di:waypoint x="236" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_DataObjectReference_Order" bpmnElement="DataObjectReference_Order">
        <dc:Bounds x="268" y="340" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="267" y="396" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_DataInputAssociation_1" bpmnElement="DataInputAssociation_1">
        <di:waypoint x="286" y="340" />
        <di:waypoint x="286" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_DataInputAssociation_2" bpmnElement="DataInputAssociation_2">
        <di:waypoint x="304" y="351" />
        <di:waypoint x="396" y="279" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TextAnnotation_Stock" bpmnElement="TextAnnotation_Stock">
        <dc:Bounds x="146" y="110" width="280" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Association_1" bpmnElement="Association_1">
        <di:waypoint x="286" y="140" />
        <di:waypoint x="286" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_Participant_Cust" bpmnElement="Participant_Cust" isHorizontal="true">
        <dc:Bounds x="80" y="500" width="702" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="158" y="500" />
        <di:waypoint x="158" y="258" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="164" y="372" width="39" height="14" />

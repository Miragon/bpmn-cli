<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Inter" name="Intermediate events" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_Request" name="Request quote">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_CatchMsg" name="Quote received">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Quote" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_CatchTimer" name="Wait 1 day">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_ThrowMsg" name="Confirm quote">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Confirmation" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_ThrowSignal" name="Quote confirmed">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_QuoteConfirmed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_CatchSignal" name="Stock ready">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_StockReady" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_CatchCond" name="Budget available">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${budget &gt; 0}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_ThrowEsc" name="Notify manager">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Escalation_ManagerInfo" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_ThrowNone" name="Milestone">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_LinkThrow" name="To delivery">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:linkEventDefinition name="Delivery" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_ThrowNone" targetRef="Event_LinkThrow" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Event_ThrowEsc" targetRef="Event_ThrowNone" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_CatchCond" targetRef="Event_ThrowEsc" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_CatchSignal" targetRef="Event_CatchCond" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_ThrowSignal" targetRef="Event_CatchSignal" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_ThrowMsg" targetRef="Event_ThrowSignal" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_CatchTimer" targetRef="Event_ThrowMsg" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_CatchMsg" targetRef="Event_CatchTimer" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Request" targetRef="Event_CatchMsg" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Request" />
    <bpmn:intermediateCatchEvent id="Event_LinkCatch" name="To delivery">
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:linkEventDefinition name="Delivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Activity_Deliver" name="Deliver goods">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_ThrowComp" name="Compensate">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="Event_End" name="Delivered">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_Delivered" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Event_ThrowComp" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_Deliver" targetRef="Event_ThrowComp" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_LinkCatch" targetRef="Activity_Deliver" />
  </bpmn:process>
  <bpmn:message id="Message_Quote" name="Quote" />
  <bpmn:message id="Message_Confirmation" name="Confirmation" />
  <bpmn:signal id="Signal_QuoteConfirmed" name="QuoteConfirmed" />
  <bpmn:signal id="Signal_StockReady" name="StockReady" />
  <bpmn:escalation id="Escalation_ManagerInfo" name="ManagerInfo" />
  <bpmn:message id="Message_Delivered" name="Delivered" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Inter">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Inter" bpmnElement="Process_Inter">
      <bpmndi:BPMNShape id="BPMNShape_Event_Start" bpmnElement="Event_Start">

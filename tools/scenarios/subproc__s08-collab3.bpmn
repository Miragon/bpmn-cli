<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Shop" name="Shop" processRef="Process_Main" />
    <bpmn:participant id="Participant_Customer" name="Customer" />
    <bpmn:participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier" />
    <bpmn:messageFlow id="Flow_9" name="Order" sourceRef="Participant_Customer" targetRef="Event_OrderReceived" />
    <bpmn:messageFlow id="Flow_10" name="Offer" sourceRef="Activity_SendOffer" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="Flow_11" name="Stock order" sourceRef="Activity_OrderStock" targetRef="Event_OrderArrives" />
    <bpmn:messageFlow id="Flow_12" name="Goods" sourceRef="Activity_ShipGoods" targetRef="Activity_ReceiveGoods" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="s08-collab3" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sales" name="Sales">
        <bpmn:flowNodeRef>Event_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CheckOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SendOffer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics">
        <bpmn:flowNodeRef>Activity_OrderStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReceiveGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Order" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_CheckOrder" name="Check order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_SendOffer" name="Send offer">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Activity_OrderStock" name="Order stock">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_ReceiveGoods" name="Receive goods">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_ReceiveGoods" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_OrderStock" targetRef="Activity_ReceiveGoods" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_SendOffer" targetRef="Activity_OrderStock" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_CheckOrder" targetRef="Activity_SendOffer" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_OrderReceived" targetRef="Activity_CheckOrder" />
  </bpmn:process>
  <bpmn:process id="Process_Supplier" isExecutable="false">
    <bpmn:startEvent id="Event_OrderArrives" name="Order arrives">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_StockOrder" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_PickGoods" name="Pick goods">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_ShipGoods" name="Ship goods">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Shipped" name="Shipped">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_ShipGoods" targetRef="Event_Shipped" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_PickGoods" targetRef="Activity_ShipGoods" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_OrderArrives" targetRef="Activity_PickGoods" />
  </bpmn:process>
  <bpmn:message id="Message_Order" name="Order" />
  <bpmn:message id="Message_StockOrder" name="StockOrder" />

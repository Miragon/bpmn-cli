<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_AnnMulti" name="Annotations multi" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Prepare" name="Prepare shipment">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_Print" name="Print label">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_Handover" name="Hand over to carrier">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_End" name="Shipped">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Handover" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Print" targetRef="Activity_Handover" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Prepare" targetRef="Activity_Print" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Prepare" />
    <bpmn:textAnnotation id="TextAnnotation_A">
      <bpmn:text>Use packaging type B for fragile goods</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_B">
      <bpmn:text>Weigh the parcel before closing it</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Long">
      <bpmn:text>This step requires the carrier contract number, the customer's delivery preferences, the insurance flag and the export declaration if the destination is outside the EU customs union. Escalate to the team lead on doubt.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="TextAnnotation_A" targetRef="Activity_Prepare" />
    <bpmn:association id="Association_2" sourceRef="TextAnnotation_B" targetRef="Activity_Prepare" />
    <bpmn:association id="Association_3" sourceRef="TextAnnotation_Long" targetRef="Activity_Handover" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_AnnMulti">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_AnnMulti" bpmnElement="Process_AnnMulti">
      <bpmndi:BPMNShape id="BPMNShape_Event_Start" bpmnElement="Event_Start">
        <dc:Bounds x="80" y="244" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="79" y="286" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Prepare" bpmnElement="Activity_Prepare">
        <dc:Bounds x="176" y="222" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Print" bpmnElement="Activity_Print">
        <dc:Bounds x="336" y="222" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Handover" bpmnElement="Activity_Handover">
        <dc:Bounds x="496" y="222" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_End" bpmnElement="Event_End">
        <dc:Bounds x="656" y="244" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="648" y="286" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="596" y="120" />
        <di:waypoint x="656" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="436" y="120" />
        <di:waypoint x="496" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="276" y="120" />
        <di:waypoint x="336" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="176" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TextAnnotation_A" bpmnElement="TextAnnotation_A">
        <dc:Bounds x="80" y="80" width="320" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Association_1" bpmnElement="Association_1">
        <di:waypoint x="239" y="110" />
        <di:waypoint x="229" y="222" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TextAnnotation_B" bpmnElement="TextAnnotation_B">
        <dc:Bounds x="686" y="80" width="280" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Association_2" bpmnElement="Association_2">
        <di:waypoint x="772" y="110" />
        <di:waypoint x="276" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TextAnnotation_Long" bpmnElement="TextAnnotation_Long">
        <dc:Bounds x="1096" y="80" width="340" height="82" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Association_3" bpmnElement="Association_3">
        <di:waypoint x="1096" y="154" />
        <di:waypoint x="596" y="252" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

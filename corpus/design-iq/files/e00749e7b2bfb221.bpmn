<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_order-handling" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="order-handling" name="Order handling" isExecutable="false">
    <bpmn:startEvent id="startEvent_start">
      <bpmn:outgoing>flow_startToCheckOrder</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="userTask_checkOrder" name="Check order">
      <bpmn:incoming>flow_startToCheckOrder</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_startToCheckOrder" sourceRef="startEvent_start" targetRef="userTask_checkOrder" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_order-handling">
    <bpmndi:BPMNPlane id="BPMNPlane_order-handling" bpmnElement="order-handling">
      <bpmndi:BPMNShape id="startEvent_start_di" bpmnElement="startEvent_start">
        <dc:Bounds x="232" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_checkOrder_di" bpmnElement="userTask_checkOrder">
        <dc:Bounds x="328" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_startToCheckOrder_di" bpmnElement="flow_startToCheckOrder">
        <di:waypoint x="268" y="180" />
        <di:waypoint x="328" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

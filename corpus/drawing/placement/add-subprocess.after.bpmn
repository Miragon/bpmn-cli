    <bpmn:boundaryEvent id="B" name="Timeout" attachedToRef="A"><bpmn:outgoing>F5</bpmn:outgoing><bpmn:timerEventDefinition id="TD"/></bpmn:boundaryEvent>
    <bpmn:endEvent id="E2" name="Late"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="C" name="Task C"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="D" name="Task D"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E"><bpmn:incoming>flow_fzs3ToE</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F2" sourceRef="A" targetRef="C"/>
    <bpmn:sequenceFlow id="F3" sourceRef="C" targetRef="D"/>
    <bpmn:sequenceFlow id="F4" sourceRef="D" targetRef="Activity_Fzs3"/>
    <bpmn:subProcess id="Activity_Fzs3" name="Fzs3 sub">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>flow_fzs3ToE</bpmn:outgoing>
      <bpmn:startEvent id="Event_Fzs3s" name="Fzs3 start">
        <bpmn:outgoing>flow_fzs3sToFzs3i</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Activity_Fzs3i" name="Fzs3 inner">
        <bpmn:incoming>flow_fzs3sToFzs3i</bpmn:incoming>
        <bpmn:outgoing>flow_fzs3iToFzs3e</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Event_Fzs3e" name="Fzs3 end">
        <bpmn:incoming>flow_fzs3iToFzs3e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_fzs3iToFzs3e" sourceRef="Activity_Fzs3i" targetRef="Event_Fzs3e"/>
      <bpmn:sequenceFlow id="flow_fzs3sToFzs3i" sourceRef="Event_Fzs3s" targetRef="Activity_Fzs3i"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_fzs3ToE" sourceRef="Activity_Fzs3" targetRef="E"/>
    <bpmn:sequenceFlow id="F5" sourceRef="B" targetRef="E2"/>
  </bpmn:process>

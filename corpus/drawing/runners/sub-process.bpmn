      <bpmndi:BPMNShape id="BPMNShape_ST" bpmnElement="ST">
        <dc:Bounds x="745" y="151" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_SE" bpmnElement="SE">

      <bpmndi:BPMNEdge id="BPMNEdge_flow_innerToInnerDone" bpmnElement="flow_innerToInnerDone">
        <di:waypoint x="845" y="191" />
        <di:waypoint x="905" y="191" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_ssToInner" bpmnElement="flow_ssToInner">
        <di:waypoint x="685" y="191" />
        <di:waypoint x="745" y="191" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TB" bpmnElement="TB">
        <dc:Bounds x="928" y="243" width="36" height="36" />

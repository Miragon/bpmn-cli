      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="460" y="335"/><di:waypoint x="545" y="335"/><di:waypoint x="545" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="570" y="165"/><di:waypoint x="632" y="165"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

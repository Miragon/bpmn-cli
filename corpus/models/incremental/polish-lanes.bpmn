      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="275" y="190"/><di:waypoint x="275" y="335"/><di:waypoint x="360" y="335"/><bpmndi:BPMNLabel><dc:Bounds x="281" y="200" width="20" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>

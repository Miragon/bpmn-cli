<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic hand drawing: the data input association D -> A is one straight diagonal line that passes just
     above the event X (its bounding box covers X, the line does not cut it). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:startEvent id="S"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="A" name="Assess">
      <bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:property id="Prop_A" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA"><bpmn:sourceRef>D</bpmn:sourceRef><bpmn:targetRef>Prop_A</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="E"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="X" name="Noted"/>
    <bpmn:dataObjectReference id="D" name="Claim" dataObjectRef="DO1"/>
    <bpmn:dataObject id="DO1"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="A"/>
    <bpmn:sequenceFlow id="F2" sourceRef="A" targetRef="E"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="P1">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="480" y="62" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A"><dc:Bounds x="576" y="40" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="736" y="62" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_di" bpmnElement="X"><dc:Bounds x="420" y="250" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="416" y="293" width="44" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_di" bpmnElement="D"><dc:Bounds x="100" y="400" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="102" y="457" width="32" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="516" y="80"/><di:waypoint x="576" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="676" y="80"/><di:waypoint x="736" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_di" bpmnElement="DIA"><di:waypoint x="136" y="410"/><di:waypoint x="626" y="120"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

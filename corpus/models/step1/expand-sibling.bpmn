<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic hand drawing: the collapsed sub-process C sits in the expanded sub-process P; the sibling
     sub-process Q lies below P, left of C's column. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:startEvent id="S"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="P" name="Parent"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:startEvent id="PS"><bpmn:outgoing>G1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:subProcess id="C" name="Child"><bpmn:incoming>G1</bpmn:incoming><bpmn:outgoing>G2</bpmn:outgoing></bpmn:subProcess>
      <bpmn:endEvent id="PE"><bpmn:incoming>G2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="G1" sourceRef="PS" targetRef="C"/>
      <bpmn:sequenceFlow id="G2" sourceRef="C" targetRef="PE"/>
    </bpmn:subProcess>
    <bpmn:task id="T" name="Then"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E"><bpmn:incoming>F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="Q" name="Sibling">
      <bpmn:task id="QT" name="Inside"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="P"/>
    <bpmn:sequenceFlow id="F2" sourceRef="P" targetRef="T"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T" targetRef="E"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="P1">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="100" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_di" bpmnElement="P" isExpanded="true"><dc:Bounds x="200" y="100" width="440" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PS_di" bpmnElement="PS"><dc:Bounds x="230" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_di" bpmnElement="C" isExpanded="false"><dc:Bounds x="320" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PE_di" bpmnElement="PE"><dc:Bounds x="480" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_di" bpmnElement="T"><dc:Bounds x="700" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="860" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_di" bpmnElement="Q" isExpanded="true"><dc:Bounds x="100" y="340" width="200" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="QT_di" bpmnElement="QT"><dc:Bounds x="150" y="370" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="200"/><di:waypoint x="200" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="640" y="200"/><di:waypoint x="700" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="800" y="200"/><di:waypoint x="860" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G1_di" bpmnElement="G1"><di:waypoint x="266" y="200"/><di:waypoint x="320" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G2_di" bpmnElement="G2"><di:waypoint x="420" y="200"/><di:waypoint x="480" y="200"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

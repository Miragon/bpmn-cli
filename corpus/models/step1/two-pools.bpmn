<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic hand drawing: two pools; Supplier (with one lane) lies below Customer, shifted to the right. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C1">
    <bpmn:participant id="Customer" name="Customer" processRef="P1"/>
    <bpmn:participant id="Supplier" name="Supplier" processRef="P2"/>
    <bpmn:messageFlow id="MF1" sourceRef="Send" targetRef="OrderIn"/>
  </bpmn:collaboration>
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:startEvent id="Need"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sendTask id="Send" name="Send order"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="Done"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Need" targetRef="Send"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Send" targetRef="Done"/>
  </bpmn:process>
  <bpmn:process id="P2" isExecutable="true">
    <bpmn:laneSet id="LS2"><bpmn:lane id="Clerk" name="Clerk"><bpmn:flowNodeRef>OrderIn</bpmn:flowNodeRef><bpmn:flowNodeRef>Pick</bpmn:flowNodeRef><bpmn:flowNodeRef>Shipped</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="OrderIn"><bpmn:outgoing>F3</bpmn:outgoing><bpmn:messageEventDefinition id="MED1"/></bpmn:startEvent>
    <bpmn:serviceTask id="Pick" name="Pick goods"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Shipped"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F3" sourceRef="OrderIn" targetRef="Pick"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Pick" targetRef="Shipped"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="C1">
      <bpmndi:BPMNShape id="Customer_di" bpmnElement="Customer" isHorizontal="true"><dc:Bounds x="80" y="80" width="412" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Need_di" bpmnElement="Need"><dc:Bounds x="140" y="137" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_di" bpmnElement="Send"><dc:Bounds x="236" y="115" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done"><dc:Bounds x="396" y="137" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Supplier_di" bpmnElement="Supplier" isHorizontal="true"><dc:Bounds x="480" y="310" width="412" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Clerk_di" bpmnElement="Clerk" isHorizontal="true"><dc:Bounds x="510" y="310" width="382" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderIn_di" bpmnElement="OrderIn"><dc:Bounds x="570" y="362" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pick_di" bpmnElement="Pick"><dc:Bounds x="666" y="340" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shipped_di" bpmnElement="Shipped"><dc:Bounds x="826" y="362" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="176" y="155"/><di:waypoint x="236" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="336" y="155"/><di:waypoint x="396" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="606" y="380"/><di:waypoint x="666" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="766" y="380"/><di:waypoint x="826" y="380"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF1_di" bpmnElement="MF1"><di:waypoint x="286" y="195"/><di:waypoint x="286" y="270"/><di:waypoint x="588" y="270"/><di:waypoint x="588" y="362"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

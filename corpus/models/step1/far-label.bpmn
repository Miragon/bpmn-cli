<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic hand drawing: the sub-process SUB at the top; outside it, the branch "no" of G runs far down and
     its label lies far below SUB. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:startEvent id="S"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="SUB" name="Sub"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:startEvent id="SS"><bpmn:outgoing>G1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="ST" name="Inner"><bpmn:incoming>G1</bpmn:incoming><bpmn:outgoing>G2</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="SE"><bpmn:incoming>G2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="G1" sourceRef="SS" targetRef="ST"/>
      <bpmn:sequenceFlow id="G2" sourceRef="ST" targetRef="SE"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G" name="Ok?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="T1" name="Go on"><bpmn:incoming>F3</bpmn:incoming></bpmn:task>
    <bpmn:task id="T2" name="Repair"><bpmn:incoming>F4</bpmn:incoming></bpmn:task>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="SUB"/>
    <bpmn:sequenceFlow id="F2" sourceRef="SUB" targetRef="G"/>
    <bpmn:sequenceFlow id="F3" name="yes" sourceRef="G" targetRef="T1"/>
    <bpmn:sequenceFlow id="F4" name="no" sourceRef="G" targetRef="T2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="P1">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="100" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SUB_di" bpmnElement="SUB" isExpanded="true"><dc:Bounds x="200" y="80" width="360" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SS_di" bpmnElement="SS"><dc:Bounds x="230" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_di" bpmnElement="ST"><dc:Bounds x="310" y="120" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SE_di" bpmnElement="SE"><dc:Bounds x="470" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_di" bpmnElement="G" isMarkerVisible="true"><dc:Bounds x="620" y="135" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="632" y="110" width="26" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="730" y="120" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="730" y="560" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="160"/><di:waypoint x="200" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="560" y="160"/><di:waypoint x="620" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="670" y="160"/><di:waypoint x="730" y="160"/><bpmndi:BPMNLabel><dc:Bounds x="680" y="142" width="20" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="645" y="185"/><di:waypoint x="645" y="600"/><di:waypoint x="730" y="600"/><bpmndi:BPMNLabel><dc:Bounds x="652" y="560" width="16" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G1_di" bpmnElement="G1"><di:waypoint x="266" y="160"/><di:waypoint x="310" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G2_di" bpmnElement="G2"><di:waypoint x="410" y="160"/><di:waypoint x="470" y="160"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

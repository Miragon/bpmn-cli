<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Orders" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0">
  <bpmn:process id="Process_Orders" name="Orders" isExecutable="false">
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_OrderReceivedToCheckOrder</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_CheckOrder" name="Check order">
      <bpmn:incoming>Flow_OrderReceivedToCheckOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckOrderToOrderDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OrderDecision" name="Order decision?">
      <bpmn:incoming>Flow_CheckOrderToOrderDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderDecisionReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderDecisionApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderDecisionReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_ApproveOrder" name="Approve order">
      <bpmn:incoming>Flow_OrderDecisionReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveOrderToApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_ApproveOrderToApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_OrderApproved">
      <bpmn:incoming>Flow_OrderDecisionApprove</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderApprovedToReserveStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_ReserveStock" name="Reserve stock">
      <bpmn:incoming>Flow_OrderApprovedToReserveStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ReserveStockToInStock</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_InStock" name="In stock?">
      <bpmn:incoming>Flow_ReserveStockToInStock</bpmn:incoming>
      <bpmn:outgoing>Flow_InStockYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_InStockNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_OrderShipped" name="Order shipped">
      <bpmn:incoming>Flow_InStockYes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_RejectMerge">
      <bpmn:incoming>Flow_OrderDecisionReject</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovedNo</bpmn:incoming>
      <bpmn:incoming>Flow_InStockNo</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectMergeToSendRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_SendRejection" name="Send rejection">
      <bpmn:incoming>Flow_RejectMergeToSendRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_SendRejectionToOrderRejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_OrderRejected" name="Order rejected">
      <bpmn:incoming>Flow_SendRejectionToOrderRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OrderReceivedToCheckOrder" sourceRef="Event_OrderReceived" targetRef="Activity_CheckOrder" />
    <bpmn:sequenceFlow id="Flow_CheckOrderToOrderDecision" sourceRef="Activity_CheckOrder" targetRef="Gateway_OrderDecision" />
    <bpmn:sequenceFlow id="Flow_OrderDecisionReview" name="review" sourceRef="Gateway_OrderDecision" targetRef="Activity_ApproveOrder" />
    <bpmn:sequenceFlow id="Flow_OrderDecisionApprove" name="approve" sourceRef="Gateway_OrderDecision" targetRef="Gateway_OrderApproved" />
    <bpmn:sequenceFlow id="Flow_OrderDecisionReject" name="reject" sourceRef="Gateway_OrderDecision" targetRef="Gateway_RejectMerge" />
    <bpmn:sequenceFlow id="Flow_ApproveOrderToApproved" sourceRef="Activity_ApproveOrder" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_ApprovedYes" name="yes" sourceRef="Gateway_Approved" targetRef="Gateway_OrderApproved" />
    <bpmn:sequenceFlow id="Flow_ApprovedNo" name="no" sourceRef="Gateway_Approved" targetRef="Gateway_RejectMerge" />
    <bpmn:sequenceFlow id="Flow_OrderApprovedToReserveStock" sourceRef="Gateway_OrderApproved" targetRef="Activity_ReserveStock" />
    <bpmn:sequenceFlow id="Flow_ReserveStockToInStock" sourceRef="Activity_ReserveStock" targetRef="Gateway_InStock" />
    <bpmn:sequenceFlow id="Flow_InStockYes" name="yes" sourceRef="Gateway_InStock" targetRef="Event_OrderShipped" />
    <bpmn:sequenceFlow id="Flow_InStockNo" name="no" sourceRef="Gateway_InStock" targetRef="Gateway_RejectMerge" />
    <bpmn:sequenceFlow id="Flow_RejectMergeToSendRejection" sourceRef="Gateway_RejectMerge" targetRef="Activity_SendRejection" />
    <bpmn:sequenceFlow id="Flow_SendRejectionToOrderRejected" sourceRef="Activity_SendRejection" targetRef="Event_OrderRejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Orders">
      <bpmndi:BPMNShape id="Event_OrderReceived_di" bpmnElement="Event_OrderReceived">
        <dc:Bounds x="82" y="177" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="72" y="218" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CheckOrder_di" bpmnElement="Activity_CheckOrder">
        <dc:Bounds x="150" y="155" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OrderDecision_di" bpmnElement="Gateway_OrderDecision">
        <dc:Bounds x="310" y="170" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="300" y="225" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ApproveOrder_di" bpmnElement="Activity_ApproveOrder">
        <dc:Bounds x="470" y="155" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved">
        <dc:Bounds x="615" y="170" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="605" y="225" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OrderApproved_di" bpmnElement="Gateway_OrderApproved">
        <dc:Bounds x="615" y="20" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ReserveStock_di" bpmnElement="Activity_ReserveStock">
        <dc:Bounds x="760" y="5" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_InStock_di" bpmnElement="Gateway_InStock">
        <dc:Bounds x="925" y="20" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="915" y="75" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_OrderShipped_di" bpmnElement="Event_OrderShipped">
        <dc:Bounds x="1062" y="27" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1052" y="68" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RejectMerge_di" bpmnElement="Gateway_RejectMerge">
        <dc:Bounds x="1115" y="320" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SendRejection_di" bpmnElement="Activity_SendRejection">
        <dc:Bounds x="1240" y="305" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_OrderRejected_di" bpmnElement="Event_OrderRejected">
        <dc:Bounds x="1402" y="327" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1392" y="368" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_OrderReceivedToCheckOrder_di" bpmnElement="Flow_OrderReceivedToCheckOrder">
        <di:waypoint x="118" y="195" />
        <di:waypoint x="150" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CheckOrderToOrderDecision_di" bpmnElement="Flow_CheckOrderToOrderDecision">
        <di:waypoint x="250" y="195" />
        <di:waypoint x="310" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OrderDecisionReview_di" bpmnElement="Flow_OrderDecisionReview">
        <di:waypoint x="360" y="195" />
        <di:waypoint x="470" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OrderDecisionApprove_di" bpmnElement="Flow_OrderDecisionApprove">
        <di:waypoint x="335" y="170" />
        <di:waypoint x="335" y="45" />
        <di:waypoint x="615" y="45" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OrderDecisionReject_di" bpmnElement="Flow_OrderDecisionReject">
        <di:waypoint x="335" y="220" />
        <di:waypoint x="335" y="345" />
        <di:waypoint x="1115" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApproveOrderToApproved_di" bpmnElement="Flow_ApproveOrderToApproved">
        <di:waypoint x="570" y="195" />
        <di:waypoint x="615" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovedYes_di" bpmnElement="Flow_ApprovedYes">
        <di:waypoint x="640" y="170" />
        <di:waypoint x="640" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovedNo_di" bpmnElement="Flow_ApprovedNo">
        <di:waypoint x="640" y="220" />
        <di:waypoint x="640" y="345" />
        <di:waypoint x="1115" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OrderApprovedToReserveStock_di" bpmnElement="Flow_OrderApprovedToReserveStock">
        <di:waypoint x="665" y="45" />
        <di:waypoint x="760" y="45" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReserveStockToInStock_di" bpmnElement="Flow_ReserveStockToInStock">
        <di:waypoint x="860" y="45" />
        <di:waypoint x="925" y="45" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InStockYes_di" bpmnElement="Flow_InStockYes">
        <di:waypoint x="975" y="45" />
        <di:waypoint x="1062" y="45" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InStockNo_di" bpmnElement="Flow_InStockNo">
        <di:waypoint x="950" y="70" />
        <di:waypoint x="950" y="345" />
        <di:waypoint x="1115" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectMergeToSendRejection_di" bpmnElement="Flow_RejectMergeToSendRejection">
        <di:waypoint x="1165" y="345" />
        <di:waypoint x="1240" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendRejectionToOrderRejected_di" bpmnElement="Flow_SendRejectionToOrderRejected">
        <di:waypoint x="1340" y="345" />
        <di:waypoint x="1402" y="345" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LongOrder" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_LongOrder" name="Long order" isExecutable="true">
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_OrderReceivedToReceiveOrder</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_ReceiveOrder" name="Receive order">
      <bpmn:incoming>Flow_OrderReceivedToReceiveOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveOrderToCheckStock</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_CheckStock" name="Check stock">
      <bpmn:incoming>Flow_ReceiveOrderToCheckStock</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckStockToReserveItems</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_ReserveItems" name="Reserve items">
      <bpmn:incoming>Flow_CheckStockToReserveItems</bpmn:incoming>
      <bpmn:outgoing>Flow_ReserveItemsToCheckCustomer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_CheckCustomer" name="Check customer">
      <bpmn:incoming>Flow_ReserveItemsToCheckCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckCustomerToVerifyAddress</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_VerifyAddress" name="Verify address">
      <bpmn:incoming>Flow_CheckCustomerToVerifyAddress</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyAddressToCalculateShipping</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_CalculateShipping" name="Calculate shipping">
      <bpmn:incoming>Flow_VerifyAddressToCalculateShipping</bpmn:incoming>
      <bpmn:outgoing>Flow_CalculateShippingToCalculateShippingOk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CalculateShippingOk" name="Calculate shipping ok?">
      <bpmn:incoming>Flow_CalculateShippingToCalculateShippingOk</bpmn:incoming>
      <bpmn:outgoing>Flow_CalculateShippingOkToCalculateShippingFailed</bpmn:outgoing>
      <bpmn:outgoing>Flow_CalculateShippingOkToApplyDiscount</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_CalculateShippingFailed" name="Calculate shipping failed">
      <bpmn:incoming>Flow_CalculateShippingOkToCalculateShippingFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CalculateShippingOkToCalculateShippingFailed" name="no" sourceRef="Gateway_CalculateShippingOk" targetRef="Event_CalculateShippingFailed" />
    <bpmn:userTask id="Activity_ApplyDiscount" name="Apply discount">
      <bpmn:incoming>Flow_CalculateShippingOkToApplyDiscount</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyDiscountToCreateInvoice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_CreateInvoice" name="Create invoice">
      <bpmn:incoming>Flow_ApplyDiscountToCreateInvoice</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateInvoiceToSendInvoice</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_SendInvoice" name="Send invoice">
      <bpmn:incoming>Flow_CreateInvoiceToSendInvoice</bpmn:incoming>
      <bpmn:outgoing>Flow_SendInvoiceToWaitForPayment</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_WaitForPayment" name="Wait for payment">
      <bpmn:incoming>Flow_SendInvoiceToWaitForPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForPaymentToBookPayment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_BookPayment" name="Book payment">
      <bpmn:incoming>Flow_WaitForPaymentToBookPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_BookPaymentToNotifyWarehouse</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_NotifyWarehouse" name="Notify warehouse">
      <bpmn:incoming>Flow_BookPaymentToNotifyWarehouse</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyWarehouseToPickItems</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_PickItems" name="Pick items">
      <bpmn:incoming>Flow_NotifyWarehouseToPickItems</bpmn:incoming>
      <bpmn:outgoing>Flow_PickItemsToPackItems</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_PackItems" name="Pack items">
      <bpmn:incoming>Flow_PickItemsToPackItems</bpmn:incoming>
      <bpmn:outgoing>Flow_PackItemsToWeighParcel</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_WeighParcel" name="Weigh parcel">
      <bpmn:incoming>Flow_PackItemsToWeighParcel</bpmn:incoming>
      <bpmn:outgoing>Flow_WeighParcelToWeighParcelOk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WeighParcelOk" name="Weigh parcel ok?">
      <bpmn:incoming>Flow_WeighParcelToWeighParcelOk</bpmn:incoming>
      <bpmn:outgoing>Flow_WeighParcelOkToWeighParcelFailed</bpmn:outgoing>
      <bpmn:outgoing>Flow_WeighParcelOkToPrintLabel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_WeighParcelFailed" name="Weigh parcel failed">
      <bpmn:incoming>Flow_WeighParcelOkToWeighParcelFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_WeighParcelOkToWeighParcelFailed" name="no" sourceRef="Gateway_WeighParcelOk" targetRef="Event_WeighParcelFailed" />
    <bpmn:userTask id="Activity_PrintLabel" name="Print label">
      <bpmn:incoming>Flow_WeighParcelOkToPrintLabel</bpmn:incoming>
      <bpmn:outgoing>Flow_PrintLabelToHandOverToCarrier</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_HandOverToCarrier" name="Hand over to carrier">
      <bpmn:incoming>Flow_PrintLabelToHandOverToCarrier</bpmn:incoming>
      <bpmn:outgoing>Flow_HandOverToCarrierToTrackParcel</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_TrackParcel" name="Track parcel">
      <bpmn:incoming>Flow_HandOverToCarrierToTrackParcel</bpmn:incoming>
      <bpmn:outgoing>Flow_TrackParcelToConfirmDelivery</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_ConfirmDelivery" name="Confirm delivery">
      <bpmn:incoming>Flow_TrackParcelToConfirmDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmDeliveryToAskForFeedback</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_AskForFeedback" name="Ask for feedback">
      <bpmn:incoming>Flow_ConfirmDeliveryToAskForFeedback</bpmn:incoming>
      <bpmn:outgoing>Flow_AskForFeedbackToArchiveOrder</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_ArchiveOrder" name="Archive order">
      <bpmn:incoming>Flow_AskForFeedbackToArchiveOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ArchiveOrderToCloseCase</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_CloseCase" name="Close case">
      <bpmn:incoming>Flow_ArchiveOrderToCloseCase</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseCaseToOrderDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_OrderDone" name="Order done">
      <bpmn:incoming>Flow_CloseCaseToOrderDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CloseCaseToOrderDone" sourceRef="Activity_CloseCase" targetRef="Event_OrderDone" />
    <bpmn:sequenceFlow id="Flow_ArchiveOrderToCloseCase" sourceRef="Activity_ArchiveOrder" targetRef="Activity_CloseCase" />
    <bpmn:sequenceFlow id="Flow_AskForFeedbackToArchiveOrder" sourceRef="Activity_AskForFeedback" targetRef="Activity_ArchiveOrder" />
    <bpmn:sequenceFlow id="Flow_ConfirmDeliveryToAskForFeedback" sourceRef="Activity_ConfirmDelivery" targetRef="Activity_AskForFeedback" />
    <bpmn:sequenceFlow id="Flow_TrackParcelToConfirmDelivery" sourceRef="Activity_TrackParcel" targetRef="Activity_ConfirmDelivery" />
    <bpmn:sequenceFlow id="Flow_HandOverToCarrierToTrackParcel" sourceRef="Activity_HandOverToCarrier" targetRef="Activity_TrackParcel" />
    <bpmn:sequenceFlow id="Flow_PrintLabelToHandOverToCarrier" sourceRef="Activity_PrintLabel" targetRef="Activity_HandOverToCarrier" />
    <bpmn:sequenceFlow id="Flow_WeighParcelOkToPrintLabel" sourceRef="Gateway_WeighParcelOk" targetRef="Activity_PrintLabel" />
    <bpmn:sequenceFlow id="Flow_WeighParcelToWeighParcelOk" sourceRef="Activity_WeighParcel" targetRef="Gateway_WeighParcelOk" />
    <bpmn:sequenceFlow id="Flow_PackItemsToWeighParcel" sourceRef="Activity_PackItems" targetRef="Activity_WeighParcel" />
    <bpmn:sequenceFlow id="Flow_PickItemsToPackItems" sourceRef="Activity_PickItems" targetRef="Activity_PackItems" />
    <bpmn:sequenceFlow id="Flow_NotifyWarehouseToPickItems" sourceRef="Activity_NotifyWarehouse" targetRef="Activity_PickItems" />
    <bpmn:sequenceFlow id="Flow_BookPaymentToNotifyWarehouse" sourceRef="Activity_BookPayment" targetRef="Activity_NotifyWarehouse" />
    <bpmn:sequenceFlow id="Flow_WaitForPaymentToBookPayment" sourceRef="Activity_WaitForPayment" targetRef="Activity_BookPayment" />
    <bpmn:sequenceFlow id="Flow_SendInvoiceToWaitForPayment" sourceRef="Activity_SendInvoice" targetRef="Activity_WaitForPayment" />
    <bpmn:sequenceFlow id="Flow_CreateInvoiceToSendInvoice" sourceRef="Activity_CreateInvoice" targetRef="Activity_SendInvoice" />
    <bpmn:sequenceFlow id="Flow_ApplyDiscountToCreateInvoice" sourceRef="Activity_ApplyDiscount" targetRef="Activity_CreateInvoice" />
    <bpmn:sequenceFlow id="Flow_CalculateShippingOkToApplyDiscount" sourceRef="Gateway_CalculateShippingOk" targetRef="Activity_ApplyDiscount" />
    <bpmn:sequenceFlow id="Flow_CalculateShippingToCalculateShippingOk" sourceRef="Activity_CalculateShipping" targetRef="Gateway_CalculateShippingOk" />
    <bpmn:sequenceFlow id="Flow_VerifyAddressToCalculateShipping" sourceRef="Activity_VerifyAddress" targetRef="Activity_CalculateShipping" />
    <bpmn:sequenceFlow id="Flow_CheckCustomerToVerifyAddress" sourceRef="Activity_CheckCustomer" targetRef="Activity_VerifyAddress" />
    <bpmn:sequenceFlow id="Flow_ReserveItemsToCheckCustomer" sourceRef="Activity_ReserveItems" targetRef="Activity_CheckCustomer" />
    <bpmn:sequenceFlow id="Flow_CheckStockToReserveItems" sourceRef="Activity_CheckStock" targetRef="Activity_ReserveItems" />
    <bpmn:sequenceFlow id="Flow_ReceiveOrderToCheckStock" sourceRef="Activity_ReceiveOrder" targetRef="Activity_CheckStock" />
    <bpmn:sequenceFlow id="Flow_OrderReceivedToReceiveOrder" sourceRef="Event_OrderReceived" targetRef="Activity_ReceiveOrder" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_LongOrder">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_LongOrder" bpmnElement="Process_LongOrder">

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="definitions_orderHandling" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_1" name="Order handling" isExecutable="true">
    <bpmn:laneSet id="laneSet_orderHandling">
      <bpmn:lane id="lane_sales" name="Sales">
        <bpmn:flowNodeRef>startEvent_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_overdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_billing" name="Billing">
        <bpmn:flowNodeRef>serviceTask_charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startEvent_received" name="Order received">
      <bpmn:outgoing>flow_receivedToCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="userTask_check" name="Check order">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_receivedToCheck</bpmn:incoming>
      <bpmn:outgoing>flow_checkToOrderOk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="event_overdue" name="Overdue" attachedToRef="userTask_check">
      <bpmn:outgoing>flow_overdueToRejected</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timerEventDefinition_overdue">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_overdueToRejected" sourceRef="event_overdue" targetRef="endEvent_rejected" />
    <bpmn:exclusiveGateway id="gateway_ok" name="Order ok?" default="flow_okToRejected">
      <bpmn:incoming>flow_checkToOrderOk</bpmn:incoming>
      <bpmn:outgoing>flow_okToCharge</bpmn:outgoing>
      <bpmn:outgoing>flow_okToRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="serviceTask_charge" name="Charge card">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge-card" />
        <zeebe:ioMapping>
          <zeebe:input source="=order.total" target="amount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_okToCharge</bpmn:incoming>
      <bpmn:outgoing>flow_chargeToDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_done" name="Order done">
      <bpmn:incoming>flow_chargeToDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_chargeToDone" sourceRef="serviceTask_charge" targetRef="endEvent_done" />
    <bpmn:sequenceFlow id="flow_okToCharge" sourceRef="gateway_ok" targetRef="serviceTask_charge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="endEvent_rejected" name="Order rejected">
      <bpmn:incoming>flow_okToRejected</bpmn:incoming>
      <bpmn:incoming>flow_overdueToRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_okToRejected" sourceRef="gateway_ok" targetRef="endEvent_rejected" />
    <bpmn:sequenceFlow id="flow_checkToOrderOk" sourceRef="userTask_check" targetRef="gateway_ok" />
    <bpmn:sequenceFlow id="flow_receivedToCheck" sourceRef="startEvent_received" targetRef="userTask_check" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="BPMNShape_lane_sales" bpmnElement="lane_sales" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="675" height="274" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_billing" bpmnElement="lane_billing" isHorizontal="true">
        <dc:Bounds x="80" y="354" width="675" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_startEvent_received" bpmnElement="startEvent_received">
        <dc:Bounds x="140" y="151" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="124" y="193" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_userTask_check" bpmnElement="userTask_check">
        <dc:Bounds x="236" y="129" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_event_overdue" bpmnElement="event_overdue">
        <dc:Bounds x="293" y="191" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="333" y="211" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gateway_ok" bpmnElement="gateway_ok" isMarkerVisible="true">
        <dc:Bounds x="396" y="144" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="384" y="124" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_serviceTask_charge" bpmnElement="serviceTask_charge">
        <dc:Bounds x="506" y="384" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endEvent_done" bpmnElement="endEvent_done">
        <dc:Bounds x="666" y="406" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="643" y="448" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endEvent_rejected" bpmnElement="endEvent_rejected">
        <dc:Bounds x="538" y="288" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="522" y="330" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_overdueToRejected" bpmnElement="flow_overdueToRejected">
        <di:waypoint x="311" y="227" />
        <di:waypoint x="311" y="306" />
        <di:waypoint x="538" y="306" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_chargeToDone" bpmnElement="flow_chargeToDone">
        <di:waypoint x="606" y="424" />
        <di:waypoint x="666" y="424" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_okToCharge" bpmnElement="flow_okToCharge">
        <di:waypoint x="421" y="194" />
        <di:waypoint x="421" y="424" />
        <di:waypoint x="506" y="424" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_okToRejected" bpmnElement="flow_okToRejected">
        <di:waypoint x="421" y="194" />
        <di:waypoint x="421" y="306" />
        <di:waypoint x="538" y="306" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_checkToOrderOk" bpmnElement="flow_checkToOrderOk">
        <di:waypoint x="336" y="169" />
        <di:waypoint x="396" y="169" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_receivedToCheck" bpmnElement="flow_receivedToCheck">
        <di:waypoint x="176" y="169" />
        <di:waypoint x="236" y="169" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
    modeler:executionPlatform="Camunda Platform"
    modeler:executionPlatformVersion="7.24.0"
    
    id="definitions_test" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process_test" isExecutable="true">
    <bpmn:extensionElements><camunda:executionListener event="start" class="a.B" /><camunda:potentialStarter /></bpmn:extensionElements>
           <bpmn:userTask id="userTask_review"><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="a">1</camunda:inputParameter></camunda:inputOutput><camunda:taskListener event="create" class="a.B" /><camunda:formData /><camunda:properties><camunda:property name="a" value="1" /></camunda:properties></bpmn:extensionElements></bpmn:userTask>
           <bpmn:serviceTask id="serviceTask_charge" camunda:type="external" camunda:topic="charge"><bpmn:extensionElements><camunda:errorEventDefinition id="errorEventDefinition_failed" expression="${true}" /></bpmn:extensionElements></bpmn:serviceTask>
           <bpmn:callActivity id="callActivity_ship" calledElement="ship"><bpmn:extensionElements><camunda:in variables="all" /><camunda:out variables="all" /></bpmn:extensionElements></bpmn:callActivity>
  </bpmn:process>
  
</bpmn:definitions>
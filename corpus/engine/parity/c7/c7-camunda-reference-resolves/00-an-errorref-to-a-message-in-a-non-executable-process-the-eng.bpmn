<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
    modeler:executionPlatform="Camunda Platform"
    modeler:executionPlatformVersion="7.24.0"
    
    id="definitions_test" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process_test" isExecutable="false">
    <bpmn:serviceTask id="serviceTask_charge" camunda:type="external" camunda:topic="charge"><bpmn:extensionElements><camunda:errorEventDefinition id="errorEventDefinition_failed" errorRef="message_paid" expression="${true}" /></bpmn:extensionElements></bpmn:serviceTask>
  </bpmn:process>
  <bpmn:error id="error_failed" name="failed" errorCode="E1" /><bpmn:message id="message_paid" name="paid" />

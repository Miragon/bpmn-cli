    id="definitions_test" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process_test" isExecutable="true">
    
    <bpmn:startEvent id="Start" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="X" />
    <bpmn:serviceTask id="X" />
    <bpmn:sequenceFlow id="F2" sourceRef="X" targetRef="End" />
    <bpmn:endEvent id="End"></bpmn:endEvent>
    <bpmn:boundaryEvent id="B0" attachedToRef="X" cancelActivity="false"><bpmn:errorEventDefinition id="ED0" /></bpmn:boundaryEvent>

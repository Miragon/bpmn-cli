<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.10.0"
    
    id="definitions_test" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process_test" isExecutable="true">
    
    <bpmn:startEvent id="Start" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="X" />
    <bpmn:serviceTask id="X" />
    <bpmn:boundaryEvent id="B" attachedToRef="X"><bpmn:compensateEventDefinition id="CB" /></bpmn:boundaryEvent>
    <bpmn:serviceTask id="H" isForCompensation="true" />
    <bpmn:sequenceFlow id="F2" sourceRef="X" targetRef="T" />
    <bpmn:intermediateThrowEvent id="T"><bpmn:compensateEventDefinition id="CT" activityRef="Inner" /></bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="F3" sourceRef="T" targetRef="End" />
    <bpmn:endEvent id="End" />
    <bpmn:subProcess id="Sub"><bpmn:task id="Inner" /></bpmn:subProcess>
    <bpmn:association id="A" associationDirection="One" sourceRef="B" targetRef="H" />
  </bpmn:process>
  
</bpmn:definitions>
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" modeler:executionPlatform="Camunda Platform" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:signal id="Sig" name="Go" /><bpmn:signal id="Sig2" name="Go2" /><bpmn:message id="M" name="Pay" /><bpmn:message id="M2" name="Pay2" /><bpmn:message id="M3" name="Pay" /><bpmn:escalation id="Esc" name="Esc" escalationCode="E1" /><bpmn:error id="Err" name="Err" errorCode="E1" />
  <bpmn:process id="P_FollowUp" isExecutable="true" camunda:historyTimeToLive="180">
<bpmn:startEvent id="Start" />
<bpmn:intermediateCatchEvent id="W"><bpmn:messageEventDefinition messageRef="M" camunda:type="external" camunda:topic="t" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="W2"><bpmn:signalEventDefinition signalRef="Sig" camunda:async="true" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateThrowEvent id="Th"><bpmn:escalationEventDefinition escalationRef="Esc" camunda:escalationCodeVariable="c" /></bpmn:intermediateThrowEvent>
<bpmn:endEvent id="End"><bpmn:errorEventDefinition errorRef="Err" camunda:errorCodeVariable="c" /></bpmn:endEvent>
<bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="W" />
<bpmn:sequenceFlow id="F1" sourceRef="W" targetRef="W2" />
<bpmn:sequenceFlow id="F2" sourceRef="W2" targetRef="Th" />
<bpmn:sequenceFlow id="F3" sourceRef="Th" targetRef="End" />

  </bpmn:process>
</bpmn:definitions>
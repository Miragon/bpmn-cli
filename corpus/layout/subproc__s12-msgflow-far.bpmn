  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Worker" name="Worker" processRef="Process_Main" />
    <bpmn:participant id="Participant_Client" name="Client" processRef="Process_Client" />
    <bpmn:messageFlow id="Flow_12" name="Job" sourceRef="Activity_SendJob" targetRef="Event_JobReceived" />
    <bpmn:messageFlow id="Flow_13" name="Result" sourceRef="Activity_SendResult" targetRef="Activity_WaitResult" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="s12-msgflow-far" isExecutable="true">
    <bpmn:startEvent id="Event_JobReceived" name="Job received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Job" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_Compute" name="Compute">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_SendResult" name="Send result">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_WorkerDone" name="Worker done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_SendResult" targetRef="Event_WorkerDone" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Compute" targetRef="Activity_SendResult" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_JobReceived" targetRef="Activity_Compute" />
  </bpmn:process>
  <bpmn:process id="Process_Client" isExecutable="false">
    <bpmn:startEvent id="Event_ClientStart" name="Client start">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_S1" name="Step 1">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_S2" name="Step 2">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_SendJob" name="Send job">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Activity_S4" name="Step 4">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_S5" name="Step 5">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_S6" name="Step 6">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Activity_WaitResult" name="Wait result">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_ClientDone" name="Client done">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_WaitResult" targetRef="Event_ClientDone" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_S6" targetRef="Activity_WaitResult" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_S5" targetRef="Activity_S6" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_S4" targetRef="Activity_S5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_SendJob" targetRef="Activity_S4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_S2" targetRef="Activity_SendJob" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_S1" targetRef="Activity_S2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_ClientStart" targetRef="Activity_S1" />
  </bpmn:process>

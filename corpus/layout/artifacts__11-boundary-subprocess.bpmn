<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_BSub" name="Boundary on subprocess" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_Sub" name="Handle order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:startEvent id="Event_SubStart">
        <bpmn:outgoing>Flow_2</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_Pick" name="Pick items">
        <bpmn:incoming>Flow_2</bpmn:incoming>
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_Pack" name="Pack items">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:incoming>Flow_12</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="Event_Damaged" name="Item damaged" attachedToRef="Activity_Pack">
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="Error_Damaged" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="Activity_Replace" name="Replace item">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:outgoing>Flow_12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_Replace" targetRef="Activity_Pack" />
      <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_Damaged" targetRef="Activity_Replace" />
      <bpmn:serviceTask id="Activity_Ship" name="Ship">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_SubEnd">
        <bpmn:incoming>Flow_5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Ship" targetRef="Event_SubEnd" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Pack" targetRef="Activity_Ship" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Pick" targetRef="Activity_Pack" />
      <bpmn:sequenceFlow id="Flow_2" sourceRef="Event_SubStart" targetRef="Activity_Pick" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_TooLong" name="Order takes too long" attachedToRef="Activity_Sub">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_OutOfStock" name="Out of stock" attachedToRef="Activity_Sub">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_OutOfStock" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_Cancelled" name="Order cancelled">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_OutOfStock" targetRef="Event_Cancelled" />
    <bpmn:sendTask id="Activity_Apologise" name="Apologise to customer">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Apologise" targetRef="Activity_Close" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_TooLong" targetRef="Activity_Apologise" />
    <bpmn:userTask id="Activity_Close" name="Close order">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_End" name="Closed">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Close" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Sub" targetRef="Activity_Close" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Sub" />
  </bpmn:process>
  <bpmn:error id="Error_OutOfStock" name="OutOfStock" />
  <bpmn:error id="Error_Damaged" name="Damaged" />

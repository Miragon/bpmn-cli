    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Publish" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gateway_Approved" targetRef="Activity_Publish" />
    <bpmn:sequenceFlow id="Flow_6" name="no, rework" sourceRef="Gateway_Approved" targetRef="Activity_WriteDraft" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_ReviewDraft" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_WriteDraft" targetRef="Activity_ReviewDraft" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_WriteDraft" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud">
  <bpmn:process id="Process_IncidentManagement" name="Incident management" isExecutable="true">
    <bpmn:startEvent id="Event_IncidentReported" name="Incident reported">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_IncidentReported" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_TriageIncident" name="Triage incident">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="Gateway_Severity" name="Severity?" default="Flow_4">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sendTask id="Activity_PageOnCallEngineer" name="Page on-call engineer">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="Event_NoAnswerIn15Min" name="No answer in 15 min" attachedToRef="Activity_PageOnCallEngineer">
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_PageBackupEngineer" name="Page backup engineer">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Activity_PageBackupEngineer" targetRef="Activity_Investigate" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Event_NoAnswerIn15Min" targetRef="Activity_PageBackupEngineer" />
    <bpmn:userTask id="Activity_Investigate" name="Investigate">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_4hWithoutUpdate" name="4h without update" cancelActivity="false" attachedToRef="Activity_Investigate">
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_NotifyStakeholders" name="Notify stakeholders">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_StakeholdersNotified" name="Stakeholders notified">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Activity_NotifyStakeholders" targetRef="Event_StakeholdersNotified" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Event_4hWithoutUpdate" targetRef="Activity_NotifyStakeholders" />
    <bpmn:exclusiveGateway id="Gateway_RootCauseFound" name="Root cause found?" default="Flow_8">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_ApplyFix" name="Apply fix">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_VerifyFix" name="Verify fix">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Resolved" name="Resolved?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_CloseIncident" name="Close incident">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_IncidentClosed" name="Incident closed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_CloseIncident" targetRef="Event_IncidentClosed" />
    <bpmn:sequenceFlow id="Flow_23" name="reopened" sourceRef="Activity_CloseIncident" targetRef="Activity_TriageIncident" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Merge" targetRef="Activity_SendPostMortem" />
    <bpmn:sendTask id="Activity_SendPostMortem" name="Send post-mortem">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Activity_SendPostMortem" targetRef="Activity_CloseIncident" />
    <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gateway_Resolved" targetRef="Gateway_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resolved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="no, dig deeper" sourceRef="Gateway_Resolved" targetRef="Activity_Investigate" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_VerifyFix" targetRef="Gateway_Resolved" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_ApplyFix" targetRef="Activity_VerifyFix" />
    <bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gateway_RootCauseFound" targetRef="Activity_ApplyFix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${found}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_EscalateToL3" name="Escalate to L3">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_9" name="retry" sourceRef="Activity_EscalateToL3" targetRef="Activity_Investigate" />
    <bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gateway_RootCauseFound" targetRef="Activity_EscalateToL3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Investigate" targetRef="Gateway_RootCauseFound" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_PageOnCallEngineer" targetRef="Activity_CollectLogs" />
    <bpmn:serviceTask id="Activity_CollectLogs" name="Collect logs">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Activity_CollectLogs" targetRef="Activity_Investigate" />
    <bpmn:sequenceFlow id="Flow_3" name="critical" sourceRef="Gateway_Severity" targetRef="Activity_PageOnCallEngineer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${severity == "critical"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="minor" sourceRef="Gateway_Severity" targetRef="Activity_CreateTicket" />
    <bpmn:subProcess id="Activity_CreateTicket" name="Create ticket">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:startEvent id="Event_1">
        <bpmn:outgoing>Flow_26</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_FillTicketForm" name="Fill ticket form">
        <bpmn:incoming>Flow_26</bpmn:incoming>
        <bpmn:outgoing>Flow_27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Activity_AssignToTeam" name="Assign to team">
        <bpmn:incoming>Flow_27</bpmn:incoming>
        <bpmn:outgoing>Flow_28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_2">
        <bpmn:incoming>Flow_28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_28" sourceRef="Activity_AssignToTeam" targetRef="Event_2" />
      <bpmn:sequenceFlow id="Flow_27" sourceRef="Activity_FillTicketForm" targetRef="Activity_AssignToTeam" />
      <bpmn:sequenceFlow id="Flow_26" sourceRef="Event_1" targetRef="Activity_FillTicketForm" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Activity_CreateTicket" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_TriageIncident" targetRef="Gateway_Severity" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_IncidentReported" targetRef="Activity_TriageIncident" />
  </bpmn:process>
  <bpmn:message id="Message_IncidentReported" name="IncidentReported" />

    <bpmn:sequenceFlow id="Flow_21" name="no" sourceRef="Gateway_Another" targetRef="Activity_PayOut" />
    <bpmn:sequenceFlow id="Flow_23" name="yes" sourceRef="Gateway_Another" targetRef="Activity_Claim" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Activity_Claim" targetRef="Gateway_Another" />

  <bpmn:process id="Process_S20" name="s20" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_Prepare" name="Prepare">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Activity_Claim" name="Handle claim">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:startEvent id="Event_ClaimStart" name="Claim start">
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Activity_AssessDamage" name="Assess damage">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:incoming>Flow_17</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_AssessDamage" targetRef="Gateway_Sev" />
      <bpmn:exclusiveGateway id="Gateway_Sev" name="Severity?">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Activity_QuickSettle" name="Quick settle">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_QuickSettle" targetRef="Gateway_Sev_join" />
      <bpmn:sequenceFlow id="Flow_5" name="minor" sourceRef="Gateway_Sev" targetRef="Activity_QuickSettle" />
      <bpmn:subProcess id="Activity_Expert" name="Expert review">
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
        <bpmn:startEvent id="Event_ExpertStart" name="Expert start">
          <bpmn:outgoing>Flow_10</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Activity_Inspect" name="Inspect">
          <bpmn:incoming>Flow_10</bpmn:incoming>
          <bpmn:incoming>Flow_14</bpmn:incoming>
          <bpmn:outgoing>Flow_11</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Activity_WriteReport" name="Write report">
          <bpmn:incoming>Flow_11</bpmn:incoming>
          <bpmn:outgoing>Flow_12</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_ReportOk" name="Report ok?">
          <bpmn:incoming>Flow_12</bpmn:incoming>
          <bpmn:outgoing>Flow_13</bpmn:outgoing>
          <bpmn:outgoing>Flow_14</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="Event_ExpertEnd" name="Expert end">
          <bpmn:incoming>Flow_13</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gateway_ReportOk" targetRef="Event_ExpertEnd" />
        <bpmn:sequenceFlow id="Flow_14" name="no" sourceRef="Gateway_ReportOk" targetRef="Activity_Inspect" />
        <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_WriteReport" targetRef="Gateway_ReportOk" />
        <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_Inspect" targetRef="Activity_WriteReport" />
        <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_ExpertStart" targetRef="Activity_Inspect" />
      </bpmn:subProcess>
      <bpmn:task id="Activity_Negotiate" name="Negotiate">
        <bpmn:incoming>Flow_7</bpmn:incoming>
        <bpmn:outgoing>Flow_9</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Negotiate" targetRef="Gateway_Sev_join" />
      <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Expert" targetRef="Activity_Negotiate" />
      <bpmn:sequenceFlow id="Flow_6" name="major" sourceRef="Gateway_Sev" targetRef="Activity_Expert" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_ClaimStart" targetRef="Activity_AssessDamage" />
      <bpmn:exclusiveGateway id="Gateway_Sev_join">
        <bpmn:incoming>Flow_8</bpmn:incoming>
        <bpmn:incoming>Flow_9</bpmn:incoming>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_Agrees" name="Customer agrees?">
        <bpmn:incoming>Flow_15</bpmn:incoming>
        <bpmn:outgoing>Flow_16</bpmn:outgoing>
        <bpmn:outgoing>Flow_17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_ClaimEnd" name="Claim end">
        <bpmn:incoming>Flow_16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_16" name="yes" sourceRef="Gateway_Agrees" targetRef="Event_ClaimEnd" />
      <bpmn:sequenceFlow id="Flow_17" name="no, reassess" sourceRef="Gateway_Agrees" targetRef="Activity_AssessDamage" />
      <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Sev_join" targetRef="Gateway_Agrees" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_Another" name="Another claim?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>

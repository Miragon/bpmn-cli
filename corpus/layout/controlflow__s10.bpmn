  <bpmn:process id="Process_S10" name="s10" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_CollectData" name="Collect data">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Analyse" name="Analyse">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Report" name="Report">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Sufficient" name="Sufficient?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_End" name="End">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gateway_Sufficient" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_6" name="no, collect more" sourceRef="Gateway_Sufficient" targetRef="Activity_CollectData" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Report" targetRef="Gateway_Sufficient" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Analyse" targetRef="Activity_Report" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_CollectData" targetRef="Activity_Analyse" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_CollectData" />
  </bpmn:process>

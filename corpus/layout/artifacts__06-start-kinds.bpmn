<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Starts" name="Start kinds" isExecutable="true">
    <bpmn:startEvent id="Event_StartMsg" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Order" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_StartMsg" targetRef="Gateway_Merge" />
    <bpmn:startEvent id="Event_StartTimer" name="Every night">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Event_StartTimer" targetRef="Gateway_Merge" />
    <bpmn:startEvent id="Event_StartSignal" name="Stock changed">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_StockChanged" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_StartSignal" targetRef="Gateway_Merge" />
    <bpmn:startEvent id="Event_StartCond" name="Threshold reached">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${stock &lt; 10}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_StartCond" targetRef="Gateway_Merge" />
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_Replenish" name="Replenish stock">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_End" name="Replenished">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Replenish" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Merge" targetRef="Activity_Replenish" />
  </bpmn:process>
  <bpmn:message id="Message_Order" name="Order" />
  <bpmn:signal id="Signal_StockChanged" name="StockChanged" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Starts">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Starts" bpmnElement="Process_Starts">
      <bpmndi:BPMNShape id="BPMNShape_Event_StartMsg" bpmnElement="Event_StartMsg">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="53" y="144" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_StartTimer" bpmnElement="Event_StartTimer">
        <dc:Bounds x="80" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="58" y="262" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_StartSignal" bpmnElement="Event_StartSignal">
        <dc:Bounds x="80" y="316" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="53" y="358" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_StartCond" bpmnElement="Event_StartCond">
        <dc:Bounds x="80" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="53" y="454" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_Merge" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="176" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Replenish" bpmnElement="Activity_Replenish">
        <dc:Bounds x="286" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_End" bpmnElement="Event_End">
        <dc:Bounds x="446" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="424" y="144" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="176" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="116" y="238" />
        <di:waypoint x="201" y="238" />
        <di:waypoint x="201" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="116" y="334" />
        <di:waypoint x="201" y="334" />
        <di:waypoint x="201" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="116" y="430" />
        <di:waypoint x="201" y="430" />
        <di:waypoint x="201" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="386" y="120" />
        <di:waypoint x="446" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="226" y="120" />
        <di:waypoint x="286" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

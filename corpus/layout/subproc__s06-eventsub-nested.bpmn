<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Main" name="s06-eventsub-nested" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_Payment" name="Payment">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="Event_PStart" name="Pay start">
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_Charge" name="Charge">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_Paid" name="Paid">
        <bpmn:incoming>Flow_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Charge" targetRef="Event_Paid" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_PStart" targetRef="Activity_Charge" />
      <bpmn:subProcess id="Activity_ChargeError" name="Handle charge error" triggeredByEvent="true">
        <bpmn:startEvent id="Event_1">
          <bpmn:outgoing>Flow_5</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="Error_ChargeFailed" />
        </bpmn:startEvent>
        <bpmn:userTask id="Activity_Refund" name="Refund">
          <bpmn:incoming>Flow_5</bpmn:incoming>
          <bpmn:outgoing>Flow_6</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="Event_Refunded" name="Refunded">
          <bpmn:incoming>Flow_6</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Refund" targetRef="Event_Refunded" />
        <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_1" targetRef="Activity_Refund" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Payment" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Payment" />
    <bpmn:subProcess id="Activity_Timeout" name="Global timeout" triggeredByEvent="true">
      <bpmn:startEvent id="Event_2">
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_Cancel" name="Cancel">
        <bpmn:incoming>Flow_7</bpmn:incoming>
        <bpmn:outgoing>Flow_8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_Cancelled" name="Cancelled">
        <bpmn:incoming>Flow_8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_Cancel" targetRef="Event_Cancelled" />
      <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_2" targetRef="Activity_Cancel" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:error id="Error_ChargeFailed" name="ChargeFailed" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Main" bpmnElement="Process_Main">

  <bpmndi:BPMNDiagram id="BPMNDiagram_Activity_AssessClaim">
    <bpmndi:BPMNPlane id="BPMNPlane_Activity_AssessClaim" bpmnElement="Activity_AssessClaim">
      <bpmndi:BPMNShape id="BPMNShape_Event_AssessmentStarted" bpmnElement="Event_AssessmentStarted">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="53" y="144" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_CheckCoverage" bpmnElement="Activity_CheckCoverage">

      <bpmndi:BPMNShape id="BPMNShape_Gateway_Score_join" bpmnElement="Gateway_Score_join" isMarkerVisible="true">
        <dc:Bounds x="766" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_End" bpmnElement="Event_End">
        <dc:Bounds x="876" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="882" y="144" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="276" y="120" />
        <di:waypoint x="336" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="546" y="120" />
        <di:waypoint x="766" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="386" y="120" />
        <di:waypoint x="446" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="102" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="706" y="260" />
        <di:waypoint x="791" y="260" />
        <di:waypoint x="791" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="656" y="300" />
        <di:waypoint x="656" y="330" />
        <di:waypoint x="361" y="330" />
        <di:waypoint x="361" y="145" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="588" y="312" width="60" height="14" />

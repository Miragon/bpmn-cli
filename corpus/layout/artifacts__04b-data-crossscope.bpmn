<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_DataSub" name="Data in subprocess" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Collect" name="Collect data">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_2">
        <bpmn:targetRef>DataObjectReference_App</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:subProcess id="Activity_Sub" name="Process application">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:startEvent id="Event_SubStart">
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_Score" name="Score applicant">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
        <bpmn:property id="Property_2" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="DataInputAssociation_2">
          <bpmn:sourceRef>DataStoreReference_Db</bpmn:sourceRef>
          <bpmn:targetRef>Property_2</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="DataInputAssociation_4">
          <bpmn:sourceRef>DataObjectReference_App</bpmn:sourceRef>
          <bpmn:targetRef>Property_2</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
          <bpmn:targetRef>DataObjectReference_Score</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:userTask id="Activity_Review" name="Review score">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
        <bpmn:property id="Property_1" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="DataInputAssociation_1">
          <bpmn:sourceRef>DataObjectReference_Score</bpmn:sourceRef>
          <bpmn:targetRef>Property_1</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_SubEnd">
        <bpmn:incoming>Flow_5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Review" targetRef="Event_SubEnd" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Score" targetRef="Activity_Review" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_SubStart" targetRef="Activity_Score" />
      <bpmn:dataObject id="DataObject_ScoreSheet" />
      <bpmn:dataObjectReference id="DataObjectReference_Score" name="Score sheet" dataObjectRef="DataObject_ScoreSheet" />
      <bpmn:dataStoreReference id="DataStoreReference_Db" name="Applicant DB" dataStoreRef="DataStore_ApplicantDB" />
      <bpmn:textAnnotation id="TextAnnotation_Score">
        <bpmn:text>Uses the internal scoring model v3</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_1" sourceRef="TextAnnotation_Score" targetRef="Activity_Score" />
    </bpmn:subProcess>
    <bpmn:userTask id="Activity_Inform" name="Inform applicant">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_3">
        <bpmn:sourceRef>DataObjectReference_App</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_End" name="Done">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Inform" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Sub" targetRef="Activity_Inform" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Collect" targetRef="Activity_Sub" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Collect" />
    <bpmn:dataObject id="DataObject_Application" />
    <bpmn:dataObjectReference id="DataObjectReference_App" name="Application" dataObjectRef="DataObject_Application" />
  </bpmn:process>
  <bpmn:dataStore id="DataStore_ApplicantDB" name="Applicant DB" />

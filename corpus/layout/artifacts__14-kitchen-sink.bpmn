<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_KS" name="Kitchen sink" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Order placed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_OrderPlaced" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Validate" name="Validate order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_2">
        <bpmn:targetRef>DataObjectReference_Order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Valid?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Activity_Fulfil" name="Fulfil order">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:startEvent id="Event_FStart">
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_Reserve" name="Reserve stock">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
          <bpmn:targetRef>DataObjectReference_Pick</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:multiInstanceLoopCharacteristics />
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="Gateway_Fork">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:callActivity id="Activity_Charge" name="Charge payment" calledElement="Process_Payment">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:boundaryEvent id="Event_CompCharge" attachedToRef="Activity_Charge">
        <bpmn:compensateEventDefinition />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Event_PayErr" name="Payment declined" attachedToRef="Activity_Charge">
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="Error_Declined" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="Event_FErr" name="Fulfilment failed">
        <bpmn:incoming>Flow_11</bpmn:incoming>
        <bpmn:errorEventDefinition errorRef="Error_FulfilFailed" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_PayErr" targetRef="Event_FErr" />
      <bpmn:parallelGateway id="Gateway_Join">
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:incoming>Flow_8</bpmn:incoming>
        <bpmn:outgoing>Flow_9</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:intermediateThrowEvent id="Event_Tracking" name="Send tracking">
        <bpmn:incoming>Flow_9</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_Tracking" />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="Event_FEnd">
        <bpmn:incoming>Flow_10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_Tracking" targetRef="Event_FEnd" />
      <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Join" targetRef="Event_Tracking" />
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Charge" targetRef="Gateway_Join" />
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Fork" targetRef="Activity_Charge" />
      <bpmn:userTask id="Activity_Pack" name="Pack parcel">
        <bpmn:incoming>Flow_7</bpmn:incoming>
        <bpmn:outgoing>Flow_8</bpmn:outgoing>
        <bpmn:property id="Property_1" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="DataInputAssociation_1">
          <bpmn:sourceRef>DataObjectReference_Pick</bpmn:sourceRef>
          <bpmn:targetRef>Property_1</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_Pack" targetRef="Gateway_Join" />
      <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Fork" targetRef="Activity_Pack" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Reserve" targetRef="Gateway_Fork" />
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_FStart" targetRef="Activity_Reserve" />
      <bpmn:serviceTask id="Activity_Refund" name="Refund payment" isForCompensation="true" />
      <bpmn:dataObject id="DataObject_PickList" />
      <bpmn:dataObjectReference id="DataObjectReference_Pick" name="Pick list" dataObjectRef="DataObject_PickList" />
      <bpmn:association id="Association_1" associationDirection="One" sourceRef="Event_CompCharge" targetRef="Activity_Refund" />
      <bpmn:textAnnotation id="TextAnnotation_Pack">
        <bpmn:text>Fragile items get extra padding</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_2" sourceRef="TextAnnotation_Pack" targetRef="Activity_Pack" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_FulfilErr" name="Fulfilment failed" attachedToRef="Activity_Fulfil">
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_FulfilFailed" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_SLA" name="SLA breached" cancelActivity="false" attachedToRef="Activity_Fulfil">
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_Delay" name="Inform customer about delay">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Informed" name="Customer informed">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Activity_Delay" targetRef="Event_Informed" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_SLA" targetRef="Activity_Delay" />
    <bpmn:userTask id="Activity_HandleFail" name="Handle failure">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_HandleFail" targetRef="Activity_Close" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Event_FulfilErr" targetRef="Activity_HandleFail" />
    <bpmn:userTask id="Activity_Close" name="Close order">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_2">
        <bpmn:sourceRef>DataObjectReference_Order</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_3">
        <bpmn:targetRef>DataStoreReference_OrderDb</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_End" name="Order done">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_Close" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_Fulfil" targetRef="Activity_Close" />
    <bpmn:sequenceFlow id="Flow_Valid" name="yes" sourceRef="Gateway_Valid" targetRef="Activity_Fulfil" />
    <bpmn:sendTask id="Activity_Reject" name="Reject order">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Rejected" name="Order rejected">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_Reject" targetRef="Event_Rejected" />
    <bpmn:sequenceFlow id="Flow_Invalid" name="no" sourceRef="Gateway_Valid" targetRef="Activity_Reject" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Validate" />
    <bpmn:subProcess id="Activity_CancelSub" name="Cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="Event_CancellationStart" name="Order cancelled">
        <bpmn:outgoing>Flow_19</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_CancelOrder" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="Event_UndoAll" name="Undo bookings">
        <bpmn:incoming>Flow_19</bpmn:incoming>
        <bpmn:outgoing>Flow_20</bpmn:outgoing>
        <bpmn:compensateEventDefinition />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="Event_CancelEnd" name="Cancelled">
        <bpmn:incoming>Flow_20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_20" sourceRef="Event_UndoAll" targetRef="Event_CancelEnd" />
      <bpmn:sequenceFlow id="Flow_19" sourceRef="Event_CancellationStart" targetRef="Event_UndoAll" />
    </bpmn:subProcess>
    <bpmn:dataObject id="DataObject_Order" />
    <bpmn:dataObjectReference id="DataObjectReference_Order" name="Order" dataObjectRef="DataObject_Order" />
    <bpmn:dataStoreReference id="DataStoreReference_OrderDb" name="Order DB" dataStoreRef="DataStore_OrderDB" />
    <bpmn:textAnnotation id="TextAnnotation_Valid">
      <bpmn:text>Checks address, stock and blacklist</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_3" sourceRef="TextAnnotation_Valid" targetRef="Activity_Validate" />
    <bpmn:textAnnotation id="TextAnnotation_Fulfil">
      <bpmn:text>Runs in the warehouse system</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_4" sourceRef="TextAnnotation_Fulfil" targetRef="Activity_Fulfil" />
  </bpmn:process>
  <bpmn:message id="Message_OrderPlaced" name="OrderPlaced" />
  <bpmn:message id="Message_Tracking" name="Tracking" />
  <bpmn:error id="Error_Declined" name="Declined" />
  <bpmn:error id="Error_FulfilFailed" name="FulfilFailed" />
  <bpmn:message id="Message_CancelOrder" name="CancelOrder" />
  <bpmn:dataStore id="DataStore_OrderDB" name="Order DB" />

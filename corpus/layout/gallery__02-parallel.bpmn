      <bpmndi:BPMNShape id="BPMNShape_Gateway_1_join" bpmnElement="Gateway_1_join">
        <dc:Bounds x="766" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Done" bpmnElement="Event_Done">
        <dc:Bounds x="876" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="878" y="144" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="276" y="120" />
        <di:waypoint x="336" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="546" y="120" />
        <di:waypoint x="766" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="386" y="120" />
        <di:waypoint x="446" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="706" y="260" />
        <di:waypoint x="791" y="260" />
        <di:waypoint x="791" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="546" y="260" />
        <di:waypoint x="606" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="361" y="145" />
        <di:waypoint x="361" y="260" />

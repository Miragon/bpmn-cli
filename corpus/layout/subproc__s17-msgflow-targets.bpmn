<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Seller" name="Seller" processRef="Process_Main" />
    <bpmn:participant id="Participant_Partner" name="Partner" processRef="Process_Partner" />
    <bpmn:participant id="Participant_Registry" name="Registry" />
    <bpmn:messageFlow id="Flow_12" name="Proposal" sourceRef="Activity_SendProposal" targetRef="Activity_ReadProposal" />
    <bpmn:messageFlow id="Flow_13" name="Answer" sourceRef="Activity_Answer" targetRef="Activity_ReceiveAnswer" />
    <bpmn:messageFlow id="Flow_14" name="Cancel" sourceRef="Activity_CancelDeal" targetRef="Event_CancelMsg" />
    <bpmn:messageFlow id="Flow_15" name="Registration" sourceRef="Participant_Partner" targetRef="Participant_Registry" />
    <bpmn:messageFlow id="Flow_16" name="Deal record" sourceRef="Activity_Close" targetRef="Participant_Registry" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="s17-msgflow-targets" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_Negotiate" name="Negotiate">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="Event_NStart" name="N start">
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="Activity_SendProposal" name="Send proposal">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:receiveTask id="Activity_ReceiveAnswer" name="Receive answer">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:endEvent id="Event_NDone" name="N done">
        <bpmn:incoming>Flow_6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_ReceiveAnswer" targetRef="Event_NDone" />
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_SendProposal" targetRef="Activity_ReceiveAnswer" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_NStart" targetRef="Activity_SendProposal" />
    </bpmn:subProcess>
    <bpmn:userTask id="Activity_Close" name="Close deal">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_CancelMsg" name="Cancelled by partner" attachedToRef="Activity_Close">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CancelDeal" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_Cancelled" name="Cancelled">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_CancelMsg" targetRef="Event_Cancelled" />
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Close" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Negotiate" targetRef="Activity_Close" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Negotiate" />
  </bpmn:process>
  <bpmn:process id="Process_Partner" isExecutable="false">
    <bpmn:startEvent id="Event_PStart" name="P start">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Activity_ReadProposal" name="Read proposal">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Activity_Answer" name="Answer">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Activity_CancelDeal" name="Cancel deal">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_PDone" name="P done">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_CancelDeal" targetRef="Event_PDone" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_Answer" targetRef="Activity_CancelDeal" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_ReadProposal" targetRef="Activity_Answer" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_PStart" targetRef="Activity_ReadProposal" />
  </bpmn:process>
  <bpmn:message id="Message_CancelDeal" name="CancelDeal" />

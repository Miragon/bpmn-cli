  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Main" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="s09-lanes-zigzag" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Clerk" name="Clerk">
        <bpmn:flowNodeRef>Event_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Revise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>Activity_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Escalated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Activity_Book</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Request" name="Request">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Enter" name="Enter request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Review" name="Review">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_Book" name="Book">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_Notify" name="Notify">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Notify" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Book" targetRef="Activity_Notify" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gateway_Approved" targetRef="Activity_Book" />
    <bpmn:userTask id="Activity_Revise" name="Revise">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_8" name="resubmit" sourceRef="Activity_Revise" targetRef="Activity_Review" />
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gateway_Approved" targetRef="Activity_Revise" />
    <bpmn:userTask id="Activity_Escalate" name="Escalate">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_Escalated" name="Escalated">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_Escalate" targetRef="Event_Escalated" />
    <bpmn:sequenceFlow id="Flow_9" name="escalate" sourceRef="Gateway_Approved" targetRef="Activity_Escalate" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Review" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Enter" targetRef="Activity_Review" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Request" targetRef="Activity_Enter" />
  </bpmn:process>

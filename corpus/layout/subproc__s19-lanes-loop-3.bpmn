<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Insurer" name="Insurer" processRef="Process_Main" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="s19-lanes-loop-3" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Intake" name="Intake">
        <bpmn:flowNodeRef>Event_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RequestDocs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Assess" name="Assessment">
        <bpmn:flowNodeRef>Activity_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Decision" name="Decision">
        <bpmn:flowNodeRef>Activity_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Claim" name="Claim">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Register" name="Register claim">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Assess" name="Assess damage">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Decide" name="Decide">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="Outcome?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_Pay" name="Pay out">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Paid" name="Paid">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Pay" targetRef="Event_Paid" />
    <bpmn:sequenceFlow id="Flow_5" name="approve" sourceRef="Gateway_Outcome" targetRef="Activity_Pay" />
    <bpmn:userTask id="Activity_RequestDocs" name="Request documents">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_8" name="documents received" sourceRef="Activity_RequestDocs" targetRef="Activity_Register" />
    <bpmn:sequenceFlow id="Flow_7" name="more info" sourceRef="Gateway_Outcome" targetRef="Activity_RequestDocs" />
    <bpmn:sendTask id="Activity_Reject" name="Reject">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Rejected" name="Rejected">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_Reject" targetRef="Event_Rejected" />
    <bpmn:sequenceFlow id="Flow_9" name="reject" sourceRef="Gateway_Outcome" targetRef="Activity_Reject" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Decide" targetRef="Gateway_Outcome" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Assess" targetRef="Activity_Decide" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Register" targetRef="Activity_Assess" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Claim" targetRef="Activity_Register" />
  </bpmn:process>

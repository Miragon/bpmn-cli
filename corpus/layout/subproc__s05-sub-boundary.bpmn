  <bpmn:process id="Process_Main" name="s05-sub-boundary" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_Order" name="Process order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="Event_OStart" name="Order start">
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_Validate" name="Validate">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Activity_Book" name="Book">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_ODone" name="Order done">
        <bpmn:incoming>Flow_6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Book" targetRef="Event_ODone" />
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Validate" targetRef="Activity_Book" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_OStart" targetRef="Activity_Validate" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_Reminder" name="Reminder" cancelActivity="false" attachedToRef="Activity_Order">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_Failed" name="Failed" attachedToRef="Activity_Order">
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_OrderFailed" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Activity_HandleFailure" name="Handle failure">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_FailedEnd" name="Failed end">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_HandleFailure" targetRef="Event_FailedEnd" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Event_Failed" targetRef="Activity_HandleFailure" />
    <bpmn:sendTask id="Activity_SendReminder" name="Send reminder">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Reminded" name="Reminded">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_SendReminder" targetRef="Event_Reminded" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_Reminder" targetRef="Activity_SendReminder" />
    <bpmn:serviceTask id="Activity_Ship" name="Ship">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Ship" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Order" targetRef="Activity_Ship" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Order" />
  </bpmn:process>

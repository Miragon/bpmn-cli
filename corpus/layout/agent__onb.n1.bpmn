<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Platform">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_HR" name="HR" processRef="Process_EmployeeOnboarding" />
    <bpmn:participant id="Participant_HiringManager" name="Hiring manager" processRef="Process_HiringManager" />
    <bpmn:messageFlow id="Flow_19" sourceRef="Activity_CreateEmployeeRecord" targetRef="Event_OnboardingPlanRequested" messageRef="Message_PlanRequest" />
    <bpmn:messageFlow id="Flow_20" sourceRef="Activity_GiveFeedback" targetRef="Activity_ReceiveFeedback" messageRef="Message_Feedback" />
    <bpmn:messageFlow id="Flow_21" sourceRef="Activity_AssignBuddy" targetRef="Activity_ConductOrientation" messageRef="Message_BuddyInfo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_EmployeeOnboarding" name="Employee onboarding" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_HRAdmin" name="HR admin" />
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>Activity_CreateAccounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SetUpWorkplace</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_ContractSigned" name="Contract signed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_CreateEmployeeRecord" name="Create employee record">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_RequestEquipment" name="Request equipment">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Gateway_1">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Activity_SetUpWorkplace" name="Set up workplace">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_2">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Activity_SendWelcomeMail" name="Send welcome mail">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_FirstWorkingDay" name="First working day">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2026-10-01T09:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Activity_ConductOrientation" name="Conduct orientation">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Activity_ReceiveFeedback" name="Receive feedback">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_OnboardingDone" name="Onboarding done">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_ReceiveFeedback" targetRef="Event_OnboardingDone" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_ConductOrientation" targetRef="Activity_ReceiveFeedback" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_FirstWorkingDay" targetRef="Activity_ConductOrientation" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_SendWelcomeMail" targetRef="Event_FirstWorkingDay" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_2" targetRef="Activity_SendWelcomeMail" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_SetUpWorkplace" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_1" targetRef="Activity_SetUpWorkplace" />
    <bpmn:serviceTask id="Activity_CreateAccounts" name="Create accounts">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_CreateAccounts" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_1" targetRef="Activity_CreateAccounts" />
    <bpmn:userTask id="Activity_PrepareWelcomePackage" name="Prepare welcome package">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_PrepareWelcomePackage" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_1" targetRef="Activity_PrepareWelcomePackage" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_RequestEquipment" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_CreateEmployeeRecord" targetRef="Activity_RequestEquipment" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_ContractSigned" targetRef="Activity_CreateEmployeeRecord" />
  </bpmn:process>
  <bpmn:process id="Process_HiringManager" isExecutable="false">
    <bpmn:startEvent id="Event_OnboardingPlanRequested" name="Onboarding plan requested">
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PlanRequest" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_DefineOnboardingPlan" name="Define onboarding plan">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_AssignBuddy" name="Assign buddy">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_GiveFeedback" name="Give feedback">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Activity_GiveFeedback" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_AssignBuddy" targetRef="Activity_GiveFeedback" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_DefineOnboardingPlan" targetRef="Activity_AssignBuddy" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Event_OnboardingPlanRequested" targetRef="Activity_DefineOnboardingPlan" />
  </bpmn:process>
  <bpmn:message id="Message_PlanRequest" name="PlanRequest" />
  <bpmn:message id="Message_Feedback" name="Feedback" />
  <bpmn:message id="Message_BuddyInfo" name="BuddyInfo" />

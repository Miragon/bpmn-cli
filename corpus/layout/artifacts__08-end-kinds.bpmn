<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Ends" name="End kinds" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_Pay" name="Process payment">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Result" name="Result?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_Paid" name="Paid">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" name="ok" sourceRef="Gateway_Result" targetRef="Event_Paid" />
    <bpmn:endEvent id="Event_Term" name="Abort everything">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" name="fraud" sourceRef="Gateway_Result" targetRef="Event_Term" />
    <bpmn:endEvent id="Event_Err" name="Payment failed">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_PaymentFailed" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" name="declined" sourceRef="Gateway_Result" targetRef="Event_Err" />
    <bpmn:endEvent id="Event_Esc" name="Needs approval">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:escalationEventDefinition escalationRef="Escalation_Approval" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" name="large" sourceRef="Gateway_Result" targetRef="Event_Esc" />
    <bpmn:endEvent id="Event_Msg" name="Inform customer">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_Info" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" name="pending" sourceRef="Gateway_Result" targetRef="Event_Msg" />
    <bpmn:endEvent id="Event_Sig" name="Broadcast">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:signalEventDefinition signalRef="Signal_PaymentDone" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_8" name="partner" sourceRef="Gateway_Result" targetRef="Event_Sig" />
    <bpmn:endEvent id="Event_Comp" name="Undo">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:compensateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_9" name="rollback" sourceRef="Gateway_Result" targetRef="Event_Comp" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Pay" targetRef="Gateway_Result" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Pay" />
  </bpmn:process>
  <bpmn:error id="Error_PaymentFailed" name="PaymentFailed" errorCode="PAY-1" />
  <bpmn:escalation id="Escalation_Approval" name="Approval" />
  <bpmn:message id="Message_Info" name="Info" />
  <bpmn:signal id="Signal_PaymentDone" name="PaymentDone" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Ends">

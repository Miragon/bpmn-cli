<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_MI" name="Multi instance and calls" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Approvals" name="Collect approvals">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:targetRef>DataObjectReference_Appr</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">${approvers.size()}</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:callActivity id="Activity_CallCredit" name="Check credit" calledElement="Process_Credit">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1">
        <bpmn:sourceRef>DataObjectReference_Appr</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Activity_Notify" name="Notify each supplier">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:serviceTask>
    <bpmn:callActivity id="Activity_CallShip" name="Ship per item" calledElement="Process_Ship">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:callActivity>
    <bpmn:subProcess id="Activity_SubMI" name="Per order line">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
      <bpmn:startEvent id="Event_SubStart">
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Activity_Reserve" name="Reserve line">
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
        <bpmn:standardLoopCharacteristics />
      </bpmn:task>
      <bpmn:endEvent id="Event_SubEnd">
        <bpmn:incoming>Flow_7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Reserve" targetRef="Event_SubEnd" />
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_SubStart" targetRef="Activity_Reserve" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Event_End" name="Done">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_SubMI" targetRef="Event_End" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_CallShip" targetRef="Activity_SubMI" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Notify" targetRef="Activity_CallShip" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_CallCredit" targetRef="Activity_Notify" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Approvals" targetRef="Activity_CallCredit" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Approvals" />
    <bpmn:dataObject id="DataObject_Approvals" />
    <bpmn:dataObjectReference id="DataObjectReference_Appr" name="Approvals" dataObjectRef="DataObject_Approvals" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_MI">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_MI" bpmnElement="Process_MI">
      <bpmndi:BPMNShape id="BPMNShape_Event_Start" bpmnElement="Event_Start">
        <dc:Bounds x="80" y="140" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="79" y="182" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Approvals" bpmnElement="Activity_Approvals">
        <dc:Bounds x="176" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_CallCredit" bpmnElement="Activity_CallCredit">
        <dc:Bounds x="336" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Notify" bpmnElement="Activity_Notify">
        <dc:Bounds x="496" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_CallShip" bpmnElement="Activity_CallShip">
        <dc:Bounds x="656" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_SubMI" bpmnElement="Activity_SubMI" isExpanded="true">
        <dc:Bounds x="816" y="80" width="352" height="155" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_SubStart" bpmnElement="Event_SubStart">
        <dc:Bounds x="846" y="147" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Reserve" bpmnElement="Activity_Reserve">
        <dc:Bounds x="942" y="125" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_SubEnd" bpmnElement="Event_SubEnd">
        <dc:Bounds x="1102" y="147" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1042" y="165" />
        <di:waypoint x="1102" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="882" y="165" />
        <di:waypoint x="942" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_Event_End" bpmnElement="Event_End">
        <dc:Bounds x="1228" y="140" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1230" y="182" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1168" y="158" />
        <di:waypoint x="1228" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="756" y="158" />
        <di:waypoint x="816" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="596" y="158" />
        <di:waypoint x="656" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="436" y="158" />
        <di:waypoint x="496" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="276" y="158" />
        <di:waypoint x="336" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="116" y="158" />
        <di:waypoint x="176" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_DataObjectReference_Appr" bpmnElement="DataObjectReference_Appr">
        <dc:Bounds x="208" y="295" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="193" y="351" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_DataOutputAssociation_1" bpmnElement="DataOutputAssociation_1">
        <di:waypoint x="226" y="198" />
        <di:waypoint x="226" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_DataInputAssociation_1" bpmnElement="DataInputAssociation_1">
        <di:waypoint x="244" y="302" />
        <di:waypoint x="346" y="198" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

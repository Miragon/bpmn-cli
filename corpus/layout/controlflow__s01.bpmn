<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_S01" name="s01" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_CheckOrder" name="Check order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_CheckOrder" targetRef="Gateway_Ok" />
    <bpmn:exclusiveGateway id="Gateway_Ok" name="Order ok?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_BookOrder" name="Book order">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_BookOrder" targetRef="Gateway_Ok_join" />
    <bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gateway_Ok" targetRef="Activity_BookOrder" />
    <bpmn:userTask id="Activity_ClarifyWithCustomer" name="Clarify with customer">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_AdjustOrder" name="Adjust order">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_ReValidate" name="Re-validate">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_ReValidate" targetRef="Gateway_Ok_join" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_AdjustOrder" targetRef="Activity_ReValidate" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_ClarifyWithCustomer" targetRef="Activity_AdjustOrder" />
    <bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gateway_Ok" targetRef="Activity_ClarifyWithCustomer" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_CheckOrder" />
    <bpmn:exclusiveGateway id="Gateway_Ok_join">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Ok_join" targetRef="Event_Done" />
  </bpmn:process>

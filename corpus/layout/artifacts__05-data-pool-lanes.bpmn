<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Ins" name="Insurance company" processRef="Process_Pool" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool" name="Data in pool" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Clerk" name="Clerk">
        <bpmn:flowNodeRef>Event_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Under" name="Underwriter">
        <bpmn:flowNodeRef>Activity_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RejectMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Start" name="Claim received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Register" name="Register claim">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:targetRef>DataObjectReference_Claim</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Assess" name="Assess claim">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1">
        <bpmn:sourceRef>DataObjectReference_Claim</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_2">
        <bpmn:sourceRef>DataStoreReference_Policy</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Appr" name="Approved?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_Pay" name="Pay out">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_2">
        <bpmn:targetRef>DataStoreReference_Policy</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Paid" name="Paid">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Pay" targetRef="Event_Paid" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gateway_Appr" targetRef="Activity_Pay" />
    <bpmn:sendTask id="Activity_RejectMsg" name="Send rejection">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Rejected" name="Rejected">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_RejectMsg" targetRef="Event_Rejected" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gateway_Appr" targetRef="Activity_RejectMsg" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Assess" targetRef="Gateway_Appr" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Register" targetRef="Activity_Assess" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Register" />
    <bpmn:dataObject id="DataObject_ClaimFile" />
    <bpmn:dataObjectReference id="DataObjectReference_Claim" name="Claim file" dataObjectRef="DataObject_ClaimFile" />
    <bpmn:dataStoreReference id="DataStoreReference_Policy" name="Policy DB" dataStoreRef="DataStore_PolicyDB" />
    <bpmn:textAnnotation id="TextAnnotation_Assess">
      <bpmn:text>Four-eyes principle above 10k</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="TextAnnotation_Assess" targetRef="Activity_Assess" />
  </bpmn:process>
  <bpmn:dataStore id="DataStore_PolicyDB" name="Policy DB" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_1">

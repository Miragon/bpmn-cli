<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process">
    <bpmn:task id="task_a" />
    <bpmn:task id="task_middle" />
    <bpmn:task id="task_b" />
    <bpmn:sequenceFlow id="flow_in" sourceRef="task_a" targetRef="task_middle" />
    <bpmn:sequenceFlow id="flow_out" sourceRef="task_middle" targetRef="task_b" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="task_a_di" bpmnElement="task_a"><dc:Bounds x="100" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_middle_di" bpmnElement="task_middle"><dc:Bounds x="300" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_b_di" bpmnElement="task_b"><dc:Bounds x="100" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_in_di" bpmnElement="flow_in"><di:waypoint x="200" y="140" /><di:waypoint x="250" y="140" /><di:waypoint x="300" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_out_di" bpmnElement="flow_out"><di:waypoint x="300" y="140" /><di:waypoint x="250" y="140" /><di:waypoint x="250" y="340" /><di:waypoint x="200" y="340" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process">
    <bpmn:subProcess id="sub" name="Handle it">
      <bpmn:startEvent id="event_under_title" name="Start" />
      <bpmn:startEvent id="event_lower" name="Low" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="sub_di" bpmnElement="sub" isExpanded="true"><dc:Bounds x="100" y="100" width="300" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_under_title_di" bpmnElement="event_under_title"><dc:Bounds x="232" y="130" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="220" y="105" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_lower_di" bpmnElement="event_lower"><dc:Bounds x="232" y="230" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="220" y="270" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process">
    <bpmn:task id="task_a" />
    <bpmn:task id="task_b" />
    <bpmn:task id="task_join" />
    <bpmn:sequenceFlow id="flow_top" sourceRef="task_a" targetRef="task_join" />
    <bpmn:sequenceFlow id="flow_bottom" sourceRef="task_b" targetRef="task_join" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="task_a_di" bpmnElement="task_a"><dc:Bounds x="100" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_b_di" bpmnElement="task_b"><dc:Bounds x="100" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_join_di" bpmnElement="task_join"><dc:Bounds x="500" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_top_di" bpmnElement="flow_top"><di:waypoint x="200" y="140" /><di:waypoint x="300" y="140" /><di:waypoint x="300" y="240" /><di:waypoint x="500" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_bottom_di" bpmnElement="flow_bottom"><di:waypoint x="200" y="340" /><di:waypoint x="300" y="340" /><di:waypoint x="300" y="240" /><di:waypoint x="500" y="240" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process">
    <bpmn:task id="task_a" />
    <bpmn:exclusiveGateway id="gateway_join" />
    <bpmn:sequenceFlow id="flow_first" sourceRef="task_a" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_second" sourceRef="task_a" targetRef="gateway_join" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="task_a_di" bpmnElement="task_a"><dc:Bounds x="100" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_join_di" bpmnElement="gateway_join"><dc:Bounds x="300" y="100" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_first_di" bpmnElement="flow_first"><di:waypoint x="325" y="340" /><di:waypoint x="325" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_second_di" bpmnElement="flow_second"><di:waypoint x="325" y="340" /><di:waypoint x="325" y="150" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

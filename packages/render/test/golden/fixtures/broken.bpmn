<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Label">
    <bpmn:endEvent id="Event_Label" name="Done" />
    <bpmn:sequenceFlow id="Flow_Label" name="Go" sourceRef="Event_Label" targetRef="Event_Label" />
  </bpmn:process>
  <bpmn:process id="Process_Broken">
    <bpmn:task id="Task_Far" />
    <bpmn:sequenceFlow id="Flow_Far" sourceRef="Task_Far" targetRef="Task_Far" />
  </bpmn:process>
  <bpmn:process id="Process_Empty" />
  <bpmn:process id="Process_Far">
    <bpmn:task id="Task_Near" />
    <bpmn:task id="Task_Beyond" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Label">
    <bpmndi:BPMNPlane id="Plane_Label" bpmnElement="Process_Label">
      <bpmndi:BPMNShape id="Label_di" bpmnElement="Event_Label"><dc:Bounds x="100" y="100" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="100" y="140" width="-5" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FlowLabel_di" bpmnElement="Flow_Label"><di:waypoint x="100" y="200" /><di:waypoint x="200" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="2000000" y="140" width="5" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="Diagram_Broken">
    <bpmndi:BPMNPlane id="Plane_Broken" bpmnElement="Process_Broken">
      <bpmndi:BPMNShape id="Far_di" bpmnElement="Task_Far"><dc:Bounds x="2000000" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FarFlow_di" bpmnElement="Flow_Far"><di:waypoint x="2000000" y="200" /><di:waypoint x="200" y="200" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="Diagram_Far">
    <bpmndi:BPMNPlane id="Plane_Far" bpmnElement="Process_Far">
      <bpmndi:BPMNShape id="Near_di" bpmnElement="Task_Near"><dc:Bounds x="100" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Beyond_di" bpmnElement="Task_Beyond"><dc:Bounds x="2000000" y="100" width="100" height="80" /></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="Diagram_Empty">
    <bpmndi:BPMNPlane id="Plane_Empty" bpmnElement="Process_Empty" />
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

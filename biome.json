{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**/*.ts", "test/**/*.ts", "tools/**/*.mjs", "!tools/fuzz/out"] },
  "plugins": ["./tools/biome/block-statements.grit"],
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "warn", "options": { "maxAllowedComplexity": 25 } },
        "noExcessiveLinesPerFunction": { "level": "warn", "options": { "maxLines": 80 } }
      },
      "style": {
        "noNestedTernary": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/**", "tools/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off", "noExcessiveLinesPerFunction": "off" },
          "style": { "noNestedTernary": "off" }
        }
      }
    }
  ]
}

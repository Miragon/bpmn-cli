{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**/*.ts", "packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "test/**/*.ts", "tools/**/*.mjs", "!!.work"] },
  "plugins": ["./tools/gate/biome/block-statements.grit"],
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } },
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 50 } }
      },
      "style": {
        "noNestedTernary": "error",
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 300 } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/**", "packages/*/test/**", "tools/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off", "noExcessiveLinesPerFunction": "off" },
          "style": { "noNestedTernary": "off", "noExcessiveLinesPerFile": "off" }
        }
      }
    }
  ]
}

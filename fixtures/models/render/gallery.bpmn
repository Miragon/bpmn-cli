<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_RenderGallery" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RenderGallery">
    <bpmn:participant id="Participant_RenderGallery" name="Render gallery" processRef="Process_RenderGallery" />
    <bpmn:participant id="Participant_Partner" name="Partner" />
    <bpmn:messageFlow id="Flow_SendTaskToPartner" name="Order" sourceRef="Activity_SendTask" targetRef="Participant_Partner" />
    <bpmn:messageFlow id="Flow_PartnerToAnswer" name="Answer" sourceRef="Participant_Partner" targetRef="Event_Answer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_RenderGallery" name="Render gallery" isExecutable="true">
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_OrderReceivedToUserTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_UserTask" name="User task">
      <bpmn:incoming>Flow_OrderReceivedToUserTask</bpmn:incoming>
      <bpmn:outgoing>Flow_UserTaskToServiceTask</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_UserTaskToOrder">
        <bpmn:targetRef>DataObjectReference_Order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_TwoDays" name="Two days" attachedToRef="Activity_UserTask">
      <bpmn:outgoing>Flow_TwoDaysToTimedOut</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_TimedOut" name="Timed out">
      <bpmn:incoming>Flow_TwoDaysToTimedOut</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TwoDaysToTimedOut" sourceRef="Event_TwoDays" targetRef="Event_TimedOut" />
    <bpmn:serviceTask id="Activity_ServiceTask" name="Service task">
      <bpmn:incoming>Flow_UserTaskToServiceTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ServiceTaskToScriptTask</bpmn:outgoing>
      <bpmn:property id="Property_ServiceTask" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_CustomersToServiceTask">
        <bpmn:sourceRef>DataStoreReference_Customers</bpmn:sourceRef>
        <bpmn:targetRef>Property_ServiceTask</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_Reminder" name="Reminder" cancelActivity="false" attachedToRef="Activity_ServiceTask">
      <bpmn:outgoing>Flow_ReminderToReminded</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Reminder" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_Reminded" name="Reminded">
      <bpmn:incoming>Flow_ReminderToReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ReminderToReminded" sourceRef="Event_Reminder" targetRef="Event_Reminded" />
    <bpmn:scriptTask id="Activity_ScriptTask" name="Script task">
      <bpmn:incoming>Flow_ServiceTaskToScriptTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ScriptTaskToSendTask</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:boundaryEvent id="Event_Failed" name="Failed" attachedToRef="Activity_ScriptTask">
      <bpmn:outgoing>Flow_FailedToErrorEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Failure" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_ErrorEnd" name="Error end">
      <bpmn:incoming>Flow_FailedToErrorEnd</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_Failure" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_FailedToErrorEnd" sourceRef="Event_Failed" targetRef="Event_ErrorEnd" />
    <bpmn:sendTask id="Activity_SendTask" name="Send task">
      <bpmn:incoming>Flow_ScriptTaskToSendTask</bpmn:incoming>
      <bpmn:outgoing>Flow_SendTaskToReceiveTask</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="Event_Escalated" name="Escalated" cancelActivity="false" attachedToRef="Activity_SendTask">
      <bpmn:outgoing>Flow_EscalatedToEscalationEnd</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Escalation_Late" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_EscalationEnd" name="Escalation end">
      <bpmn:incoming>Flow_EscalatedToEscalationEnd</bpmn:incoming>
      <bpmn:escalationEventDefinition escalationRef="Escalation_Late" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EscalatedToEscalationEnd" sourceRef="Event_Escalated" targetRef="Event_EscalationEnd" />
    <bpmn:receiveTask id="Activity_ReceiveTask" name="Receive task">
      <bpmn:incoming>Flow_SendTaskToReceiveTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveTaskToManualTask</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Event_Stopped" name="Stopped" attachedToRef="Activity_ReceiveTask">
      <bpmn:outgoing>Flow_StoppedToSignalEnd</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_Stop" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_SignalEnd" name="Signal end">
      <bpmn:incoming>Flow_StoppedToSignalEnd</bpmn:incoming>
      <bpmn:signalEventDefinition signalRef="Signal_Stop" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StoppedToSignalEnd" sourceRef="Event_Stopped" targetRef="Event_SignalEnd" />
    <bpmn:manualTask id="Activity_ManualTask" name="Manual task">
      <bpmn:incoming>Flow_ReceiveTaskToManualTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualTaskToBusinessRuleTask</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:boundaryEvent id="Event_Changed" name="Changed" cancelActivity="false" attachedToRef="Activity_ManualTask">
      <bpmn:outgoing>Flow_ChangedToMessageEnd</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${changed}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_MessageEnd" name="Message end">
      <bpmn:incoming>Flow_ChangedToMessageEnd</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_Changed" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ChangedToMessageEnd" sourceRef="Event_Changed" targetRef="Event_MessageEnd" />
    <bpmn:businessRuleTask id="Activity_BusinessRuleTask" name="Business rule task">
      <bpmn:incoming>Flow_ManualTaskToBusinessRuleTask</bpmn:incoming>
      <bpmn:outgoing>Flow_BusinessRuleTaskToCallActivity</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:boundaryEvent id="Event_Undo" name="Undo" attachedToRef="Activity_BusinessRuleTask">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="Activity_CallActivity" name="Call activity">
      <bpmn:incoming>Flow_BusinessRuleTaskToCallActivity</bpmn:incoming>
      <bpmn:outgoing>Flow_CallActivityToStandardLoop</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="Activity_StandardLoop" name="Standard loop">
      <bpmn:incoming>Flow_CallActivityToStandardLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_StandardLoopToParallelMultiInstance</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="Activity_ParallelMultiInstance" name="Parallel multi-instance">
      <bpmn:incoming>Flow_StandardLoopToParallelMultiInstance</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelMultiInstanceToSequentialMultiInstance</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:task>
    <bpmn:task id="Activity_SequentialMultiInstance" name="Sequential multi-instance">
      <bpmn:incoming>Flow_ParallelMultiInstanceToSequentialMultiInstance</bpmn:incoming>
      <bpmn:outgoing>Flow_SequentialMultiInstanceToTerminated</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:task>
    <bpmn:endEvent id="Event_Terminated" name="Terminated">
      <bpmn:incoming>Flow_SequentialMultiInstanceToTerminated</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SequentialMultiInstanceToTerminated" sourceRef="Activity_SequentialMultiInstance" targetRef="Event_Terminated" />
    <bpmn:sequenceFlow id="Flow_ParallelMultiInstanceToSequentialMultiInstance" sourceRef="Activity_ParallelMultiInstance" targetRef="Activity_SequentialMultiInstance" />
    <bpmn:sequenceFlow id="Flow_StandardLoopToParallelMultiInstance" sourceRef="Activity_StandardLoop" targetRef="Activity_ParallelMultiInstance" />
    <bpmn:sequenceFlow id="Flow_CallActivityToStandardLoop" sourceRef="Activity_CallActivity" targetRef="Activity_StandardLoop" />
    <bpmn:sequenceFlow id="Flow_BusinessRuleTaskToCallActivity" sourceRef="Activity_BusinessRuleTask" targetRef="Activity_CallActivity" />
    <bpmn:sequenceFlow id="Flow_ManualTaskToBusinessRuleTask" sourceRef="Activity_ManualTask" targetRef="Activity_BusinessRuleTask" />
    <bpmn:sequenceFlow id="Flow_ReceiveTaskToManualTask" sourceRef="Activity_ReceiveTask" targetRef="Activity_ManualTask" />
    <bpmn:sequenceFlow id="Flow_SendTaskToReceiveTask" sourceRef="Activity_SendTask" targetRef="Activity_ReceiveTask" />
    <bpmn:sequenceFlow id="Flow_ScriptTaskToSendTask" sourceRef="Activity_ScriptTask" targetRef="Activity_SendTask" />
    <bpmn:sequenceFlow id="Flow_ServiceTaskToScriptTask" sourceRef="Activity_ServiceTask" targetRef="Activity_ScriptTask" />
    <bpmn:sequenceFlow id="Flow_UserTaskToServiceTask" sourceRef="Activity_UserTask" targetRef="Activity_ServiceTask" />
    <bpmn:sequenceFlow id="Flow_OrderReceivedToUserTask" sourceRef="Event_OrderReceived" targetRef="Activity_UserTask" />
    <bpmn:task id="Activity_Compensation" name="Compensation" isForCompensation="true" />
    <bpmn:startEvent id="Event_EveryMorning" name="Every morning">
      <bpmn:outgoing>Flow_EveryMorningToWhichPath</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_WhichPath" name="Which path?" default="Flow_WhichPathToRejected">
      <bpmn:incoming>Flow_EveryMorningToWhichPath</bpmn:incoming>
      <bpmn:outgoing>Flow_WhichPathToAfterWhichPath</bpmn:outgoing>
      <bpmn:outgoing>Flow_WhichPathToRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_AfterWhichPath">
      <bpmn:incoming>Flow_WhichPathToAfterWhichPath</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterWhichPathToAnyOf</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:inclusiveGateway id="Gateway_AnyOf" name="Any of?">
      <bpmn:incoming>Flow_AfterWhichPathToAnyOf</bpmn:incoming>
      <bpmn:outgoing>Flow_AnyOfToWaitFor</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_WaitFor" name="Wait for">
      <bpmn:incoming>Flow_AnyOfToWaitFor</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForToAnswer</bpmn:outgoing>
      <bpmn:outgoing>Flow_WaitForToOneHour</bpmn:outgoing>
      <bpmn:outgoing>Flow_WaitForToGo</bpmn:outgoing>
      <bpmn:outgoing>Flow_WaitForToReady</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_Answer" name="Answer">
      <bpmn:incoming>Flow_WaitForToAnswer</bpmn:incoming>
      <bpmn:outgoing>Flow_AnswerToNotify</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Answer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_Notify" name="Notify">
      <bpmn:incoming>Flow_AnswerToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToBroadcast</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Note" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_Broadcast" name="Broadcast">
      <bpmn:incoming>Flow_NotifyToBroadcast</bpmn:incoming>
      <bpmn:outgoing>Flow_BroadcastToRaise</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_Go" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_Raise" name="Raise">
      <bpmn:incoming>Flow_BroadcastToRaise</bpmn:incoming>
      <bpmn:outgoing>Flow_RaiseToCompensate</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Escalation_Late" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_Compensate" name="Compensate">
      <bpmn:incoming>Flow_RaiseToCompensate</bpmn:incoming>
      <bpmn:outgoing>Flow_CompensateToMilestone</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_Milestone" name="Milestone">
      <bpmn:incoming>Flow_CompensateToMilestone</bpmn:incoming>
      <bpmn:outgoing>Flow_MilestoneToToB</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Milestone" />
      <bpmn:signalEventDefinition id="SignalEventDefinition_Milestone" signalRef="Signal_Go" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_ToB" name="To B">
      <bpmn:incoming>Flow_MilestoneToToB</bpmn:incoming>
      <bpmn:linkEventDefinition name="B" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_MilestoneToToB" sourceRef="Event_Milestone" targetRef="Event_ToB" />
    <bpmn:sequenceFlow id="Flow_CompensateToMilestone" sourceRef="Event_Compensate" targetRef="Event_Milestone" />
    <bpmn:sequenceFlow id="Flow_RaiseToCompensate" sourceRef="Event_Raise" targetRef="Event_Compensate" />
    <bpmn:sequenceFlow id="Flow_BroadcastToRaise" sourceRef="Event_Broadcast" targetRef="Event_Raise" />
    <bpmn:sequenceFlow id="Flow_NotifyToBroadcast" sourceRef="Event_Notify" targetRef="Event_Broadcast" />
    <bpmn:sequenceFlow id="Flow_AnswerToNotify" sourceRef="Event_Answer" targetRef="Event_Notify" />
    <bpmn:sequenceFlow id="Flow_WaitForToAnswer" sourceRef="Gateway_WaitFor" targetRef="Event_Answer" />
    <bpmn:intermediateCatchEvent id="Event_OneHour" name="One hour">
      <bpmn:incoming>Flow_WaitForToOneHour</bpmn:incoming>
      <bpmn:outgoing>Flow_OneHourToCompensationEnd</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_CompensationEnd" name="Compensation end">
      <bpmn:incoming>Flow_OneHourToCompensationEnd</bpmn:incoming>
      <bpmn:compensateEventDefinition />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OneHourToCompensationEnd" sourceRef="Event_OneHour" targetRef="Event_CompensationEnd" />
    <bpmn:sequenceFlow id="Flow_WaitForToOneHour" sourceRef="Gateway_WaitFor" targetRef="Event_OneHour" />
    <bpmn:intermediateCatchEvent id="Event_Go" name="Go" parallelMultiple="true">
      <bpmn:incoming>Flow_WaitForToGo</bpmn:incoming>
      <bpmn:outgoing>Flow_GoToSignalled</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_Go" />
      <bpmn:messageEventDefinition id="MessageEventDefinition_Go" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_Signalled" name="Signalled">
      <bpmn:incoming>Flow_GoToSignalled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_GoToSignalled" sourceRef="Event_Go" targetRef="Event_Signalled" />
    <bpmn:sequenceFlow id="Flow_WaitForToGo" sourceRef="Gateway_WaitFor" targetRef="Event_Go" />
    <bpmn:intermediateCatchEvent id="Event_Ready" name="Ready">
      <bpmn:incoming>Flow_WaitForToReady</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadyToMerge</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${ready}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_WasReady" name="Was ready">
      <bpmn:incoming>Flow_MergeToWasReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ReadyToMerge" sourceRef="Event_Ready" targetRef="Gateway_Merge" />
    <bpmn:inclusiveGateway id="Gateway_Merge" name="Merge">
      <bpmn:incoming>Flow_ReadyToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToWasReady</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="Flow_MergeToWasReady" sourceRef="Gateway_Merge" targetRef="Event_WasReady" />
    <bpmn:sequenceFlow id="Flow_WaitForToReady" sourceRef="Gateway_WaitFor" targetRef="Event_Ready" />
    <bpmn:sequenceFlow id="Flow_AnyOfToWaitFor" sourceRef="Gateway_AnyOf" targetRef="Gateway_WaitFor" />
    <bpmn:sequenceFlow id="Flow_AfterWhichPathToAnyOf" sourceRef="Gateway_AfterWhichPath" targetRef="Gateway_AnyOf" />
    <bpmn:sequenceFlow id="Flow_WhichPathToAfterWhichPath" name="both" sourceRef="Gateway_WhichPath" targetRef="Gateway_AfterWhichPath" />
    <bpmn:endEvent id="Event_Rejected" name="Rejected">
      <bpmn:incoming>Flow_WhichPathToRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_WhichPathToRejected" name="no" sourceRef="Gateway_WhichPath" targetRef="Event_Rejected" />
    <bpmn:sequenceFlow id="Flow_EveryMorningToWhichPath" sourceRef="Event_EveryMorning" targetRef="Gateway_WhichPath" />
    <bpmn:intermediateCatchEvent id="Event_FromB" name="From B">
      <bpmn:outgoing>Flow_FromBToExpandedSubProcess</bpmn:outgoing>
      <bpmn:linkEventDefinition name="B" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Activity_ExpandedSubProcess" name="Expanded sub-process">
      <bpmn:incoming>Flow_FromBToExpandedSubProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_ExpandedSubProcessToCollapsedSubProcess</bpmn:outgoing>
      <bpmn:startEvent id="Event_InnerStart" name="Inner start">
        <bpmn:outgoing>Flow_InnerStartToInnerTask</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Activity_InnerTask" name="Inner task">
        <bpmn:incoming>Flow_InnerStartToInnerTask</bpmn:incoming>
        <bpmn:outgoing>Flow_InnerTaskToInnerEnd</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Event_InnerEnd" name="Inner end">
        <bpmn:incoming>Flow_InnerTaskToInnerEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_InnerTaskToInnerEnd" sourceRef="Activity_InnerTask" targetRef="Event_InnerEnd" />
      <bpmn:sequenceFlow id="Flow_InnerStartToInnerTask" sourceRef="Event_InnerStart" targetRef="Activity_InnerTask" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_CollapsedSubProcess" name="Collapsed sub-process">
      <bpmn:incoming>Flow_ExpandedSubProcessToCollapsedSubProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_CollapsedSubProcessToAdHocSubProcess</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:adHocSubProcess id="Activity_AdHocSubProcess" name="Ad-hoc sub-process">
      <bpmn:incoming>Flow_CollapsedSubProcessToAdHocSubProcess</bpmn:incoming>
      <bpmn:outgoing>Flow_AdHocSubProcessToTransaction</bpmn:outgoing>
    </bpmn:adHocSubProcess>
    <bpmn:transaction id="Activity_Transaction" name="Transaction">
      <bpmn:incoming>Flow_AdHocSubProcessToTransaction</bpmn:incoming>
      <bpmn:outgoing>Flow_TransactionToBooked</bpmn:outgoing>
      <bpmn:startEvent id="Event_BookingStarted" name="Booking started">
        <bpmn:outgoing>Flow_BookingStartedToCancelled</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_Cancelled" name="Cancelled">
        <bpmn:incoming>Flow_BookingStartedToCancelled</bpmn:incoming>
        <bpmn:cancelEventDefinition />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_BookingStartedToCancelled" sourceRef="Event_BookingStarted" targetRef="Event_Cancelled" />
    </bpmn:transaction>
    <bpmn:endEvent id="Event_Booked" name="Booked">
      <bpmn:incoming>Flow_TransactionToBooked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TransactionToBooked" sourceRef="Activity_Transaction" targetRef="Event_Booked" />
    <bpmn:boundaryEvent id="Event_OnCancel" name="On cancel" attachedToRef="Activity_Transaction">
      <bpmn:outgoing>Flow_OnCancelToBookingCancelled</bpmn:outgoing>
      <bpmn:cancelEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_BookingCancelled" name="Booking cancelled">
      <bpmn:incoming>Flow_OnCancelToBookingCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OnCancelToBookingCancelled" sourceRef="Event_OnCancel" targetRef="Event_BookingCancelled" />
    <bpmn:sequenceFlow id="Flow_AdHocSubProcessToTransaction" sourceRef="Activity_AdHocSubProcess" targetRef="Activity_Transaction" />
    <bpmn:sequenceFlow id="Flow_CollapsedSubProcessToAdHocSubProcess" sourceRef="Activity_CollapsedSubProcess" targetRef="Activity_AdHocSubProcess" />
    <bpmn:sequenceFlow id="Flow_ExpandedSubProcessToCollapsedSubProcess" sourceRef="Activity_ExpandedSubProcess" targetRef="Activity_CollapsedSubProcess" />
    <bpmn:sequenceFlow id="Flow_FromBToExpandedSubProcess" sourceRef="Event_FromB" targetRef="Activity_ExpandedSubProcess" />
    <bpmn:subProcess id="Activity_EventSubProcess" name="Event sub-process" triggeredByEvent="true">
      <bpmn:startEvent id="Event_MessageStartInEventSubProcess" isInterrupting="false">
        <bpmn:messageEventDefinition messageRef="Message_Cancel" />
      </bpmn:startEvent>
    </bpmn:subProcess>
    <bpmn:dataObject id="DataObject_Order" />
    <bpmn:dataObjectReference id="DataObjectReference_Order" name="Order" dataObjectRef="DataObject_Order" />
    <bpmn:dataStoreReference id="DataStoreReference_Customers" name="Customers" dataStoreRef="DataStore_Customers" />
    <bpmn:association id="Association_UndoToCompensation" associationDirection="One" sourceRef="Event_Undo" targetRef="Activity_Compensation" />
    <bpmn:textAnnotation id="TextAnnotation_ATextAnnotationThatWrapsOverSeveralLines">
      <bpmn:text>A text annotation that wraps over several lines</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_ATextAnnotationThatWrapsOverSeveralLines" sourceRef="TextAnnotation_ATextAnnotationThatWrapsOverSeveralLines" targetRef="Activity_ScriptTask" />

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C1">
    <bpmn:participant id="PA" name="A" processRef="P1"/>
    <bpmn:participant id="PB" name="B" processRef="P2"/>
    <bpmn:textAnnotation id="Note"><bpmn:text>note</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As" sourceRef="Q" targetRef="Note"/>
  </bpmn:collaboration>
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:startEvent id="S"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="A" name="A"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Z" name="Z"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="A"/>
    <bpmn:sequenceFlow id="F2" sourceRef="A" targetRef="E"/>
  </bpmn:process>
  <bpmn:process id="P2">
    <bpmn:startEvent id="S2"><bpmn:outgoing>H1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Q" name="Q"><bpmn:incoming>H1</bpmn:incoming><bpmn:outgoing>H2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E3"><bpmn:incoming>H2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="H1" sourceRef="S2" targetRef="Q"/>
    <bpmn:sequenceFlow id="H2" sourceRef="Q" targetRef="E3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="C1">
      <bpmndi:BPMNShape id="PA_di" bpmnElement="PA" isHorizontal="true"><dc:Bounds x="100" y="60" width="500" height="260"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="162" y="112" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A"><dc:Bounds x="250" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="412" y="112" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_di" bpmnElement="Z"><dc:Bounds x="250" y="200" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PB_di" bpmnElement="PB" isHorizontal="true"><dc:Bounds x="100" y="360" width="900" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2_di" bpmnElement="S2"><dc:Bounds x="162" y="442" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_di" bpmnElement="Q"><dc:Bounds x="650" y="420" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_di" bpmnElement="E3"><dc:Bounds x="902" y="442" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_di" bpmnElement="Note"><dc:Bounds x="790" y="380" width="80" height="30"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="198" y="130"/><di:waypoint x="250" y="130"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="350" y="130"/><di:waypoint x="412" y="130"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="H1_di" bpmnElement="H1"><di:waypoint x="198" y="460"/><di:waypoint x="650" y="460"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="H2_di" bpmnElement="H2"><di:waypoint x="750" y="460"/><di:waypoint x="902" y="460"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="As_di" bpmnElement="As"><di:waypoint x="750" y="440"/><di:waypoint x="790" y="400"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

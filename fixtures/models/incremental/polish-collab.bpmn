<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C1">
    <bpmn:participant id="Cust" name="Customer"/>
    <bpmn:participant id="Org" name="Shop" processRef="P1"/>
    <bpmn:messageFlow id="M1" name="Rejection" sourceRef="R" targetRef="Cust"/>
  </bpmn:collaboration>
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:startEvent id="S" name="Order in"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="A" name="Check order"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:sendTask id="R" name="Send rejection"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="E" name="Rejected"><bpmn:incoming>F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="A"/>
    <bpmn:sequenceFlow id="F2" sourceRef="A" targetRef="R"/>
    <bpmn:sequenceFlow id="F3" sourceRef="R" targetRef="E"/>
    <bpmn:subProcess id="ESP" name="Cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="ES" name="Cancelled" isInterrupting="false"><bpmn:outgoing>EF1</bpmn:outgoing><bpmn:messageEventDefinition id="MED1"/></bpmn:startEvent>
      <bpmn:task id="ET" name="Book cancellation"><bpmn:incoming>EF1</bpmn:incoming><bpmn:outgoing>EF2</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="EE" name="Booked"><bpmn:incoming>EF2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="EF1" sourceRef="ES" targetRef="ET"/>
      <bpmn:sequenceFlow id="EF2" sourceRef="ET" targetRef="EE"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="ESP2" name="Billing" triggeredByEvent="true">
      <bpmn:startEvent id="BS" name="Billed" isInterrupting="false"><bpmn:outgoing>BF1</bpmn:outgoing><bpmn:signalEventDefinition id="SED1"/></bpmn:startEvent>
      <bpmn:task id="BT" name="Mark billed"><bpmn:incoming>BF1</bpmn:incoming><bpmn:outgoing>BF2</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="BE" name="Marked"><bpmn:incoming>BF2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="BF1" sourceRef="BS" targetRef="BT"/>
      <bpmn:sequenceFlow id="BF2" sourceRef="BT" targetRef="BE"/>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="C1">
      <bpmndi:BPMNShape id="Cust_di" bpmnElement="Cust" isHorizontal="true"><dc:Bounds x="100" y="40" width="900" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Org_di" bpmnElement="Org" isHorizontal="true"><dc:Bounds x="100" y="160" width="900" height="600"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="172" y="222" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="168" y="265" width="44" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A"><dc:Bounds x="250" y="200" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R_di" bpmnElement="R"><dc:Bounds x="420" y="200" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="602" y="222" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="596" y="265" width="48" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ESP_di" bpmnElement="ESP" isExpanded="true"><dc:Bounds x="150" y="380" width="330" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ES_di" bpmnElement="ES"><dc:Bounds x="182" y="447" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="174" y="490" width="52" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ET_di" bpmnElement="ET"><dc:Bounds x="260" y="425" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EE_di" bpmnElement="EE"><dc:Bounds x="412" y="447" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="408" y="490" width="44" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ESP2_di" bpmnElement="ESP2" isExpanded="true"><dc:Bounds x="300" y="580" width="400" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BS_di" bpmnElement="BS"><dc:Bounds x="332" y="642" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="334" y="685" width="32" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BT_di" bpmnElement="BT"><dc:Bounds x="420" y="620" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BE_di" bpmnElement="BE"><dc:Bounds x="592" y="642" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="588" y="685" width="44" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="208" y="240"/><di:waypoint x="250" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="350" y="240"/><di:waypoint x="420" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="520" y="240"/><di:waypoint x="602" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M1_di" bpmnElement="M1"><di:waypoint x="470" y="200"/><di:waypoint x="470" y="100"/><bpmndi:BPMNLabel><dc:Bounds x="476" y="130" width="50" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EF1_di" bpmnElement="EF1"><di:waypoint x="218" y="465"/><di:waypoint x="260" y="465"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EF2_di" bpmnElement="EF2"><di:waypoint x="360" y="465"/><di:waypoint x="412" y="465"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BF1_di" bpmnElement="BF1"><di:waypoint x="368" y="660"/><di:waypoint x="420" y="660"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BF2_di" bpmnElement="BF2"><di:waypoint x="520" y="660"/><di:waypoint x="592" y="660"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

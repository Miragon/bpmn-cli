<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic drawing: M and the end event X sit in sub-process P; right of P a task R, and further right,
     below P's bottom, a task B before the gateway J. `place M --row-of J --after X` grows P down and to
     the right; what lies right of P makes room, and J is the row reference. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:subProcess id="P" name="Assess"><bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:endEvent id="X" name="Done"/>
      <bpmn:task id="M" name="Escalate"/>
    </bpmn:subProcess>
    <bpmn:task id="R" name="Review"><bpmn:incoming>F1</bpmn:incoming></bpmn:task>
    <bpmn:task id="B" name="Ship"><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="J"><bpmn:incoming>F2</bpmn:incoming></bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F1" sourceRef="P" targetRef="R"/>
    <bpmn:sequenceFlow id="F2" sourceRef="B" targetRef="J"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="P1">
      <bpmndi:BPMNShape id="P_di" bpmnElement="P" isExpanded="true"><dc:Bounds x="100" y="80" width="600" height="300"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_di" bpmnElement="X"><dc:Bounds x="640" y="130" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_di" bpmnElement="M"><dc:Bounds x="400" y="260" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R_di" bpmnElement="R"><dc:Bounds x="760" y="150" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_di" bpmnElement="B"><dc:Bounds x="1000" y="440" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="J_di" bpmnElement="J" isMarkerVisible="true"><dc:Bounds x="1160" y="455" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="700" y="190"/><di:waypoint x="760" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="1100" y="480"/><di:waypoint x="1160" y="480"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

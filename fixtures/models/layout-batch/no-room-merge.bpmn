<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1p7x3kq" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0">
  <bpmn:process id="Process_0c4m2wd" name="Purchase request" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Purchase request submitted">
      <bpmn:outgoing>Flow_0b8wq1x</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_0k3x9qa" name="Check budget">
      <bpmn:incoming>Flow_0b8wq1x</bpmn:incoming>
      <bpmn:outgoing>Flow_1j4kz7p</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1hd8x2m" name="Budget available?" default="Flow_1r2x9bv">
      <bpmn:incoming>Flow_1j4kz7p</bpmn:incoming>
      <bpmn:outgoing>Flow_0yq6cfd</bpmn:outgoing>
      <bpmn:outgoing>Flow_1r2x9bv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1v0w8zr" name="Order goods">
      <bpmn:incoming>Flow_PurchaseApprovedToOrderGoods</bpmn:incoming>
      <bpmn:outgoing>Flow_0m7sd3e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0q2mb7c" name="Goods ordered">
      <bpmn:incoming>Flow_0m7sd3e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_0f3j5ny" name="Notify requester">
      <bpmn:incoming>Flow_MergeRejectionToNotifyRequester</bpmn:incoming>
      <bpmn:outgoing>Flow_1c5ag8h</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_1n8ld0a" name="Request rejected">
      <bpmn:incoming>Flow_1c5ag8h</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0b8wq1x" sourceRef="StartEvent_1" targetRef="Activity_0k3x9qa" />
    <bpmn:sequenceFlow id="Flow_1j4kz7p" sourceRef="Activity_0k3x9qa" targetRef="Gateway_1hd8x2m" />
    <bpmn:sequenceFlow id="Flow_0yq6cfd" name="yes" sourceRef="Gateway_1hd8x2m" targetRef="Activity_ApprovePurchase">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${budgetAvailable}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1r2x9bv" name="no" sourceRef="Gateway_1hd8x2m" targetRef="Gateway_MergeRejection" />
    <bpmn:exclusiveGateway id="Gateway_MergeRejection">
      <bpmn:incoming>Flow_1r2x9bv</bpmn:incoming>
      <bpmn:incoming>Flow_PurchaseApprovedToMergeRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeRejectionToNotifyRequester</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_MergeRejectionToNotifyRequester" sourceRef="Gateway_MergeRejection" targetRef="Activity_0f3j5ny" />
    <bpmn:userTask id="Activity_ApprovePurchase" name="Approve purchase">
      <bpmn:incoming>Flow_0yq6cfd</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovePurchaseToPurchaseApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_ApprovalOverdue" name="3 days" cancelActivity="false" attachedToRef="Activity_ApprovePurchase">
      <bpmn:outgoing>Flow_ApprovalOverdueToSendApprovalReminder</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_SendApprovalReminder" name="Send reminder to manager">
      <bpmn:incoming>Flow_ApprovalOverdueToSendApprovalReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_SendApprovalReminderToReminderSent</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_SendApprovalReminderToReminderSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SendApprovalReminderToReminderSent" sourceRef="Activity_SendApprovalReminder" targetRef="Event_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_ApprovalOverdueToSendApprovalReminder" sourceRef="Event_ApprovalOverdue" targetRef="Activity_SendApprovalReminder" />
    <bpmn:sequenceFlow id="Flow_ApprovePurchaseToPurchaseApproved" sourceRef="Activity_ApprovePurchase" targetRef="Gateway_PurchaseApproved" />
    <bpmn:exclusiveGateway id="Gateway_PurchaseApproved" name="Purchase approved?" default="Flow_PurchaseApprovedToMergeRejection">
      <bpmn:incoming>Flow_ApprovePurchaseToPurchaseApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_PurchaseApprovedToOrderGoods</bpmn:outgoing>
      <bpmn:outgoing>Flow_PurchaseApprovedToMergeRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PurchaseApprovedToOrderGoods" name="yes" sourceRef="Gateway_PurchaseApproved" targetRef="Activity_1v0w8zr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${purchaseApproved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PurchaseApprovedToMergeRejection" name="no" sourceRef="Gateway_PurchaseApproved" targetRef="Gateway_MergeRejection" />
    <bpmn:sequenceFlow id="Flow_0m7sd3e" sourceRef="Activity_1v0w8zr" targetRef="Event_0q2mb7c" />
    <bpmn:sequenceFlow id="Flow_1c5ag8h" sourceRef="Activity_0f3j5ny" targetRef="Event_1n8ld0a" />
  </bpmn:process>

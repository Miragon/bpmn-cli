<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C1">
    <bpmn:participant id="Org" name="Support" processRef="P1"/>
  </bpmn:collaboration>
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:startEvent id="S"/>
    <bpmn:task id="X" name="Add note" default="f4"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E2"><bpmn:incoming>fFz3PayToEnd</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f3" sourceRef="B" targetRef="X"/>
    <bpmn:sequenceFlow id="f4" name="fn5" sourceRef="X" targetRef="H"/>
    <bpmn:userTask id="H" name="Handle ticket"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>fHandleTicketToFz3Pay</bpmn:outgoing></bpmn:userTask>
    <bpmn:boundaryEvent id="B" attachedToRef="H" cancelActivity="false"><bpmn:outgoing>f3</bpmn:outgoing><bpmn:messageEventDefinition id="MED1"/></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="fHandleTicketToFz3Pay" sourceRef="H" targetRef="Activity_Fz3Pay"/>
    <bpmn:subProcess id="Activity_Fz3Pay" name="Fz3 pay">
      <bpmn:incoming>fHandleTicketToFz3Pay</bpmn:incoming>
      <bpmn:outgoing>fFz3PayToEnd</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="fFz3PayToEnd" sourceRef="Activity_Fz3Pay" targetRef="E2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="C1">
      <bpmndi:BPMNShape id="Org_di" bpmnElement="Org" isHorizontal="true"><dc:Bounds x="100" y="80" width="1200" height="315"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="172" y="122" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="H_di" bpmnElement="H"><dc:Bounds x="510" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_di" bpmnElement="B"><dc:Bounds x="572" y="302" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="X_di" bpmnElement="X"><dc:Bounds x="350" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="1080" y="262" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="590" y="338"/><di:waypoint x="590" y="353"/><di:waypoint x="400" y="353"/><di:waypoint x="400" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="450" y="280"/><di:waypoint x="510" y="280"/><bpmndi:BPMNLabel>
          <dc:Bounds x="458" y="262" width="33" height="14"/>
        </bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Activity_Fz3Pay_di" bpmnElement="Activity_Fz3Pay" isExpanded="true">
        <dc:Bounds x="670" y="180" width="350" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="fHandleTicketToFz3Pay_di" bpmnElement="fHandleTicketToFz3Pay">
        <di:waypoint x="610" y="280"/>
        <di:waypoint x="670" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fFz3PayToEnd_di" bpmnElement="fFz3PayToEnd">
        <di:waypoint x="1020" y="280"/>
        <di:waypoint x="1080" y="280"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

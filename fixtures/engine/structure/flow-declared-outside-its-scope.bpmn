<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Sub" />
    <bpmn:subProcess id="Sub"><bpmn:startEvent id="In" /><bpmn:endEvent id="Out" /></bpmn:subProcess>
    <bpmn:sequenceFlow id="F2" sourceRef="In" targetRef="Out" />
    <bpmn:sequenceFlow id="F3" sourceRef="Sub" targetRef="End" />
    <bpmn:endEvent id="End" />
  </bpmn:process>
</bpmn:definitions>

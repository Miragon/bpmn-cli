<bpmn:userTask id="Host"></bpmn:userTask>
<bpmn:subProcess id="Sub" ><bpmn:startEvent id="SS" /><bpmn:userTask id="Inner" /><bpmn:endEvent id="SE" /><bpmn:sequenceFlow id="s0" sourceRef="SS" targetRef="Inner" /><bpmn:sequenceFlow id="s1" sourceRef="Inner" targetRef="SE" /></bpmn:subProcess>

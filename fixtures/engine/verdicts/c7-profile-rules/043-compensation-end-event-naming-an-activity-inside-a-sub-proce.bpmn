<bpmn:signal id="Sig" name="Go" /><bpmn:signal id="Sig2" name="Go2" /><bpmn:message id="M" name="Pay" /><bpmn:message id="M2" name="Pay2" /><bpmn:message id="M3" name="Pay" />
  <bpmn:process id="P_FollowUp" isExecutable="true" camunda:historyTimeToLive="180">

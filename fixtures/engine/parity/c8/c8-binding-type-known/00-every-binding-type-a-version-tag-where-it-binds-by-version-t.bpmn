<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.10.0"
    
    id="definitions_test" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process_test" isExecutable="true">
    <bpmn:callActivity id="callActivity_ship"><bpmn:extensionElements><zeebe:calledElement processId="ship" bindingType="deployment" /></bpmn:extensionElements></bpmn:callActivity>
          <bpmn:businessRuleTask id="businessRuleTask_rate"><bpmn:extensionElements><zeebe:calledDecision decisionId="rate" resultVariable="rate" bindingType="latest" /></bpmn:extensionElements></bpmn:businessRuleTask>
          <bpmn:userTask id="userTask_review"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="review" bindingType="versionTag" versionTag="v1" /></bpmn:extensionElements></bpmn:userTask>
  </bpmn:process>
  
</bpmn:definitions>
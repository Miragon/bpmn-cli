      <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="G" />
      <bpmn:exclusiveGateway id="G" />
      <bpmn:sequenceFlow id="S0" sourceRef="G" targetRef="End0"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${a}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:endEvent id="End0" />
<bpmn:sequenceFlow id="S1" sourceRef="G" targetRef="End1"></bpmn:sequenceFlow><bpmn:endEvent id="End1" /></bpmn:adHocSubProcess>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
    modeler:executionPlatform="Camunda Platform"
    modeler:executionPlatformVersion="7.24.0"
    
    id="definitions_test" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process_test" isExecutable="true">
    <bpmn:userTask id="userTask_review" /><bpmn:boundaryEvent id="boundaryEvent_failed" attachedToRef="userTask_review" camunda:errorCodeVariable="code"><bpmn:errorEventDefinition errorRef="error_failed" /></bpmn:boundaryEvent>
  </bpmn:process>
  <bpmn:message id="message_paid" name="paid" /><bpmn:signal id="signal_go" name="go" />
    <bpmn:escalation id="escalation_late" name="late" escalationCode="E1" /><bpmn:error id="error_failed" name="failed" errorCode="E1" />
</bpmn:definitions>
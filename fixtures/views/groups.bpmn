<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Groups" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:category id="Category_Billing"><bpmn:categoryValue id="Value_Billing" value="Billing" /></bpmn:category>
  <bpmn:process id="Process_Groups" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Groups">
      <bpmn:lane id="Lane_Used"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Empty" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Invoice" name="Invoice" categoryValueRef="Value_Billing"><bpmn:incoming>Flow_1</bpmn:incoming></bpmn:task>
    <bpmn:task id="Boxed" name="Boxed" />
    <bpmn:task id="Stray" name="Stray" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Invoice" />
    <bpmn:group id="Group_Category" categoryValueRef="Value_Billing" />
    <bpmn:group id="Group_Box" />
    <bpmn:group id="Group_Nothing" />
  </bpmn:process>
  <bpmn:process id="Process_Empty" isExecutable="false" />
  <bpmndi:BPMNDiagram id="Diagram_Groups">
    <bpmndi:BPMNPlane id="Plane_Groups" bpmnElement="Process_Groups">
      <bpmndi:BPMNShape id="Shape_Boxed" bpmnElement="Boxed"><dc:Bounds x="100" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Box" bpmnElement="Group_Box"><dc:Bounds x="80" y="80" width="200" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Nothing" bpmnElement="Group_Nothing"><dc:Bounds x="600" y="80" width="100" height="100" /></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="process">
    <bpmn:task id="task_a" />
    <bpmn:task id="task_b" />
    <bpmn:task id="task_c" />
    <bpmn:task id="task_d" />
    <bpmn:sequenceFlow id="flow_backwards" sourceRef="task_a" targetRef="task_b" />
    <bpmn:sequenceFlow id="flow_on" sourceRef="task_c" targetRef="task_d" />
    <bpmn:sequenceFlow id="flow_back" sourceRef="task_d" targetRef="task_c" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="task_a_di" bpmnElement="task_a"><dc:Bounds x="400" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_b_di" bpmnElement="task_b"><dc:Bounds x="100" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_c_di" bpmnElement="task_c"><dc:Bounds x="400" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_d_di" bpmnElement="task_d"><dc:Bounds x="100" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_backwards_di" bpmnElement="flow_backwards"><di:waypoint x="400" y="140" /><di:waypoint x="200" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_on_di" bpmnElement="flow_on"><di:waypoint x="450" y="300" /><di:waypoint x="450" y="250" /><di:waypoint x="150" y="250" /><di:waypoint x="150" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_back_di" bpmnElement="flow_back"><di:waypoint x="200" y="340" /><di:waypoint x="400" y="340" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

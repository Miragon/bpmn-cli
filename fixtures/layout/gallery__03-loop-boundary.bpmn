<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_LoopAndBoundary" name="Loop and boundary" isExecutable="true">
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_OrderReceived" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_CheckOrder" name="Check order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_2Days" name="2 days" cancelActivity="false" attachedToRef="Activity_CheckOrder">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_RemindClerk" name="Remind clerk">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Reminded" name="Reminded">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_RemindClerk" targetRef="Event_Reminded" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_2Days" targetRef="Activity_RemindClerk" />
    <bpmn:exclusiveGateway id="Gateway_OrderOk" name="Order ok?" default="Flow_6">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_ReserveStock" name="Reserve stock">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_OutOfStock" name="Out of stock" attachedToRef="Activity_ReserveStock">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_OutOfStock" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_OrderFailed" name="Order failed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_OutOfStock" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_OutOfStock" targetRef="Event_OrderFailed" />
    <bpmn:serviceTask id="Activity_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_OrderShipped" name="Order shipped">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_ShipOrder" targetRef="Event_OrderShipped" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_ReserveStock" targetRef="Activity_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gateway_OrderOk" targetRef="Activity_ReserveStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_ClarifyOrder" name="Clarify order">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_ClarifyOrder" targetRef="Activity_CheckOrder" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gateway_OrderOk" targetRef="Activity_ClarifyOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_CheckOrder" targetRef="Gateway_OrderOk" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_OrderReceived" targetRef="Activity_CheckOrder" />
  </bpmn:process>
  <bpmn:message id="Message_OrderReceived" name="OrderReceived" />
  <bpmn:error id="Error_OutOfStock" name="OutOfStock" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_LoopAndBoundary">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_LoopAndBoundary" bpmnElement="Process_LoopAndBoundary">
      <bpmndi:BPMNShape id="BPMNShape_Event_OrderReceived" bpmnElement="Event_OrderReceived">
        <dc:Bounds x="80" y="121" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="53" y="163" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_CheckOrder" bpmnElement="Activity_CheckOrder">
        <dc:Bounds x="176" y="99" width="100" height="80" />

        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_RemindClerk" bpmnElement="Activity_RemindClerk">
        <dc:Bounds x="336" y="494" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Reminded" bpmnElement="Event_Reminded">
        <dc:Bounds x="528" y="516" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="516" y="558" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_OrderOk" bpmnElement="Gateway_OrderOk" isMarkerVisible="true">
        <dc:Bounds x="361" y="114" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="353" y="94" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_ReserveStock" bpmnElement="Activity_ReserveStock">
        <dc:Bounds x="496" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_OutOfStock" bpmnElement="Event_OutOfStock">
        <dc:Bounds x="553" y="161" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="593" y="183" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_OrderFailed" bpmnElement="Event_OrderFailed">
        <dc:Bounds x="688" y="258" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="662" y="300" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_ShipOrder" bpmnElement="Activity_ShipOrder">
        <dc:Bounds x="656" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_OrderShipped" bpmnElement="Event_OrderShipped">
        <dc:Bounds x="816" y="121" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="789" y="163" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_ClarifyOrder" bpmnElement="Activity_ClarifyOrder">
        <dc:Bounds x="496" y="354" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="436" y="534" />
        <di:waypoint x="528" y="534" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="251" y="197" />
        <di:waypoint x="251" y="534" />
        <di:waypoint x="336" y="534" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="571" y="197" />
        <di:waypoint x="571" y="276" />
        <di:waypoint x="688" y="276" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="756" y="139" />
        <di:waypoint x="816" y="139" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">

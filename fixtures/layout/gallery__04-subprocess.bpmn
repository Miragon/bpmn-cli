<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Subprocesses" name="Subprocesses" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_Payment" name="Payment">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="Event_PayStart" name="Pay start">
        <bpmn:outgoing>Flow_3</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_ChargeCard" name="Charge card">
        <bpmn:incoming>Flow_9</bpmn:incoming>
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_ChargeCard" targetRef="Gateway_Charged" />
      <bpmn:exclusiveGateway id="Gateway_Charged" name="Charged?" default="Flow_5">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Activity_RetryManually" name="Retry manually">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_RetryManually" targetRef="Gateway_Charged_join" />
      <bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Gateway_Charged" targetRef="Activity_RetryManually" />
      <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gateway_Charged" targetRef="Gateway_Charged_join">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=charged</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_PayStart" targetRef="Activity_FraudCheck" />
      <bpmn:subProcess id="Activity_FraudCheck" name="Fraud check">
        <bpmn:incoming>Flow_3</bpmn:incoming>
        <bpmn:outgoing>Flow_9</bpmn:outgoing>
        <bpmn:startEvent id="Event_FcStart" name="Fc start">
          <bpmn:outgoing>Flow_10</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:businessRuleTask id="Activity_ScoreCustomer" name="Score customer">
          <bpmn:incoming>Flow_10</bpmn:incoming>
          <bpmn:outgoing>Flow_11</bpmn:outgoing>
        </bpmn:businessRuleTask>
        <bpmn:endEvent id="Event_FcDone" name="Fc done">
          <bpmn:incoming>Flow_11</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_ScoreCustomer" targetRef="Event_FcDone" />
        <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_FcStart" targetRef="Activity_ScoreCustomer" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_FraudCheck" targetRef="Activity_ChargeCard" />
      <bpmn:exclusiveGateway id="Gateway_Charged_join">
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:incoming>Flow_7</bpmn:incoming>
        <bpmn:outgoing>Flow_8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_Paid" name="Paid">
        <bpmn:incoming>Flow_8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Charged_join" targetRef="Event_Paid" />
      <bpmn:subProcess id="Activity_HandlePaymentErrors" name="Handle payment errors" triggeredByEvent="true">
        <bpmn:startEvent id="Event_1">
          <bpmn:outgoing>Flow_12</bpmn:outgoing>
          <bpmn:errorEventDefinition errorRef="Error_PaymentFailed" />
        </bpmn:startEvent>
        <bpmn:userTask id="Activity_InformCustomer" name="Inform customer">
          <bpmn:incoming>Flow_12</bpmn:incoming>
          <bpmn:outgoing>Flow_13</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="Event_Handled" name="Handled">
          <bpmn:incoming>Flow_13</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_InformCustomer" targetRef="Event_Handled" />
        <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_1" targetRef="Activity_InformCustomer" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Payment" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Payment" />
  </bpmn:process>
  <bpmn:error id="Error_PaymentFailed" name="PaymentFailed" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Subprocesses">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Subprocesses" bpmnElement="Process_Subprocesses">
      <bpmndi:BPMNShape id="BPMNShape_Event_Start" bpmnElement="Event_Start">

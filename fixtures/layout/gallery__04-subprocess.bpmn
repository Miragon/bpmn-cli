          <dc:Bounds x="1256" y="227" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_HandlePaymentErrors" bpmnElement="Activity_HandlePaymentErrors" isExpanded="true">

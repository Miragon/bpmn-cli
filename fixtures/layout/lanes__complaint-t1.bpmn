<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Reklamationsbearbeitung" name="Reklamationsbearbeitung" processRef="Process_Reklamationsbearbeitung" />
    <bpmn:participant id="Participant_Kunde" name="Kunde" />
    <bpmn:messageFlow id="Flow_23" name="Reklamation (E-Mail)" sourceRef="Participant_Kunde" targetRef="Event_ReklamationPerEMailEingegangen" />
    <bpmn:messageFlow id="Flow_24" name="Rückfrage" sourceRef="Activity_FehlendeAngabenAnfordern" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Flow_25" name="Fehlende Angaben" sourceRef="Participant_Kunde" targetRef="Activity_RueckmeldungAbwarten" messageRef="Message_FehlendeAngaben" />
    <bpmn:messageFlow id="Flow_26" name="Ablehnung" sourceRef="Activity_Ablehnungsschreiben" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="Flow_27" name="Ersatzware" sourceRef="Activity_ErsatzVersenden" targetRef="Participant_Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Reklamationsbearbeitung" name="Reklamationsbearbeitung" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Kundenservice" name="Kundenservice">
        <bpmn:flowNodeRef>Event_ReklamationPerEMailEingegangen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReklamationErfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_VollstaendigkeitPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Vollstaendig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_FehlendeAngabenAnfordern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RueckmeldungAbwarten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_FristAbgelaufen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReklamationGeschlossen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Ablehnungsschreiben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReklamationAbgelehnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Eskalieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Eskaliert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PruefungJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Qualitaetsmanagement" name="Qualitätsmanagement">
        <bpmn:flowNodeRef>Activity_Maengelanalyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_KulanzPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Kulanz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ErsatzFork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistik" name="Logistik">
        <bpmn:flowNodeRef>Activity_ErsatzVersenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ErsatzJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ErsatzGeliefert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_VersandFehlgeschlagen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buchhaltung" name="Buchhaltung">
        <bpmn:flowNodeRef>Activity_BetragErstatten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_BetragErstattet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GutschriftBuchen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_ReklamationPerEMailEingegangen" name="Reklamation per E-Mail eingegangen">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Reklamation" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_ReklamationErfassen" name="Reklamation erfassen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_VollstaendigkeitPruefen" name="Vollständigkeit prüfen">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Vollstaendig" name="Reklamation vollständig?" default="Flow_4">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Activity_Maengelanalyse" name="Mängelanalyse">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="maengelanalyse" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="Activity_KulanzPruefen" name="Kulanz prüfen">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="kulanz-regeln" resultVariable="kulanzErgebnis" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_KulanzPruefen" targetRef="Gateway_Kulanz" />
    <bpmn:exclusiveGateway id="Gateway_Kulanz" name="Kulanzentscheidung?" default="Flow_14">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_ErsatzFork">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_ErsatzVersenden" name="Ersatz versenden">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_VersandFehlgeschlagen" name="Versand fehlgeschlagen" attachedToRef="Activity_ErsatzVersenden">
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Versandfehler" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Activity_Eskalieren" name="An Teamleitung eskalieren">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_Eskaliert" name="Eskaliert">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Activity_Eskalieren" targetRef="Event_Eskaliert" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Event_VersandFehlgeschlagen" targetRef="Activity_Eskalieren" />
    <bpmn:parallelGateway id="Gateway_ErsatzJoin">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Event_ErsatzGeliefert" name="Ersatz geliefert">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_ErsatzJoin" targetRef="Event_ErsatzGeliefert" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Activity_ErsatzVersenden" targetRef="Gateway_ErsatzJoin" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_ErsatzFork" targetRef="Activity_ErsatzVersenden" />
    <bpmn:serviceTask id="Activity_GutschriftBuchen" name="Gutschrift buchen">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Activity_GutschriftBuchen" targetRef="Gateway_ErsatzJoin" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_ErsatzFork" targetRef="Activity_GutschriftBuchen" />
    <bpmn:sequenceFlow id="Flow_11" name="Ersatzlieferung" sourceRef="Gateway_Kulanz" targetRef="Gateway_ErsatzFork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kulanzErgebnis = "ersatz"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_BetragErstatten" name="Betrag erstatten">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_BetragErstattet" name="Betrag erstattet">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_BetragErstatten" targetRef="Event_BetragErstattet" />
    <bpmn:sequenceFlow id="Flow_12" name="Erstattung" sourceRef="Gateway_Kulanz" targetRef="Activity_BetragErstatten">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kulanzErgebnis = "erstattung"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="Activity_Ablehnungsschreiben" name="Ablehnungsschreiben senden">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_ReklamationAbgelehnt" name="Reklamation abgelehnt">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Activity_Ablehnungsschreiben" targetRef="Event_ReklamationAbgelehnt" />
    <bpmn:sequenceFlow id="Flow_14" name="Ablehnung" sourceRef="Gateway_Kulanz" targetRef="Activity_Ablehnungsschreiben" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Maengelanalyse" targetRef="Activity_KulanzPruefen" />
    <bpmn:sequenceFlow id="Flow_4" name="ja" sourceRef="Gateway_Vollstaendig" targetRef="Activity_Maengelanalyse" />
    <bpmn:sendTask id="Activity_FehlendeAngabenAnfordern" name="Fehlende Angaben anfordern">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_RueckmeldungAbwarten" name="Rückmeldung abwarten">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Event_FristAbgelaufen" name="5 Tage ohne Antwort" attachedToRef="Activity_RueckmeldungAbwarten">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_ReklamationGeschlossen" name="Reklamation geschlossen">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_FristAbgelaufen" targetRef="Event_ReklamationGeschlossen" />
    <bpmn:sequenceFlow id="Flow_7" name="Angaben erhalten" sourceRef="Activity_RueckmeldungAbwarten" targetRef="Gateway_PruefungJoin" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_FehlendeAngabenAnfordern" targetRef="Activity_RueckmeldungAbwarten" />
    <bpmn:sequenceFlow id="Flow_5" name="nein" sourceRef="Gateway_Vollstaendig" targetRef="Activity_FehlendeAngabenAnfordern">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vollstaendig = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_VollstaendigkeitPruefen" targetRef="Gateway_Vollstaendig" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_ReklamationErfassen" targetRef="Gateway_PruefungJoin" />
    <bpmn:exclusiveGateway id="Gateway_PruefungJoin">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_PruefungJoin" targetRef="Activity_VollstaendigkeitPruefen" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_ReklamationPerEMailEingegangen" targetRef="Activity_ReklamationErfassen" />
    <bpmn:textAnnotation id="TextAnnotation_Fristen">
      <bpmn:text>offen: Fristen klären</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="TextAnnotation_Fristen" targetRef="Event_FristAbgelaufen" />
  </bpmn:process>

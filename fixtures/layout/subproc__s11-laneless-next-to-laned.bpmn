<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Vendor" name="Vendor" processRef="Process_Main" />
    <bpmn:participant id="Participant_Buyer" name="Buyer" processRef="Process_Buyer" />
    <bpmn:messageFlow id="Flow_8" name="RFQ" sourceRef="Activity_RequestQuote" targetRef="Participant_Vendor" />
    <bpmn:messageFlow id="Flow_9" name="Quote" sourceRef="Activity_SendQuote" targetRef="Activity_EvaluateQuote" />
    <bpmn:messageFlow id="Flow_10" name="PO" sourceRef="Activity_SendPO" targetRef="Activity_ReceivePO" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="s11-laneless-next-to-laned" isExecutable="true">
    <bpmn:startEvent id="Event_VendorStart" name="Vendor start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_SendQuote" name="Send quote">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_ReceivePO" name="Receive PO">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_VendorDone" name="Vendor done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_ReceivePO" targetRef="Event_VendorDone" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_SendQuote" targetRef="Activity_ReceivePO" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_VendorStart" targetRef="Activity_SendQuote" />
  </bpmn:process>
  <bpmn:process id="Process_Buyer" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Purchasing" name="Purchasing">
        <bpmn:flowNodeRef>Event_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RequestQuote</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Activity_EvaluateQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SendPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Ordered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Need" name="Need">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_RequestQuote" name="Request quote">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_EvaluateQuote" name="Evaluate quote">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Activity_SendPO" name="Send PO">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Ordered" name="Ordered">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_SendPO" targetRef="Event_Ordered" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_EvaluateQuote" targetRef="Activity_SendPO" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_RequestQuote" targetRef="Activity_EvaluateQuote" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_Need" targetRef="Activity_RequestQuote" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="BPMNShape_Participant_Vendor" bpmnElement="Participant_Vendor" isHorizontal="true">

  <bpmn:process id="Process_Main" name="s14-collapsed-rich" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_Fulfil" name="Fulfil">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="Event_FStart" name="F start">
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_Pick" name="Pick">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:incoming>Flow_9</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Activity_Pack" name="Pack">
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="Event_Slow" name="Slow" cancelActivity="false" attachedToRef="Activity_Pack">
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="Activity_Warn" name="Warn">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="Event_Warned" name="Warned">
        <bpmn:incoming>Flow_11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_Warn" targetRef="Event_Warned" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_Slow" targetRef="Activity_Warn" />
      <bpmn:exclusiveGateway id="Gateway_Complete" name="Complete?">
        <bpmn:incoming>Flow_7</bpmn:incoming>
        <bpmn:outgoing>Flow_8</bpmn:outgoing>
        <bpmn:outgoing>Flow_9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_FDone" name="F done">
        <bpmn:incoming>Flow_8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gateway_Complete" targetRef="Event_FDone" />
      <bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="Gateway_Complete" targetRef="Activity_Pick" />
      <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Pack" targetRef="Gateway_Complete" />
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Pick" targetRef="Activity_Pack" />
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_FStart" targetRef="Activity_Pick" />
      <bpmn:subProcess id="Activity_ChangeReq" name="Change request" triggeredByEvent="true">
        <bpmn:startEvent id="Event_1" isInterrupting="false">
          <bpmn:outgoing>Flow_12</bpmn:outgoing>
          <bpmn:messageEventDefinition messageRef="Message_Change" />
        </bpmn:startEvent>
        <bpmn:userTask id="Activity_ApplyChange" name="Apply change">
          <bpmn:incoming>Flow_12</bpmn:incoming>
          <bpmn:outgoing>Flow_13</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:endEvent id="Event_Changed" name="Changed">
          <bpmn:incoming>Flow_13</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_ApplyChange" targetRef="Event_Changed" />
        <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_1" targetRef="Activity_ApplyChange" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_FulfilFailed" name="Fulfil failed" attachedToRef="Activity_Fulfil">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_FulfilError" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Activity_HandleFailure" name="Handle failure">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_Failed" name="Failed">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_HandleFailure" targetRef="Event_Failed" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_FulfilFailed" targetRef="Activity_HandleFailure" />
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Fulfil" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Fulfil" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Claims" name="Claims" isExecutable="true">
    <bpmn:startEvent id="Event_ClaimReceived" name="Claim received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_RegisterClaim" name="Register claim">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_RegisterClaim" targetRef="Gateway_ClaimType" />
    <bpmn:exclusiveGateway id="Gateway_ClaimType" name="Claim type?" default="Flow_8">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_FetchCarData" name="Fetch car data">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_AssessCarDamage" name="Assess car damage">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_AssessCarDamage" targetRef="Gateway_ClaimType_join" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_FetchCarData" targetRef="Activity_AssessCarDamage" />
    <bpmn:sequenceFlow id="Flow_3" name="car" sourceRef="Gateway_ClaimType" targetRef="Activity_FetchCarData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=type="car"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_ScheduleInspection" name="Schedule inspection">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_InspectHouse" name="Inspect house">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_7Days" name="7 days" cancelActivity="false" attachedToRef="Activity_InspectHouse">
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_EscalateToManager" name="Escalate to manager">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Escalated" name="Escalated">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Activity_EscalateToManager" targetRef="Event_Escalated" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Event_7Days" targetRef="Activity_EscalateToManager" />
    <bpmn:businessRuleTask id="Activity_EstimateHouseDamage" name="Estimate house damage">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_EstimateHouseDamage" targetRef="Gateway_ClaimType_join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_InspectHouse" targetRef="Activity_EstimateHouseDamage" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_ScheduleInspection" targetRef="Activity_InspectHouse" />
    <bpmn:sequenceFlow id="Flow_5" name="house" sourceRef="Gateway_ClaimType" targetRef="Activity_ScheduleInspection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=type="house"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_ManualAssessment" name="Manual assessment">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_ManualAssessment" targetRef="Gateway_ClaimType_join" />
    <bpmn:sequenceFlow id="Flow_8" name="other" sourceRef="Gateway_ClaimType" targetRef="Activity_ManualAssessment" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_ClaimReceived" targetRef="Activity_RegisterClaim" />
    <bpmn:exclusiveGateway id="Gateway_ClaimType_join">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_ClaimType_join" targetRef="Gateway_1" />
    <bpmn:parallelGateway id="Gateway_1">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_CalculatePayout" name="Calculate payout">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Activity_CalculatePayout" targetRef="Gateway_1_join" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_1" targetRef="Activity_CalculatePayout" />
    <bpmn:userTask id="Activity_CheckFraudIndicators" name="Check fraud indicators">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_CheckFraudIndicators" targetRef="Gateway_1_join" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_1" targetRef="Activity_CheckFraudIndicators" />
    <bpmn:parallelGateway id="Gateway_1_join">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Approve" name="Approve?" default="Flow_20">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_PayOut" name="Pay out">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_ClaimSettled" name="Claim settled">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Activity_PayOut" targetRef="Event_ClaimSettled" />
    <bpmn:sequenceFlow id="Flow_18" name="yes" sourceRef="Gateway_Approve" targetRef="Activity_PayOut">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_ReworkAssessment" name="Rework assessment">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Activity_ReworkAssessment" targetRef="Gateway_ClaimType_join" />
    <bpmn:sequenceFlow id="Flow_20" name="no" sourceRef="Gateway_Approve" targetRef="Activity_ReworkAssessment" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_1_join" targetRef="Gateway_Approve" />
  </bpmn:process>

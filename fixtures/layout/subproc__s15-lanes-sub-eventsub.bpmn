<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Shop" name="Shop" processRef="Process_Main" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="s15-lanes-sub-eventsub" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_CS" name="Customer service">
        <bpmn:flowNodeRef>Event_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Inform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Informed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WH" name="Warehouse">
        <bpmn:flowNodeRef>Activity_Fulfilment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Overdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_OrderError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_TakeOrder" name="Take order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:targetRef>DataObjectReference_Order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:subProcess id="Activity_Fulfilment" name="Fulfilment">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:startEvent id="Event_FStart" name="F start">
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_Pick" name="Pick">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_Pack" name="Pack">
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_FDone" name="F done">
        <bpmn:incoming>Flow_7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Pack" targetRef="Event_FDone" />
      <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Pick" targetRef="Activity_Pack" />
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_FStart" targetRef="Activity_Pick" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_Overdue" name="Overdue" cancelActivity="false" attachedToRef="Activity_Fulfilment">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_Inform" name="Inform customer">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_Informed" name="Informed">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Inform" targetRef="Event_Informed" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_Overdue" targetRef="Activity_Inform" />
    <bpmn:userTask id="Activity_Confirm" name="Confirm">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Confirm" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Fulfilment" targetRef="Activity_Confirm" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_TakeOrder" targetRef="Activity_Fulfilment" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_TakeOrder" />
    <bpmn:subProcess id="Activity_OrderError" name="Order error" triggeredByEvent="true">
      <bpmn:startEvent id="Event_1">
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
        <bpmn:errorEventDefinition errorRef="Error_OrderError" />
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_FixOrder" name="Fix order">
        <bpmn:incoming>Flow_10</bpmn:incoming>
        <bpmn:outgoing>Flow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_Fixed" name="Fixed">
        <bpmn:incoming>Flow_11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_FixOrder" targetRef="Event_Fixed" />
      <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_1" targetRef="Activity_FixOrder" />
    </bpmn:subProcess>
    <bpmn:dataObject id="DataObject_Order" />
    <bpmn:dataObjectReference id="DataObjectReference_Order" name="Order" dataObjectRef="DataObject_Order" />
    <bpmn:textAnnotation id="TextAnnotation_Note">
      <bpmn:text>Orders arrive by phone or web</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="TextAnnotation_Note" targetRef="Activity_TakeOrder" />
  </bpmn:process>
  <bpmn:error id="Error_OrderError" name="OrderError" />

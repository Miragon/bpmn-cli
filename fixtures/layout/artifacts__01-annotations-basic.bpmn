<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Ann" name="Annotations basic" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Check" name="Check order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Ok" name="Order ok?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_Book" name="Book order">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Book" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_Yes" name="yes" sourceRef="Gateway_Ok" targetRef="Activity_Book" />
    <bpmn:userTask id="Activity_Reject" name="Reject order">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_Rejected" name="Rejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Reject" targetRef="Event_Rejected" />
    <bpmn:sequenceFlow id="Flow_No" name="no" sourceRef="Gateway_Ok" targetRef="Activity_Reject" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Check" targetRef="Gateway_Ok" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Check" />
    <bpmn:textAnnotation id="TextAnnotation_Task">
      <bpmn:text>Checked manually by the back office</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Gw">
      <bpmn:text>Decision based on credit score</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Start">
      <bpmn:text>Triggered by web shop</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Flow">
      <bpmn:text>Only when amount &lt; 1000</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="TextAnnotation_Task" targetRef="Activity_Check" />
    <bpmn:association id="Association_2" sourceRef="TextAnnotation_Gw" targetRef="Gateway_Ok" />
    <bpmn:association id="Association_3" sourceRef="TextAnnotation_Start" targetRef="Event_Start" />
    <bpmn:association id="Association_4" sourceRef="TextAnnotation_Flow" targetRef="Flow_Yes" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Ann">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Ann" bpmnElement="Process_Ann">
      <bpmndi:BPMNShape id="BPMNShape_Event_Start" bpmnElement="Event_Start">
        <dc:Bounds x="80" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="53" y="234" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Check" bpmnElement="Activity_Check">
        <dc:Bounds x="176" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_Ok" bpmnElement="Gateway_Ok" isMarkerVisible="true">
        <dc:Bounds x="336" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="328" y="165" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Book" bpmnElement="Activity_Book">
        <dc:Bounds x="446" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Done" bpmnElement="Event_Done">
        <dc:Bounds x="606" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="608" y="234" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Reject" bpmnElement="Activity_Reject">
        <dc:Bounds x="446" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Rejected" bpmnElement="Event_Rejected">
        <dc:Bounds x="606" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="594" y="374" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="546" y="120" />
        <di:waypoint x="606" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Yes" bpmnElement="Flow_Yes">
        <di:waypoint x="386" y="120" />
        <di:waypoint x="446" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="102" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="546" y="260" />
        <di:waypoint x="606" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_No" bpmnElement="Flow_No">
        <di:waypoint x="361" y="145" />
        <di:waypoint x="361" y="260" />
        <di:waypoint x="446" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="369" y="242" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="276" y="120" />
        <di:waypoint x="336" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="176" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TextAnnotation_Task" bpmnElement="TextAnnotation_Task">
        <dc:Bounds x="86" y="80" width="280" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Association_1" bpmnElement="Association_1">
        <di:waypoint x="226" y="110" />
        <di:waypoint x="226" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TextAnnotation_Gw" bpmnElement="TextAnnotation_Gw">
        <dc:Bounds x="501" y="80" width="240" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Association_2" bpmnElement="Association_2">
        <di:waypoint x="587" y="110" />
        <di:waypoint x="386" y="199" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TextAnnotation_Start" bpmnElement="TextAnnotation_Start">
        <dc:Bounds x="960" y="80" width="200" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Association_3" bpmnElement="Association_3">
        <di:waypoint x="960" y="107" />
        <di:waypoint x="116" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_TextAnnotation_Flow" bpmnElement="TextAnnotation_Flow">
        <dc:Bounds x="1196" y="80" width="200" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Association_4" bpmnElement="Association_4">
        <di:waypoint x="1196" y="98" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

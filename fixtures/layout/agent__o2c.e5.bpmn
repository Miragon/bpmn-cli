<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud">
  <bpmn:process id="Process_OrderToCash" name="Order to cash" isExecutable="true">
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_ValidateOrder" name="Validate order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OrderValid" name="Order valid?" default="Flow_4">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_CheckCredit" name="Check credit">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="Gateway_CreditOk" name="Credit ok?" default="Flow_7">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Fork">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_PickAndPack" name="Pick and pack">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_ShipGoods" name="Ship goods">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_SendInvoice" name="Send invoice">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="Event_NoPaymentAfter14d" name="No payment after 14d" cancelActivity="false" attachedToRef="Activity_SendInvoice">
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_SendReminder" name="Send reminder">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Activity_SendReminder" targetRef="Event_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Event_NoPaymentAfter14d" targetRef="Activity_SendReminder" />
    <bpmn:intermediateCatchEvent id="Event_PaymentReceived" name="Payment received">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PaymentReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_OrderCompleted" name="Order completed">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Event_PaymentReceived" targetRef="Event_OrderCompleted" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_SendInvoice" targetRef="Event_PaymentReceived" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_ShipGoods" targetRef="Activity_SendInvoice" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Join" targetRef="Activity_ShipGoods" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_PickAndPack" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Fork" targetRef="Activity_PickAndPack" />
    <bpmn:serviceTask id="Activity_CreateInvoice" name="Create invoice">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_CreateInvoice" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Fork" targetRef="Activity_CreateInvoice" />
    <bpmn:sequenceFlow id="Flow_7" name="not ok" sourceRef="Gateway_CreditOk" targetRef="Activity_RequestPrepayment" />
    <bpmn:sequenceFlow id="Flow_6" name="ok" sourceRef="Gateway_CreditOk" targetRef="Gateway_Fork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditOk}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_RequestPrepayment" name="Request prepayment">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_17" name="prepaid" sourceRef="Activity_RequestPrepayment" targetRef="Activity_WaitForPrepayment" />
    <bpmn:serviceTask id="Activity_WaitForPrepayment" name="Wait for prepayment">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Activity_WaitForPrepayment" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_21" name="re-check" sourceRef="Activity_WaitForPrepayment" targetRef="Activity_CheckCredit" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_CheckCredit" targetRef="Gateway_CreditOk" />
    <bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gateway_OrderValid" targetRef="Activity_CheckCredit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_OrderRejected" name="Order rejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gateway_OrderValid" targetRef="Event_OrderRejected" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_ValidateOrder" targetRef="Gateway_OrderValid" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_OrderReceived" targetRef="Activity_ValidateOrder" />
  </bpmn:process>
  <bpmn:message id="Message_PaymentReceived" name="PaymentReceived" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_OrderToCash">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_OrderToCash" bpmnElement="Process_OrderToCash">

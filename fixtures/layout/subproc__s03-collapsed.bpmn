  <bpmn:process id="Process_Main" name="s03-collapsed" isExecutable="true">
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Prepare" name="Prepare">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="Activity_Ship" name="Ship">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:startEvent id="Event_ShipStart" name="Ship start">
        <bpmn:outgoing>Flow_4</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Activity_Pack" name="Pack">
        <bpmn:incoming>Flow_4</bpmn:incoming>
        <bpmn:outgoing>Flow_5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_Pack" targetRef="Gateway_Express" />
      <bpmn:exclusiveGateway id="Gateway_Express" name="Express?">
        <bpmn:incoming>Flow_5</bpmn:incoming>
        <bpmn:outgoing>Flow_6</bpmn:outgoing>
        <bpmn:outgoing>Flow_7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Activity_Courier" name="Courier">
        <bpmn:incoming>Flow_6</bpmn:incoming>
        <bpmn:outgoing>Flow_8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_Courier" targetRef="Gateway_Express_join" />
      <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gateway_Express" targetRef="Activity_Courier" />
      <bpmn:serviceTask id="Activity_Post" name="Post">
        <bpmn:incoming>Flow_7</bpmn:incoming>
        <bpmn:outgoing>Flow_9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Post" targetRef="Gateway_Express_join" />
      <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gateway_Express" targetRef="Activity_Post" />
      <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_ShipStart" targetRef="Activity_Pack" />
      <bpmn:exclusiveGateway id="Gateway_Express_join">
        <bpmn:incoming>Flow_8</bpmn:incoming>
        <bpmn:incoming>Flow_9</bpmn:incoming>
        <bpmn:outgoing>Flow_10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_Shipped" name="Shipped">
        <bpmn:incoming>Flow_10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Express_join" targetRef="Event_Shipped" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_Late" name="3 days" attachedToRef="Activity_Ship">
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_Apologise" name="Apologise">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_LateEnd" name="Late">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_Apologise" targetRef="Event_LateEnd" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_Late" targetRef="Activity_Apologise" />
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Ship" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Prepare" targetRef="Activity_Ship" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Prepare" />
  </bpmn:process>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Main" name="s10-nested-lanes" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Front" name="Front office">
        <bpmn:flowNodeRef>Event_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Back" name="Back office">
        <bpmn:childLaneSet id="LaneSet_2">
          <bpmn:lane id="Lane_Accounting" name="Accounting">
            <bpmn:flowNodeRef>Activity_Book</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Gateway_NeedsHR</bpmn:flowNodeRef>
          </bpmn:lane>
          <bpmn:lane id="Lane_HR" name="HR">
            <bpmn:flowNodeRef>Activity_CheckHR</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_Receive" name="Receive">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_Book" name="Book">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_NeedsHR" name="Needs HR?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_CheckHR" name="Check HR">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_Reply" name="Reply">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_Done" name="Done">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Reply" targetRef="Event_Done" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_CheckHR" targetRef="Activity_Reply" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gateway_NeedsHR" targetRef="Activity_CheckHR" />
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gateway_NeedsHR" targetRef="Activity_Reply" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Book" targetRef="Gateway_NeedsHR" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Receive" targetRef="Activity_Book" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_Receive" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Main">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Main" bpmnElement="Process_Main">
      <bpmndi:BPMNShape id="BPMNShape_Lane_Front" bpmnElement="Lane_Front" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="1002" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_Back" bpmnElement="Lane_Back" isHorizontal="true">
        <dc:Bounds x="80" y="220" width="1002" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_Accounting" bpmnElement="Lane_Accounting" isHorizontal="true">
        <dc:Bounds x="110" y="220" width="972" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_HR" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="110" y="360" width="972" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Start" bpmnElement="Event_Start">
        <dc:Bounds x="170" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="169" y="174" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Receive" bpmnElement="Activity_Receive">
        <dc:Bounds x="266" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Book" bpmnElement="Activity_Book">
        <dc:Bounds x="426" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_NeedsHR" bpmnElement="Gateway_NeedsHR" isMarkerVisible="true">
        <dc:Bounds x="586" y="265" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="245" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_CheckHR" bpmnElement="Activity_CheckHR">
        <dc:Bounds x="696" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_Reply" bpmnElement="Activity_Reply">
        <dc:Bounds x="856" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_Done" bpmnElement="Event_Done">
        <dc:Bounds x="1016" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1018" y="174" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="956" y="150" />
        <di:waypoint x="1016" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="796" y="430" />
        <di:waypoint x="906" y="430" />
        <di:waypoint x="906" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="611" y="315" />
        <di:waypoint x="611" y="430" />
        <di:waypoint x="696" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="619" y="412" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="636" y="290" />
        <di:waypoint x="906" y="290" />
        <di:waypoint x="906" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="644" y="272" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="526" y="290" />
        <di:waypoint x="586" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="316" y="190" />
        <di:waypoint x="316" y="290" />
        <di:waypoint x="426" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="206" y="150" />
        <di:waypoint x="266" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

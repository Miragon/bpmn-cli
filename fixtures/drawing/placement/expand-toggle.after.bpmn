        <bpmn:incoming>flow_fzs5sToFzs5i</bpmn:incoming>
        <bpmn:outgoing>flow_fzs5iToFzs5e</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:endEvent id="Event_Fzs5e" name="Fzs5 end">
        <bpmn:incoming>flow_fzs5iToFzs5e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_fzs5iToFzs5e" sourceRef="Activity_Fzs5i" targetRef="Event_Fzs5e"/>
      <bpmn:sequenceFlow id="flow_fzs5sToFzs5i" sourceRef="Event_Fzs5s" targetRef="Activity_Fzs5i"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_sToFzs5" sourceRef="S" targetRef="Activity_Fzs5"/>
    <bpmn:task id="A" name="Task A"><bpmn:incoming>flow_fzbh6ToTaskA</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>

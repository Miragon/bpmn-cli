          <dc:Bounds x="607" y="291" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_bookToDone" bpmnElement="flow_bookToDone">
        <di:waypoint x="559" y="127" />
        <di:waypoint x="619" y="127" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_yes" bpmnElement="F_yes">
        <di:waypoint x="399" y="127" />
        <di:waypoint x="459" y="127" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="407" y="109" width="33" height="14" />

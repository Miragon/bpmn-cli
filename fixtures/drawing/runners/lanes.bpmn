<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_p" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collaboration_p">
    <bpmn:participant id="Pool" name="Org" processRef="P" />
  </bpmn:collaboration>
  <bpmn:process id="P" isExecutable="true">
    <bpmn:laneSet id="laneSet_p">
      <bpmn:lane id="L1" name="Clerk">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Boss" />
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Start">
      <bpmn:outgoing>flow_startToCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="A" name="Check">
      <bpmn:incoming>flow_startToCheck</bpmn:incoming>
      <bpmn:outgoing>flow_checkToOk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G" name="ok?">
      <bpmn:incoming>flow_checkToOk</bpmn:incoming>
      <bpmn:outgoing>F_yes</bpmn:outgoing>
      <bpmn:outgoing>F_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B" name="Book">
      <bpmn:incoming>F_yes</bpmn:incoming>
      <bpmn:outgoing>flow_bookToDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E" name="Done">
      <bpmn:incoming>flow_bookToDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_bookToDone" sourceRef="B" targetRef="E" />
    <bpmn:sequenceFlow id="F_yes" name="yes" sourceRef="G" targetRef="B" />
    <bpmn:task id="C" name="Clarify">
      <bpmn:incoming>F_no</bpmn:incoming>
      <bpmn:outgoing>flow_clarifyToStopped</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Stopped">
      <bpmn:incoming>flow_clarifyToStopped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_clarifyToStopped" sourceRef="C" targetRef="E2" />
    <bpmn:sequenceFlow id="F_no" name="no" sourceRef="G" targetRef="C" />
    <bpmn:sequenceFlow id="flow_checkToOk" sourceRef="A" targetRef="G" />
    <bpmn:sequenceFlow id="flow_startToCheck" sourceRef="S" targetRef="A" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_collaboration_p">
    <bpmndi:BPMNPlane id="BPMNPlane_collaboration_p" bpmnElement="collaboration_p">
      <bpmndi:BPMNShape id="BPMNShape_Pool" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="93" y="87" width="695" height="400" />

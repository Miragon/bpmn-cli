        <bpmndi:BPMNLabel>
          <dc:Bounds x="707" y="181" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_C" bpmnElement="C">
        <dc:Bounds x="549" y="257" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_E2" bpmnElement="E2">
        <dc:Bounds x="709" y="279" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="697" y="321" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_bookToDone" bpmnElement="flow_bookToDone">
        <di:waypoint x="649" y="157" />
        <di:waypoint x="709" y="157" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_yes" bpmnElement="F_yes">
        <di:waypoint x="489" y="157" />
        <di:waypoint x="549" y="157" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="497" y="139" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_clarifyToStopped" bpmnElement="flow_clarifyToStopped">
        <di:waypoint x="649" y="297" />
        <di:waypoint x="709" y="297" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F_no" bpmnElement="F_no">

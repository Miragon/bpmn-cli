<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions_p" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collaboration_p">
    <bpmn:participant id="Pool" name="Company" processRef="P" />
  </bpmn:collaboration>
  <bpmn:process id="P" isExecutable="true">
    <bpmn:laneSet id="laneSet_p">
      <bpmn:lane id="Sales" name="Sales">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Overdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reminded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Billing" name="Billing">
        <bpmn:flowNodeRef>Invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Order received">
      <bpmn:outgoing>flow_orderReceivedToCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Check" name="Check order">
      <bpmn:incoming>flow_orderReceivedToCheck</bpmn:incoming>
      <bpmn:outgoing>flow_checkToInvoice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Overdue" name="2 days" cancelActivity="false" attachedToRef="Check">
      <bpmn:outgoing>flow_overdueToRemind</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Remind" name="Remind sales">
      <bpmn:incoming>flow_overdueToRemind</bpmn:incoming>
      <bpmn:outgoing>flow_remindToReminded</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Reminded" name="Sales reminded">
      <bpmn:incoming>flow_remindToReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_remindToReminded" sourceRef="Remind" targetRef="Reminded" />
    <bpmn:sequenceFlow id="flow_overdueToRemind" sourceRef="Overdue" targetRef="Remind" />
    <bpmn:serviceTask id="Invoice" name="Send invoice">
      <bpmn:incoming>flow_checkToInvoice</bpmn:incoming>
      <bpmn:outgoing>flow_invoiceToDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Invoiced">
      <bpmn:incoming>flow_invoiceToDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_invoiceToDone" sourceRef="Invoice" targetRef="Done" />
    <bpmn:sequenceFlow id="flow_checkToInvoice" sourceRef="Check" targetRef="Invoice" />
    <bpmn:sequenceFlow id="flow_orderReceivedToCheck" sourceRef="S" targetRef="Check" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_collaboration_p">
    <bpmndi:BPMNPlane id="BPMNPlane_collaboration_p" bpmnElement="collaboration_p">
      <bpmndi:BPMNShape id="BPMNShape_Pool" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="93" y="87" width="588" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Sales" bpmnElement="Sales" isHorizontal="true">
        <dc:Bounds x="123" y="87" width="558" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Billing" bpmnElement="Billing" isHorizontal="true">
        <dc:Bounds x="123" y="367" width="558" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_S" bpmnElement="S">
        <dc:Bounds x="183" y="267" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="167" y="309" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Check" bpmnElement="Check">
        <dc:Bounds x="279" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Invoice" bpmnElement="Invoice">
        <dc:Bounds x="439" y="497" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Done" bpmnElement="Done">
        <dc:Bounds x="599" y="519" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="583" y="561" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_invoiceToDone" bpmnElement="flow_invoiceToDone">
        <di:waypoint x="539" y="537" />
        <di:waypoint x="599" y="537" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_checkToInvoice" bpmnElement="flow_checkToInvoice">
        <di:waypoint x="329" y="325" />
        <di:waypoint x="329" y="537" />
        <di:waypoint x="439" y="537" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_orderReceivedToCheck" bpmnElement="flow_orderReceivedToCheck">
        <di:waypoint x="219" y="285" />
        <di:waypoint x="279" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_Overdue" bpmnElement="Overdue">
        <dc:Bounds x="336" y="227" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="376" y="229" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Remind" bpmnElement="Remind">
        <dc:Bounds x="439" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Reminded" bpmnElement="Reminded">
        <dc:Bounds x="599" y="124" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="583" y="166" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_overdueToRemind" bpmnElement="flow_overdueToRemind">
        <di:waypoint x="354" y="227" />
        <di:waypoint x="354" y="142" />
        <di:waypoint x="439" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_remindToReminded" bpmnElement="flow_remindToReminded">
        <di:waypoint x="539" y="142" />
        <di:waypoint x="599" y="142" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

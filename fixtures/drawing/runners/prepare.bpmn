        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_shipToShipped" bpmnElement="flow_shipToShipped">
        <di:waypoint x="811" y="342" />
        <di:waypoint x="903" y="342" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow_okToShip" bpmnElement="flow_okToShip">

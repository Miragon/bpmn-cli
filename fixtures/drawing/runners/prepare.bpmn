        <di:waypoint x="315" y="172" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_G" bpmnElement="G" isMarkerVisible="true">
        <dc:Bounds x="601" y="140" width="50" height="50" />
        <bpmndi:BPMNLabel>

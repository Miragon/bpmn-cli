<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_p" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="S" name="Start">
      <bpmn:outgoing>flow_startToSub</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub" name="Prepare">
      <bpmn:incoming>flow_startToSub</bpmn:incoming>
      <bpmn:outgoing>flow_subToOk</bpmn:outgoing>
      <bpmn:startEvent id="S1" name="Begin">
        <bpmn:outgoing>flow_beginToPack</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="T1" name="Pack">
        <bpmn:incoming>flow_beginToPack</bpmn:incoming>
        <bpmn:outgoing>flow_packToPacked</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="E1" name="Packed">
        <bpmn:incoming>flow_packToPacked</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_packToPacked" sourceRef="T1" targetRef="E1" />
      <bpmn:sequenceFlow id="flow_beginToPack" sourceRef="S1" targetRef="T1" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G" name="Ok?">
      <bpmn:incoming>flow_subToOk</bpmn:incoming>
      <bpmn:outgoing>flow_okToShip</bpmn:outgoing>
      <bpmn:outgoing>flow_okToReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="B" name="Ship">
      <bpmn:incoming>flow_okToShip</bpmn:incoming>
      <bpmn:outgoing>flow_shipToShipped</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E" name="Shipped">
      <bpmn:incoming>flow_shipToShipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_shipToShipped" sourceRef="B" targetRef="E" />
    <bpmn:sequenceFlow id="flow_okToShip" name="yes" sourceRef="G" targetRef="B" />
    <bpmn:task id="C" name="Return">
      <bpmn:incoming>flow_okToReturn</bpmn:incoming>
      <bpmn:outgoing>flow_returnToRefund</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C2" name="Refund">
      <bpmn:incoming>flow_returnToRefund</bpmn:incoming>
      <bpmn:outgoing>flow_refundToReturned</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Returned">
      <bpmn:incoming>flow_refundToReturned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_refundToReturned" sourceRef="C2" targetRef="E2" />
    <bpmn:sequenceFlow id="flow_returnToRefund" sourceRef="C" targetRef="C2" />
    <bpmn:sequenceFlow id="flow_okToReturn" name="no" sourceRef="G" targetRef="C" />
    <bpmn:sequenceFlow id="flow_subToOk" sourceRef="Sub" targetRef="G" />
    <bpmn:sequenceFlow id="flow_startToSub" sourceRef="S" targetRef="Sub" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P">
    <bpmndi:BPMNPlane id="BPMNPlane_P" bpmnElement="P">
      <bpmndi:BPMNShape id="BPMNShape_S" bpmnElement="S">
        <dc:Bounds x="93" y="147" width="36" height="36" />

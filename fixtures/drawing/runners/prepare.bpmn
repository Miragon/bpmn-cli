        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_B" bpmnElement="B">
        <dc:Bounds x="711" y="302" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_E" bpmnElement="E">
        <dc:Bounds x="903" y="324" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="891" y="366" width="61" height="14" />

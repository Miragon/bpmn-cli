{
  "name": "@miragon/bpmn-cli",
  "version": "0.8.0",
  "description": "AI-friendly CLI for editing BPMN 2.0 models semantically: agents name elements and operations, never XML or BPMNDI. Keeps hand-made diagrams (incremental layout), redraws engine-owned ones, and offers diagram formatting operations.",
  "type": "module",
  "license": "MIT",
  "author": "Miragon GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/bpmn-cli.git"
  },
  "homepage": "https://github.com/Miragon/bpmn-cli#readme",
  "bugs": {
    "url": "https://github.com/Miragon/bpmn-cli/issues"
  },
  "bin": {
    "bpmn": "bin/bpmn.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./bin/bpmn.js",
    "./dist/cli.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build-types.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knip": "knip",
    "lint": "biome lint",
    "layout:regress": "node tools/layout-regress.mjs",
    "bench": "node tools/bench/run.mjs",
    "bench:summary": "node tools/bench/summary.mjs",
    "fuzz": "node tools/fuzz/run.mjs",
    "check:iso": "node tools/iso/check.mjs",
    "roundtrip": "node tools/roundtrip.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "gate": "npm run build && biome lint && knip && knip --production --exclude dependencies && jscpd && vitest run && node tools/iso/check.mjs && node tools/bench/regress-gate.mjs && node tools/fuzz/run.mjs --walks 12 --steps 15 --seed 1 --hard warn --out tools/fuzz/out/gate",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@miragon/bpmnlint-plugin-rules": "0.14.0",
    "@resvg/resvg-wasm": "2.6.2",
    "bpmn-moddle": "^10.2.0",
    "bpmnlint": "11.15.0",
    "commander": "^15.0.0",
    "moddle": "^8.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.0.0",
    "archunit": "2.5.4",
    "camunda-bpmn-moddle": "8.0.2",
    "esbuild": "^0.28.2",
    "jscpd": "5.4.1",
    "knip": "6.43.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "zeebe-bpmn-moddle": "2.0.0"
  },
  "keywords": [
    "bpmn",
    "bpmn-js",
    "bpmn-moddle",
    "cli",
    "ai",
    "agent",
    "layout"
  ]
}

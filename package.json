{
  "name": "@miragon/bpmn-cli",
  "version": "0.9.0",
  "description": "AI-friendly CLI for editing BPMN 2.0 models semantically: agents name elements and operations, never XML or BPMNDI. Keeps hand-made diagrams (incremental layout), redraws engine-owned ones, and offers diagram formatting operations.",
  "type": "module",
  "license": "MIT",
  "author": "Miragon GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/bpmn-cli.git"
  },
  "homepage": "https://github.com/Miragon/bpmn-cli#readme",
  "bugs": {
    "url": "https://github.com/Miragon/bpmn-cli/issues"
  },
  "bin": {
    "bpmn": "bin/bpmn.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./bin/bpmn.js",
    "./dist/cli.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --packages=external --outfile=dist/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "oracle": "node tools/oracle/run.mjs",
    "oracle:record": "node tools/oracle/record.mjs",
    "oracle:selftest": "node tools/oracle/selftest.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "gate": "npm run typecheck && npm run lint && npm run oracle",
    "prepublishOnly": "npm run build",
    "lint": "biome lint"
  },
  "dependencies": {
    "@miragon/bpmnlint-plugin-rules": "0.19.0",
    "@resvg/resvg-wasm": "2.6.2",
    "bpmn-moddle": "^10.2.0",
    "bpmnlint": "12.0.0",
    "commander": "^15.0.0",
    "moddle": "^8.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@microsoft/api-extractor": "7.60.1",
    "@miragon/bpmn-lint": "0.0.0",
    "@miragon/bpmn-render": "0.0.0",
    "@swc/core": "1.16.20",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "camunda-bpmn-moddle": "8.0.2",
    "dependency-cruiser": "18.7.0",
    "esbuild": "^0.28.2",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "oxc-parser": "0.155.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "zeebe-bpmn-moddle": "2.0.0"
  },
  "keywords": [
    "bpmn",
    "bpmn-js",
    "bpmn-moddle",
    "cli",
    "ai",
    "agent",
    "layout"
  ]
}

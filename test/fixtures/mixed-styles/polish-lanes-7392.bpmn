<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C1">
    <bpmn:participant id="Org" name="Approval" processRef="P1"/>
  </bpmn:collaboration>
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:laneSet id="LS1">
      <bpmn:lane id="L1" name="Clerk"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_Fz1Archive</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Fz5Check</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L2" name="Boss"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_Fz2Notify</bpmn:flowNodeRef><bpmn:flowNodeRef>J</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T1" name="Review (small)"><bpmn:outgoing>f4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="J"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>fJToFz2Notify</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="E"><bpmn:incoming>f6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="Activity_Fz1Archive"/>
    <bpmn:userTask id="Activity_Fz1Archive" name="Fz1 archive">
      <bpmn:incoming>f1</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f4" sourceRef="T1" targetRef="J"/>
    <bpmn:sequenceFlow id="f6" sourceRef="J" targetRef="E"/>
    <bpmn:serviceTask id="Activity_Fz2Notify" name="Fz2 notify">
      <bpmn:incoming>fGatewayToFz2Notify</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fJToFz2Notify" sourceRef="J" targetRef="T2"/>
    <bpmn:userTask id="T2" name="Review (large)"><bpmn:incoming>fJToFz2Notify</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:userTask>
    <bpmn:sequenceFlow id="f5" sourceRef="T2" targetRef="Gateway_Fz5Check"/>
    <bpmn:exclusiveGateway id="Gateway_Fz5Check" name="Fz5 check">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>fFz5CheckToGateway</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="fFz5CheckToGateway" sourceRef="Gateway_Fz5Check" targetRef="G1"/>
    <bpmn:exclusiveGateway id="G1"><bpmn:incoming>fFz5CheckToGateway</bpmn:incoming><bpmn:outgoing>fGatewayToFz2Notify</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="fGatewayToFz2Notify" sourceRef="G1" targetRef="Activity_Fz2Notify"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="C1">
      <bpmndi:BPMNShape id="Org_di" bpmnElement="Org" isHorizontal="true"><dc:Bounds x="100" y="80" width="995" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="true"><dc:Bounds x="130" y="80" width="965" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_di" bpmnElement="L2" isHorizontal="true"><dc:Bounds x="130" y="250" width="965" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="172" y="147" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="410" y="140" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="520" y="125" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="520" y="295" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="J_di" bpmnElement="J" isMarkerVisible="true"><dc:Bounds x="715" y="310" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="827" y="147" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="208" y="165"/><di:waypoint x="268" y="165"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="620" y="165"/><di:waypoint x="650" y="165"/><di:waypoint x="650" y="335"/><di:waypoint x="715" y="335"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="570" y="295"/><di:waypoint x="570" y="250"/><di:waypoint x="705" y="250"/><di:waypoint x="705" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="765" y="335"/><di:waypoint x="795" y="335"/><di:waypoint x="795" y="165"/><di:waypoint x="827" y="165"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Activity_Fz1Archive_di" bpmnElement="Activity_Fz1Archive">
        <dc:Bounds x="268" y="125" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Fz2Notify_di" bpmnElement="Activity_Fz2Notify">
        <dc:Bounds x="825" y="275" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="fJToFz2Notify_di" bpmnElement="fJToFz2Notify">
        <di:waypoint x="740" y="360"/>
        <di:waypoint x="740" y="390"/>
        <di:waypoint x="570" y="390"/>
        <di:waypoint x="570" y="375"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fGatewayToFz2Notify_di" bpmnElement="fGatewayToFz2Notify">
        <di:waypoint x="435" y="190"/>
        <di:waypoint x="435" y="405"/>
        <di:waypoint x="875" y="405"/>
        <di:waypoint x="875" y="355"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Gateway_Fz5Check_di" bpmnElement="Gateway_Fz5Check" isMarkerVisible="true">
        <dc:Bounds x="680" y="140" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="711" y="120" width="75" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="fFz5CheckToGateway_di" bpmnElement="fFz5CheckToGateway">
        <di:waypoint x="705" y="140"/>
        <di:waypoint x="705" y="95"/>
        <di:waypoint x="395" y="95"/>
        <di:waypoint x="395" y="165"/>
        <di:waypoint x="410" y="165"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

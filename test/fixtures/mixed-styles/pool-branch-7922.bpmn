<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic hand drawing: a pool with one lane; the gateway G right of the sub-process SUB branches to a row
     inside SUB's rows (T_UP) and to a row below them (T_LOW). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C1"><bpmn:participant id="Pool" name="Org" processRef="P1"/></bpmn:collaboration>
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:laneSet id="LS1">
      <bpmn:lane id="L1" name="Team">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>SUB</bpmn:flowNodeRef><bpmn:flowNodeRef>G</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UP</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>T_LOW</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fz2Archive</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S">
      <bpmn:outgoing>F_SToFz2Archive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Fz2Archive" name="Fz2 archive">
      <bpmn:incoming>F_SToFz2Archive</bpmn:incoming>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="F_SToFz2Archive" sourceRef="S" targetRef="Gateway_Fz2Archive"/>
    <bpmn:task id="T_UP" name="Parcel"><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="T_LOW" name="Freight"><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E2"><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F5" sourceRef="T_UP" targetRef="G"/>
    <bpmn:exclusiveGateway id="G" name="Carrier?"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F_CarrierToSUB</bpmn:outgoing><bpmn:outgoing>F_CarrierToEnd_2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="SUB" name="Pack"><bpmn:incoming>F_CarrierToSUB</bpmn:incoming>
      <bpmn:startEvent id="SS"><bpmn:outgoing>G1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="ST" name="Pack goods"><bpmn:incoming>G1</bpmn:incoming><bpmn:outgoing>G2</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="SE"><bpmn:incoming>G2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="G1" sourceRef="SS" targetRef="ST"/>
      <bpmn:sequenceFlow id="G2" sourceRef="ST" targetRef="SE"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="F_CarrierToSUB" sourceRef="G" targetRef="SUB"/>
    <bpmn:endEvent id="E1"><bpmn:incoming>F_CarrierToEnd_2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CarrierToEnd_2" sourceRef="G" targetRef="E1"/>
    <bpmn:sequenceFlow id="F6" sourceRef="T_LOW" targetRef="E2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="C1">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true"><dc:Bounds x="100" y="60" width="1156" height="433"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="true"><dc:Bounds x="130" y="60" width="1126" height="433"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="170" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SUB_di" bpmnElement="SUB" isExpanded="true"><dc:Bounds x="336" y="100" width="380" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SS_di" bpmnElement="SS"><dc:Bounds x="366" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_di" bpmnElement="ST"><dc:Bounds x="446" y="140" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SE_di" bpmnElement="SE"><dc:Bounds x="606" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_di" bpmnElement="G" isMarkerVisible="true"><dc:Bounds x="776" y="155" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="807" y="135" width="68" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_UP_di" bpmnElement="T_UP"><dc:Bounds x="886" y="140" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="886" y="442" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_LOW_di" bpmnElement="T_LOW"><dc:Bounds x="886" y="320" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="1046" y="342" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="986" y="180"/><di:waypoint x="1046" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="986" y="360"/><di:waypoint x="1046" y="360"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G1_di" bpmnElement="G1"><di:waypoint x="402" y="180"/><di:waypoint x="446" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G2_di" bpmnElement="G2"><di:waypoint x="546" y="180"/><di:waypoint x="606" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Gateway_Fz2Archive_di" bpmnElement="Gateway_Fz2Archive">
        <dc:Bounds x="266" y="155" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="247" y="135" width="89" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_SToFz2Archive_di" bpmnElement="F_SToFz2Archive">
        <di:waypoint x="206" y="180"/>
        <di:waypoint x="266" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_CarrierToSUB_di" bpmnElement="F_CarrierToSUB">
        <di:waypoint x="801" y="155"/>
        <di:waypoint x="801" y="85"/>
        <di:waypoint x="526" y="85"/>
        <di:waypoint x="526" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_CarrierToEnd_2_di" bpmnElement="F_CarrierToEnd_2">
        <di:waypoint x="801" y="205"/>
        <di:waypoint x="801" y="460"/>
        <di:waypoint x="886" y="460"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

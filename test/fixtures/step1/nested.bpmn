<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic hand drawing: sub-process IN nested in OUT; RIGHT sits right of IN on its row, AFTER right of OUT
     below IN's rows, LOW below IN inside OUT, BELOW below OUT outside IN's column. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P1" isExecutable="true">
    <bpmn:startEvent id="S"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="OUT" name="Outer"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:startEvent id="OS"><bpmn:outgoing>G1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:subProcess id="IN" name="Inner"><bpmn:incoming>G1</bpmn:incoming><bpmn:outgoing>G2</bpmn:outgoing>
        <bpmn:startEvent id="IS"><bpmn:outgoing>H1</bpmn:outgoing></bpmn:startEvent>
        <bpmn:task id="I1" name="Inner task"><bpmn:incoming>H1</bpmn:incoming><bpmn:outgoing>H2</bpmn:outgoing></bpmn:task>
        <bpmn:endEvent id="IE"><bpmn:incoming>H2</bpmn:incoming></bpmn:endEvent>
        <bpmn:sequenceFlow id="H1" sourceRef="IS" targetRef="I1"/>
        <bpmn:sequenceFlow id="H2" sourceRef="I1" targetRef="IE"/>
      </bpmn:subProcess>
      <bpmn:task id="RIGHT" name="Right"><bpmn:incoming>G2</bpmn:incoming><bpmn:outgoing>G3</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="OE"><bpmn:incoming>G3</bpmn:incoming></bpmn:endEvent>
      <bpmn:task id="LOW" name="Low"/>
      <bpmn:sequenceFlow id="G1" sourceRef="OS" targetRef="IN"/>
      <bpmn:sequenceFlow id="G2" sourceRef="IN" targetRef="RIGHT"/>
      <bpmn:sequenceFlow id="G3" sourceRef="RIGHT" targetRef="OE"/>
    </bpmn:subProcess>
    <bpmn:task id="AFTER" name="After"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="E"><bpmn:incoming>F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="BELOW" name="Below"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="OUT"/>
    <bpmn:sequenceFlow id="F2" sourceRef="OUT" targetRef="AFTER"/>
    <bpmn:sequenceFlow id="F3" sourceRef="AFTER" targetRef="E"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1">
    <bpmndi:BPMNPlane id="PL1" bpmnElement="P1">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="100" y="272" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OUT_di" bpmnElement="OUT" isExpanded="true"><dc:Bounds x="180" y="80" width="640" height="420"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OS_di" bpmnElement="OS"><dc:Bounds x="210" y="172" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IN_di" bpmnElement="IN" isExpanded="true"><dc:Bounds x="280" y="110" width="300" height="160"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IS_di" bpmnElement="IS"><dc:Bounds x="300" y="172" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I1_di" bpmnElement="I1"><dc:Bounds x="370" y="150" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IE_di" bpmnElement="IE"><dc:Bounds x="510" y="172" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RIGHT_di" bpmnElement="RIGHT"><dc:Bounds x="640" y="150" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OE_di" bpmnElement="OE"><dc:Bounds x="770" y="172" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LOW_di" bpmnElement="LOW"><dc:Bounds x="400" y="330" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AFTER_di" bpmnElement="AFTER"><dc:Bounds x="880" y="300" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="1040" y="322" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BELOW_di" bpmnElement="BELOW"><dc:Bounds x="650" y="560" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="290"/><di:waypoint x="180" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="820" y="340"/><di:waypoint x="880" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="980" y="340"/><di:waypoint x="1040" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G1_di" bpmnElement="G1"><di:waypoint x="246" y="190"/><di:waypoint x="280" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G2_di" bpmnElement="G2"><di:waypoint x="580" y="190"/><di:waypoint x="640" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="G3_di" bpmnElement="G3"><di:waypoint x="740" y="190"/><di:waypoint x="770" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="H1_di" bpmnElement="H1"><di:waypoint x="336" y="190"/><di:waypoint x="370" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="H2_di" bpmnElement="H2"><di:waypoint x="470" y="190"/><di:waypoint x="510" y="190"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

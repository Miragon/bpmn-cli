<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ExpenseClaim" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0">
  <bpmn:process id="Process_ExpenseClaim" name="Expense claim" isExecutable="false">
    <bpmn:startEvent id="Event_ClaimSubmitted" name="Claim submitted">
      <bpmn:outgoing>Flow_ClaimSubmittedToCheckClaim</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_CheckClaim" name="Check claim">
      <bpmn:incoming>Flow_ClaimSubmittedToCheckClaim</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckClaimToApproveClaim</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_ApproveClaim" name="Approve claim">
      <bpmn:incoming>Flow_CheckClaimToApproveClaim</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveClaimToPayClaim</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_PayClaim" name="Pay claim">
      <bpmn:incoming>Flow_ApproveClaimToPayClaim</bpmn:incoming>
      <bpmn:outgoing>Flow_PayClaimToClaimPaid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_ClaimPaid" name="Claim paid">
      <bpmn:incoming>Flow_PayClaimToClaimPaid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_ClaimInvalid" name="Claim invalid" attachedToRef="Activity_CheckClaim">
      <bpmn:outgoing>Flow_ClaimInvalidToClaimRejected</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ClaimInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_ClaimRejected" name="Claim rejected">
      <bpmn:incoming>Flow_ClaimInvalidToClaimRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ClaimSubmittedToCheckClaim" sourceRef="Event_ClaimSubmitted" targetRef="Activity_CheckClaim" />
    <bpmn:sequenceFlow id="Flow_CheckClaimToApproveClaim" sourceRef="Activity_CheckClaim" targetRef="Activity_ApproveClaim" />
    <bpmn:sequenceFlow id="Flow_ApproveClaimToPayClaim" sourceRef="Activity_ApproveClaim" targetRef="Activity_PayClaim" />
    <bpmn:sequenceFlow id="Flow_PayClaimToClaimPaid" sourceRef="Activity_PayClaim" targetRef="Event_ClaimPaid" />
    <bpmn:sequenceFlow id="Flow_ClaimInvalidToClaimRejected" sourceRef="Event_ClaimInvalid" targetRef="Event_ClaimRejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ExpenseClaim">
    <bpmndi:BPMNPlane id="BPMNPlane_ExpenseClaim" bpmnElement="Process_ExpenseClaim">
      <bpmndi:BPMNShape id="Event_ClaimSubmitted_di" bpmnElement="Event_ClaimSubmitted">
        <dc:Bounds x="102" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="81" y="125" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CheckClaim_di" bpmnElement="Activity_CheckClaim">
        <dc:Bounds x="190" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ApproveClaim_di" bpmnElement="Activity_ApproveClaim">
        <dc:Bounds x="350" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_PayClaim_di" bpmnElement="Activity_PayClaim">
        <dc:Bounds x="510" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ClaimPaid_di" bpmnElement="Event_ClaimPaid">
        <dc:Bounds x="672" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="664" y="125" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ClaimRejected_di" bpmnElement="Event_ClaimRejected">
        <dc:Bounds x="672" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="655" y="225" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ClaimInvalid_di" bpmnElement="Event_ClaimInvalid">
        <dc:Bounds x="222" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="168" y="158" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ClaimSubmittedToCheckClaim_di" bpmnElement="Flow_ClaimSubmittedToCheckClaim">
        <di:waypoint x="138" y="100" />
        <di:waypoint x="190" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CheckClaimToApproveClaim_di" bpmnElement="Flow_CheckClaimToApproveClaim">
        <di:waypoint x="290" y="100" />
        <di:waypoint x="350" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApproveClaimToPayClaim_di" bpmnElement="Flow_ApproveClaimToPayClaim">
        <di:waypoint x="450" y="100" />
        <di:waypoint x="510" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PayClaimToClaimPaid_di" bpmnElement="Flow_PayClaimToClaimPaid">
        <di:waypoint x="610" y="100" />
        <di:waypoint x="672" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ClaimInvalidToClaimRejected_di" bpmnElement="Flow_ClaimInvalidToClaimRejected">
        <di:waypoint x="240" y="158" />
        <di:waypoint x="240" y="200" />
        <di:waypoint x="672" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
